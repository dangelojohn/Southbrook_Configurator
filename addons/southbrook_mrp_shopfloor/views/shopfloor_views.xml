<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_mrp_floating_times_list" model="ir.ui.view">
            <field name="name">mrp.floating.times.list</field>
            <field name="model">mrp.floating.times</field>
            <field name="arch" type="xml">
                <list string="Floating Times" editable="bottom">
                    <field name="warehouse_id"/>
                    <field name="mrp_release_time"/>
                    <field name="mrp_ftbp_time"/>
                    <field name="mrp_ftap_time"/>
                </list>
            </field>
        </record>

        <record id="action_mrp_floating_times" model="ir.actions.act_window">
            <field name="name">Floating Times</field>
            <field name="res_model">mrp.floating.times</field>
            <field name="view_mode">list</field>
        </record>

        <record id="view_mrp_workcenter_load_list" model="ir.ui.view">
            <field name="name">mrp.workcenter.load.list</field>
            <field name="model">mrp.workcenter.load</field>
            <field name="arch" type="xml">
                <list string="Workcenter Load" create="false">
                    <field name="date_planned"/>
                    <field name="week_nro"/>
                    <field name="workcenter_id"/>
                    <field name="production_id"/>
                    <field name="workorder_id"/>
                    <field name="wo_capacity_requirements" sum="Hours"/>
                </list>
            </field>
        </record>

        <record id="action_mrp_workcenter_load" model="ir.actions.act_window">
            <field name="name">Workcenter Load</field>
            <field name="res_model">mrp.workcenter.load</field>
            <field name="view_mode">list</field>
        </record>

        <menuitem id="menu_sbk_shopfloor_load" name="Workcenter Load"
                  parent="mrp.menu_mrp_reporting"
                  action="action_mrp_workcenter_load" sequence="70"/>
        <menuitem id="menu_sbk_shopfloor_floating" name="Floating Times"
                  parent="mrp.menu_mrp_configuration"
                  action="action_mrp_floating_times" sequence="70"/>
    </data>
</odoo>
