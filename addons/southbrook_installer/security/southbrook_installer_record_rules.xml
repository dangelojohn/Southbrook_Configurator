        </record>
        <record id="rule_installer_stage_log_all" model="ir.rule">
            <field name="name">Stage Log: broad roles see all</field>
            <field name="model_id" ref="model_southbrook_installer_stage_log"/>
            <field name="groups" eval="[(4, ref('group_sami_dispatcher')), (4, ref('group_sami_warehouse')), (4, ref('group_sami_finance')), (4, ref('group_sami_operations_mgr'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

