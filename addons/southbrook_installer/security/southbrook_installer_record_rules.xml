<?xml version="1.0" encoding="utf-8"?>
<!--
  SPDX-License-Identifier: LGPL-3.0-only

  Per-installer job visibility. The module's group comments document that a
  helper "can view ASSIGNED jobs" — but with no ir.rule, every role saw every
  job company-wide (customer addresses, GPS, phase photos, builder signatures).
  These rules enforce the documented model:

    * Restrictive rule on group_sami_installer_helper (which lead/dispatcher/
      ops inherit via implied_ids): a crew member sees only jobs where they are
      the lead installer or in the assigned crew.
    * Permissive rule on dispatcher/warehouse/finance/operations_mgr: full
      company-wide visibility (their documented roles).

  Because Odoo OR-combines the record rules from the groups a user belongs to,
  a dispatcher (who is also a helper via implied_ids) gets restrictive OR
  permissive = all; a pure helper gets restrictive only.

  BEHAVIOUR CHANGE: after this loads, crew see only assigned jobs. Requires
  lead_installer_id (already required) and assigned_crew_ids to be populated —
  a crew member not on a job's crew will not see it. Broad-visibility roles are
  unaffected.
-->
<odoo>
    <data noupdate="1">

        <!-- ============ JOB ============ -->
        <record id="rule_installer_job_crew_assigned" model="ir.rule">
            <field name="name">Installer Job: crew see assigned only</field>
            <field name="model_id" ref="model_southbrook_installer_job"/>
            <field name="groups" eval="[(4, ref('group_sami_installer_helper'))]"/>
            <field name="domain_force">['|', ('lead_installer_id.user_id', '=', user.id), ('assigned_crew_ids.user_id', '=', user.id)]</field>
        </record>
        <record id="rule_installer_job_all" model="ir.rule">
            <field name="name">Installer Job: dispatch/warehouse/finance/ops see all</field>
            <field name="model_id" ref="model_southbrook_installer_job"/>
            <field name="groups" eval="[(4, ref('group_sami_dispatcher')), (4, ref('group_sami_warehouse')), (4, ref('group_sami_finance')), (4, ref('group_sami_operations_mgr'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- ============ STAGE LOG ============ -->
