<odoo>

    <record id="view_installer_closeout_list" model="ir.ui.view">
        <field name="name">southbrook.installer.closeout.list</field>
        <field name="model">southbrook.installer.closeout</field>
        <field name="arch" type="xml">
            <list string="Close-Outs"
                  decoration-info="state == 'in_progress'"
                  decoration-success="state == 'complete'">
                <field name="name"/>
                <field name="job_id"/>
                <field name="state" widget="badge"/>
                <field name="builder_approves_cleanup" optional="show"/>
                <field name="all_tools_returned" optional="show"/>
                <field name="all_flags_resolved_or_eta" optional="show"/>
                <field name="installer_confirmed" optional="show"/>
                <field name="return_picking_id" optional="show"/>
                <field name="installer_sign_time" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_installer_closeout_form" model="ir.ui.view">
        <field name="name">southbrook.installer.closeout.form</field>
        <field name="model">southbrook.installer.closeout</field>
        <field name="arch" type="xml">
            <form string="Close-Out Checklist">
                <header>
                    <button name="action_open" type="object"
                            string="▶ Open Checklist" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_submit_closeout" type="object"
                            string="✅ Submit Close-Out" class="oe_highlight"
                            invisible="state != 'in_progress'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_progress,complete"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_return_picking"
                                type="object" class="oe_stat_button"
                                icon="fa-truck"
                                invisible="not return_picking_id">
                            <field name="return_picking_id"
                                   widget="statinfo"
                                   string="Return Picking"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Complete"
                            bg_color="bg-success"
                            invisible="state != 'complete'"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <field name="job_id" readonly="state != 'draft'"/>
                    </group>
                    <notebook>
                        <page string="① Site Cleanup" name="cleanup">
                            <group>
                                <group string="Cleanup Tasks">
                                    <field name="packaging_removed"/>
                                    <field name="offcuts_collected"/>
                                    <field name="cabinets_wiped"/>
                                    <field name="sawdust_cleared"/>
                                    <field name="adhesive_removed"/>
                                    <field name="floor_protection_removed"/>
                                    <field name="tape_removed"/>
                                    <field name="builder_approves_cleanup"/>
                                </group>
                                <group string="Waste Disposal">
                                    <field name="waste_disposal_method"/>
                                    <field name="waste_disposal_provider"
                                           invisible="waste_disposal_method != 'third_party'"
                                           required="waste_disposal_method == 'third_party'"/>
                                </group>
                            </group>
                        </page>
                        <page string="② Leftover Materials" name="materials">
                            <field name="material_return_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="lot_id"/>
                                    <field name="qty_returning"/>
                                    <field name="uom_id"/>
                                    <field name="reason"/>
                                    <field name="condition"/>
                                    <field name="return_location_id"
                                           optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="③ Tools" name="tools">
                            <group>
                                <field name="all_tools_returned" readonly="1"/>
                                <field name="tool_return_pct"
                                       widget="progressbar" readonly="1"/>
                            </group>
                            <field name="tool_return_ids">
                                <list editable="bottom"
                                      decoration-success="confirmed_loaded"
                                      decoration-danger="return_condition == 'lost'"
                                      decoration-warning="return_condition in ('maintenance','damaged')">
                                    <field name="tool_loan_id"
                                           options="{'no_create': True}"/>
                                    <field name="equipment_id" readonly="1"/>
                                    <field name="tool_type" readonly="1"/>
                                    <field name="confirmed_loaded"
                                           widget="boolean_toggle"/>
                                    <field name="return_condition"/>
                                    <field name="notes" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="④ Open Flags" name="flags">
                            <group>
                                <field name="all_flags_resolved_or_eta"
                                       readonly="1"/>
                            </group>
                            <field name="open_flag_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="product_id"/>
                                    <field name="issue_type"/>
                                    <field name="urgency" widget="badge"/>
                                    <field name="state" widget="badge"/>
                                    <field name="replacement_eta"
                                           decoration-danger="not replacement_eta"/>
                                </list>
                            </field>
                        </page>
                        <page string="⑤ Sign-Off" name="signoff">
                            <group>
                                <group>
                                    <field name="installer_confirmed"/>
                                    <field name="installer_sign_id"
                                           readonly="1"/>
                                    <field name="installer_sign_time"
                                           readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_installer_closeout" model="ir.actions.act_window">
        <field name="name">Close-Outs</field>
        <field name="res_model">southbrook.installer.closeout</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
