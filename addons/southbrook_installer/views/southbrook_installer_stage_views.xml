<odoo>

    <record id="view_installer_stage_list" model="ir.ui.view">
        <field name="name">southbrook.installer.stage.list</field>
        <field name="model">southbrook.installer.stage</field>
        <field name="arch" type="xml">
            <list string="Installer Workflow Stages">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="gate_require_delivery_confirmed" optional="show"/>
                <field name="gate_require_all_phases_done" optional="show"/>
                <field name="gate_require_sign_off" optional="show"/>
                <field name="gate_require_closeout_done" optional="show"/>
                <field name="auto_create_invoice" optional="hide"/>
                <field name="is_terminal" optional="show"/>
                <field name="fold" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_installer_stage_form" model="ir.ui.view">
        <field name="name">southbrook.installer.stage.form</field>
        <field name="model">southbrook.installer.stage</field>
        <field name="arch" type="xml">
            <form string="Installer Workflow Stage">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Stage Name"/></h1>
                        <h3><field name="code" placeholder="STAGE_CODE"/></h3>
                    </div>
                    <group>
                        <group string="Ordering">
                            <field name="sequence"/>
                            <field name="fold"/>
                            <field name="color" widget="color_picker"/>
                            <field name="is_terminal"/>
                        </group>
                        <group string="Exit Gates (must be true to leave this stage)">
                            <field name="gate_require_delivery_confirmed"/>
                            <field name="gate_require_all_phases_done"/>
                            <field name="gate_require_sign_off"/>
                            <field name="gate_require_closeout_done"/>
                        </group>
                    </group>
                    <group string="Side Effects on Entry">
                        <field name="auto_create_invoice"/>
                    </group>
                    <separator string="Description"/>
                    <field name="description" nolabel="1" placeholder="What happens in this stage?"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_installer_stage" model="ir.actions.act_window">
        <field name="name">Workflow Stages</field>
        <field name="res_model">southbrook.installer.stage</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
