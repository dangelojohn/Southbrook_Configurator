<?xml version="1.0" encoding="UTF-8"?>
<!--
    Phase 3.B — Room Layout tab templates (2026-06-27).
    Phase 3.C.2a — tap interactivity layer (2026-06-27).

    Components mounted into web.assets_frontend via the addon manifest.
    OWL tokenizer rules followed throughout:

      * t-if / t-att-* expressions use ||, &&, ! (never Python or/and/not)
      * `<` encoded as &lt; inside attribute expressions where needed
      * SVG sub-trees are plain XML — OWL handles the namespace

    Three click affordances in 3.C.2a:
      - cabinet polygon click → onCabinetClick(lineId)
      - gap rect click        → onGapClick(wallId, gapMm, positionMm)
      - sidebar Assign... btn → onAssignFromSidebar(lineId)

    Drag (3.C.2b) and the elevation toggle (3.C.2c) remain deferred.
-->
<templates xml:space="preserve">

    <!-- ============================================================
         RoomLayoutTab — parent shell.

         Layout:
             ┌────────────────────────────────┬──────────┐
             │                                │ Walls    │
             │     <FloorPlanSVG/>            │ table    │
             │                                ├──────────┤
             │                                │ Unplaced │
             │                                │ list     │
             └────────────────────────────────┴──────────┘

         Empty states:
             - no room      → "Set up a room…" pointer
             - room/no walls → "Add walls…" pointer
             - room+walls/no lines → render the room outline only
         ============================================================ -->
    <t t-name="southbrook_estimating_website.RoomLayoutTab">
        <div class="sb-room-plan-tab">

            <!-- Empty state #1: no room configured. -->
            <div t-if="!_hasRoom" class="sb-room-plan-empty">
                <h2>No room configured yet</h2>
                <p>
                    Go to the <strong>Room Setup</strong> tab to add a
                    room. Once it has at least one wall, the floor
                    plan will render here with every cabinet you
                    place.
                </p>
            </div>

            <!-- Empty state #2: room exists, no walls yet. -->
            <div t-elif="!_hasWalls" class="sb-room-plan-empty">
                <h2>Room has no walls yet</h2>
                <p>
                    Add walls via the <strong>Room Setup</strong>
                    tab. The floor plan needs at least one wall to
                    render.
                </p>
            </div>

            <!-- Populated: render the SVG + metrics + sidebar. -->
            <div t-else=""
                 class="sb-room-plan-layout">

                <div class="sb-room-plan-canvas">
                    <FloorPlanSVG room="props.room"
                                  lines="props.lines"
                                  unitPreference="props.unitPreference || 'mm'"
                                  onCabinetClick="props.onCabinetClick"
                                  onGapClick="props.onGapClick"
                                  onCabinetDragEnd="props.onCabinetDragEnd"/>
                </div>

                <aside class="sb-room-plan-sidebar">

                    <!-- Per-wall metrics -->
                    <section class="sb-room-plan-walls">
                        <h3 class="sb-room-plan-section-title">
                            Walls
                        </h3>
                        <table class="sb-room-plan-walls-table">
                            <thead>
                                <tr>
                                    <th>Wall</th>
                                    <th class="sb-room-plan-num">Total</th>
                                    <th class="sb-room-plan-num">Used</th>
                                    <th class="sb-room-plan-num">Left</th>
                                    <th class="sb-room-plan-num">Conflicts</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="_wallMetrics"
                                    t-as="m"
                                    t-key="m.id"
                                    class="sb-room-plan-wall-row"
                                    t-att-class="{
                                        'sb-room-plan-wall-row--conflict': m.has_conflicts,
                                    }">
                                    <td t-esc="m.name"/>
                                    <td class="sb-room-plan-num mono">
                                        <t t-esc="_humanLen(m.length_mm)"/>
                                    </td>
                                    <td class="sb-room-plan-num mono">
                                        <t t-esc="_humanLen(m.used_mm)"/>
                                    </td>
                                    <td class="sb-room-plan-num mono"
                                        t-att-class="{
                                            'sb-room-plan-over': m.remaining_mm &lt; 0,
                                        }">
                                        <t t-esc="_humanLen(m.remaining_mm)"/>
                                    </td>
                                    <td class="sb-room-plan-num mono">
                                        <t t-esc="m.conflict_count"/>
                                    </td>
                                </tr>
                                <tr class="sb-room-plan-wall-total">
                                    <td><strong>Total</strong></td>
                                    <td class="sb-room-plan-num mono">
                                        <t t-esc="_humanLen(_wallTotals.length_mm)"/>
                                    </td>
                                    <td class="sb-room-plan-num mono">
                                        <t t-esc="_humanLen(_wallTotals.used_mm)"/>
                                    </td>
                                    <td class="sb-room-plan-num mono">
                                        <t t-esc="_humanLen(_wallTotals.remaining_mm)"/>
                                    </td>
                                    <td class="sb-room-plan-num mono">—</td>
                                </tr>
                            </tbody>
                        </table>
                    </section>

                    <!-- Unplaced cabinets list -->
                    <section class="sb-room-plan-unplaced">
                        <h3 class="sb-room-plan-section-title">
                            Unplaced (<t t-esc="_unplacedCount"/>)
                        </h3>
                        <p t-if="_unplacedCount === 0"
                           class="sb-room-plan-unplaced-empty">
                            All cabinets placed.
                        </p>
                        <ul t-else=""
                            class="sb-room-plan-unplaced-list">
                            <li t-foreach="_unplacedLines"
                                t-as="line"
                                t-key="line.id"
                                class="sb-room-plan-unplaced-item">
                                <span class="sb-room-plan-unplaced-name"
                                      t-esc="line.name"/>
                                <span class="sb-room-plan-unplaced-width mono">
                                    <t t-esc="_humanLen(line.sb_width_mm || 0)"/>
                                </span>
                                <!-- Phase 3.C.2a — Assign... opens the
                                     AssignToWallModal at the parent
                                     OrderBuilder level. Button hidden
                                     when no callback was wired so the
                                     read-only mount (e.g. preview pane)
                                     stays clean. -->
                                <button t-if="props.onAssignFromSidebar"
                                        type="button"
                                        class="sb-room-plan-unplaced-assign"
                                        t-on-click="() => this._onAssignClick(line.id)"
                                        t-att-aria-label="'Assign ' + line.name + ' to a wall'">
                                    Assign…
                                </button>
                            </li>
                        </ul>
                        <p t-if="!_hasLines &amp;&amp; _hasWalls"
                           class="sb-room-plan-unplaced-empty">
                            No cabinets in this order yet.
                        </p>
                    </section>
                </aside>
            </div>
        </div>
    </t>

    <!-- ============================================================
         FloorPlanSVG — pure-render top-down inline SVG.

         Layers, painter's order (back → front):
           1. Background floor rect (subtle linen)
           2. Wall lines (thick walnut strokes)
           3. Constraints (type-coloured polygons + labels)
           4. Gap markers (dashed rect + mm label)
           5. Cabinet polygons (zone fill, conflict border)
           6. Cabinet labels (short SKU, centred)
           7. Wall name labels (text on the OUTSIDE of each wall)
         ============================================================ -->
    <t t-name="southbrook_estimating_website.FloorPlanSVG">
        <svg class="sb-room-plan-svg"
             t-ref="svgRoot"
             t-att-viewBox="_viewBox"
             xmlns="http://www.w3.org/2000/svg"
             role="img"
             aria-label="Room floor plan">

            <!-- Background floor rect — only when we have walls. -->
            <rect t-if="_bgRect"
                  class="sb-room-plan-floor"
                  t-att-x="_bgRect.x"
                  t-att-y="_bgRect.y"
                  t-att-width="_bgRect.w"
                  t-att-height="_bgRect.h"/>

            <!-- Wall lines. Conflict walls get the alert stroke. -->
            <g class="sb-room-plan-walls-g">
                <line t-foreach="_wallLines"
                      t-as="w"
                      t-key="w.key"
                      class="sb-room-plan-wall-line"
                      t-att-class="{
                          'sb-room-plan-wall-line--conflict': w.hasConflicts,
                      }"
                      t-att-x1="w.x1"
                      t-att-y1="w.y1"
                      t-att-x2="w.x2"
                      t-att-y2="w.y2"/>
            </g>

            <!-- Constraint polygons + labels. -->
            <g class="sb-room-plan-constraints-g">
                <t t-foreach="_constraintPolys"
                   t-as="c"
                   t-key="c.key">
                    <polygon class="sb-room-plan-constraint"
                             t-att-class="'sb-room-plan-constraint--' + c.type"
                             t-att-points="c.points"/>
                    <text class="sb-room-plan-constraint-label"
                          t-att-x="c.cx"
                          t-att-y="c.cy"
                          text-anchor="middle"
                          dominant-baseline="central">
                        <t t-esc="c.label"/>
                    </text>
                </t>
            </g>

            <!-- Gap markers — dashed rect, no fill. Phase 3.C.2a wires
                 the click handler so a tap opens the catalog modal with
                 a stashed pendingGapPlacement. Cursor flips to pointer
                 only when a click handler is wired (props.onGapClick on
                 the FloorPlanSVG, threaded down by RoomLayoutTab from
                 the OrderBuilder). -->
            <g class="sb-room-plan-gaps-g">
                <t t-foreach="_gapMarkers"
                   t-as="g"
                   t-key="g.key">
                    <polygon class="sb-room-plan-gap"
                             t-att-class="props.onGapClick ? 'sb-room-plan-gap sb-room-plan-gap--clickable' : 'sb-room-plan-gap'"
                             t-att-points="g.points"
                             t-on-click="() => this._onGapClick(g.wallId, g.gapMm, g.positionMm)"/>
                    <text t-if="g.showLabel"
                          class="sb-room-plan-gap-label"
                          t-att-x="g.cx"
                          t-att-y="g.cy"
                          text-anchor="middle"
                          dominant-baseline="central">
                        <t t-esc="g.label"/>
                    </text>
                </t>
            </g>

            <!-- Cabinet polygons + (conditional) labels. Phase 3.C.2a
                 wires the click handler so tapping a cabinet jumps to
                 the Order Lines tab + selects the row (parent owns the
                 state mutation via onCabinetClick).

                 Phase 3.C.2b adds drag-along-wall via pointer events.
                 During drag (after the 5px threshold trips) we render
                 TWO polygons per cabinet: a low-opacity ghost at the
                 ORIGINAL position + a semi-opaque preview at the
                 cursor's projected mm. The shifter <g> sibling exposes
                 ± 25mm buttons that are only visible on coarse-pointer
                 devices (CSS-gated). -->
            <g class="sb-room-plan-cabs-g">
                <t t-foreach="_cabinetPolys"
                   t-as="cab"
                   t-key="cab.key">

                    <!-- Original/static polygon. When this cabinet is
                         mid-drag (isDragging) we drop opacity via the
                         ghost class so the user sees where it came
                         from while the preview rides the cursor. -->
                    <polygon t-att-class="(cab.conflict
                                           ? (cab.zoneClass + ' sb-room-plan-cab--conflict')
                                           : cab.zoneClass)
                                          + (props.onCabinetDragEnd ? ' sb-room-plan-cab--clickable' : (props.onCabinetClick ? ' sb-room-plan-cab--clickable' : ''))
                                          + (cab.isDragging ? ' sb-room-plan-cab--drag-ghost' : '')"
                             t-att-points="cab.points"
                             t-on-pointerdown="(ev) => this._onCabinetPointerDown(cab.lineRef, ev)"
                             t-on-click="() => this._onCabinetClick(cab.lineId)"/>

                    <text t-if="cab.showLabel &amp;&amp; !cab.isDragging"
                          class="sb-room-plan-cab-label"
                          t-att-x="cab.cx"
                          t-att-y="cab.cy"
                          text-anchor="middle"
                          dominant-baseline="central">
                        <t t-esc="cab.label"/>
                    </text>

                    <!-- Phase 3.C.2b — drag preview. Semi-opaque polygon
                         + label that rides at dragState.currentMm.
                         pointer-events disabled so the cursor still
                         interacts with the original polygon under it. -->
                    <polygon t-if="cab.isDragging"
                             t-att-class="(cab.conflict
                                           ? (cab.zoneClass + ' sb-room-plan-cab--conflict')
                                           : cab.zoneClass)
                                          + ' sb-room-plan-cab--dragging'"
                             t-att-points="cab.dragPoints"/>
                    <text t-if="cab.isDragging &amp;&amp; cab.showLabel"
                          class="sb-room-plan-cab-label"
                          t-att-x="cab.dragCx"
                          t-att-y="cab.dragCy"
                          text-anchor="middle"
                          dominant-baseline="central">
                        <t t-esc="cab.label"/>
                    </text>

                    <!-- Phase 3.C.2b: touch shifter (plus/minus 25mm).
                         Visible only on coarse pointers (CSS @media).
                         Rendered as a sibling group so the :hover
                         sibling-combinator on the clickable cabinet
                         class picks it up on hover for desktop too. -->
                    <g t-if="props.onCabinetDragEnd &amp;&amp; !cab.isDragging"
                       class="sb-room-plan-shifter">
                        <rect class="sb-room-plan-shifter-btn"
                              t-att-x="cab.cx - 26"
                              t-att-y="cab.cy + 14"
                              width="22"
                              height="18"
                              rx="3"
                              t-on-click="() => this._onCabinetShift(cab.lineRef, -25)"/>
                        <text class="sb-room-plan-shifter-glyph"
                              t-att-x="cab.cx - 15"
                              t-att-y="cab.cy + 23"
                              text-anchor="middle"
                              dominant-baseline="central"
                              t-on-click="() => this._onCabinetShift(cab.lineRef, -25)">−</text>
                        <rect class="sb-room-plan-shifter-btn"
                              t-att-x="cab.cx + 4"
                              t-att-y="cab.cy + 14"
                              width="22"
                              height="18"
                              rx="3"
                              t-on-click="() => this._onCabinetShift(cab.lineRef, 25)"/>
                        <text class="sb-room-plan-shifter-glyph"
                              t-att-x="cab.cx + 15"
                              t-att-y="cab.cy + 23"
                              text-anchor="middle"
                              dominant-baseline="central"
                              t-on-click="() => this._onCabinetShift(cab.lineRef, 25)">+</text>
                    </g>
                </t>
            </g>

            <!-- Wall name labels — drawn LAST so they sit on top. -->
            <g class="sb-room-plan-wall-labels-g">
                <text t-foreach="_wallLabels"
                      t-as="lbl"
                      t-key="lbl.key"
                      class="sb-room-plan-wall-label"
                      t-att-x="lbl.x"
                      t-att-y="lbl.y"
                      text-anchor="middle"
                      dominant-baseline="central">
                    <t t-esc="lbl.name"/>
                </text>
            </g>

        </svg>
    </t>

    <!-- ============================================================
         AssignToWallModal — Phase 3.C.2a.

         Fullscreen overlay launched when the user clicks "Assign..."
         next to an unplaced cabinet in the Room Layout sidebar. Wall
         dropdown (length + remaining) + position input + Cancel /
         Assign. Parent OrderBuilder owns the RPC; this template just
         drives the form.

         Backdrop click does NOT close (a misclick mid-pick would lose
         the form state). Use the × button or Cancel.
         ============================================================ -->
    <t t-name="southbrook_estimating_website.AssignToWallModal">
        <div class="sb-room-plan-modal-backdrop">
            <div class="sb-room-plan-modal"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="sb-room-plan-modal-title">
                <header class="sb-room-plan-modal-head">
                    <h2 id="sb-room-plan-modal-title"
                        class="sb-room-plan-modal-title">
                        Assign cabinet to a wall
                    </h2>
                    <button type="button"
                            class="sb-room-plan-modal-close"
                            aria-label="Cancel"
                            t-on-click="_onCancelClick"
                            t-att-disabled="state.submitting">×</button>
                </header>

                <div class="sb-room-plan-modal-body">
                    <p class="sb-room-plan-modal-cabinet">
                        <strong t-esc="props.line.name || 'Cabinet'"/>
                        <span t-if="_cabinetWidthMm"
                              class="sb-room-plan-modal-width mono">
                            <t t-esc="_humanLen(_cabinetWidthMm)"/> wide
                        </span>
                    </p>

                    <label class="sb-room-plan-modal-label"
                           for="sb-room-plan-modal-wall">
                        Wall
                    </label>
                    <select id="sb-room-plan-modal-wall"
                            class="sb-room-plan-modal-select"
                            t-att-value="state.wallId"
                            t-on-change="_onWallChange"
                            t-att-disabled="state.submitting">
                        <option t-foreach="_wallOptions"
                                t-as="opt"
                                t-key="opt.id"
                                t-att-value="opt.id"
                                t-att-selected="String(opt.id) === String(state.wallId) ? 'selected' : null">
                            <t t-esc="opt.name"/>
                            ·
                            <t t-esc="_humanLen(opt.length_mm)"/>
                            ·
                            <t t-esc="_humanLen(opt.remaining_mm)"/> left
                        </option>
                    </select>

                    <label class="sb-room-plan-modal-label"
                           for="sb-room-plan-modal-pos">
                        Position from left (mm)
                        <small t-if="(props.unitPreference || 'mm') === 'imperial'"
                               class="sb-room-plan-modal-hint">
                            — input stays in mm; toggle is display-only
                        </small>
                    </label>
                    <input id="sb-room-plan-modal-pos"
                           type="number"
                           min="0"
                           step="10"
                           class="sb-room-plan-modal-input mono"
                           t-att-value="state.positionMm"
                           t-on-input="_onPositionInput"
                           t-att-disabled="state.submitting"/>

                    <p t-if="state.error"
                       class="sb-room-plan-modal-error"
                       t-esc="state.error"/>
                </div>

                <footer class="sb-room-plan-modal-foot">
                    <button type="button"
                            class="sb-room-plan-modal-btn sb-room-plan-modal-btn--secondary"
                            t-on-click="_onCancelClick"
                            t-att-disabled="state.submitting">
                        Cancel
                    </button>
                    <button type="button"
                            class="sb-room-plan-modal-btn sb-room-plan-modal-btn--primary"
                            t-on-click="_onAssignClick"
                            t-att-disabled="state.submitting">
                        <t t-if="state.submitting">Assigning…</t>
                        <t t-else="">Assign</t>
                    </button>
                </footer>
            </div>
        </div>
    </t>

</templates>
