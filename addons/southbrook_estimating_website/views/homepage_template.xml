<?xml version="1.0" encoding="utf-8"?>
<!--
  G1 + G2 (customer-flow JTBD gap analysis 2026-06-01) — public
  Southbrook homepage.

  Pre-fix: the website root rendered Odoo's default homepage — no
  Southbrook branding, no value prop, no CTA, no path to the
  configurator. A visitor like Sarah Johnson arriving at the site had
  no idea what Southbrook does or how to begin.

  Approach: inherit the stock `website.homepage` template (which the
  Odoo website controller renders for /) and REPLACE its body with the
  Southbrook hero + features + CTA strip. No new route, no controller
  conflict — Odoo's default `/` handler renders this every time.

  The 'Design Your Kitchen' CTA links to /my/southbrook/order-builder/new
  unconditionally. The /my/... route requires auth, so Odoo auto-
  redirects anonymous visitors to /web/login?redirect=/my/... then
  back to the new-order route after sign-in. Single href, both
  audiences.

  All styling uses the shared design tokens (sb-walnut, sb-linen, etc.
  on :root) per docs/CUSTOMER_TO_MANUFACTURING_FLOW.md §5.
-->
<odoo>

  <template
      id="southbrook_homepage"
      name="Southbrook Homepage"
      inherit_id="website.homepage">

    <!-- Replace the entire body of website.homepage. The xpath targets
         the outermost div of the stock template (Odoo 19 ships a
         <div id="wrap"> in website.homepage, see addons/website/views/
         website_templates.xml). We replace its children wholesale. -->
    <xpath expr="//div[@id='wrap']" position="replace">
      <div id="wrap" class="oe_structure oe_empty">
        <main class="o_sb_home">

          <!-- HERO -->
          <section class="o_sb_hero">
            <div class="container">
              <div class="row">
                <div class="col-lg-7 o_sb_hero_text">
                  <h1 class="o_sb_hero_title">
                    Custom kitchen cabinets,<br/>
                    <span class="o_sb_hero_accent">designed online.</span>
                  </h1>
                  <p class="o_sb_hero_sub">
                    Configure cabinets, see live pricing, request a
                    formal quote — all from your browser. No salesperson
                    on the phone. No spreadsheet roundtrips.
                  </p>
                  <p class="o_sb_hero_cta_row">
                    <a href="/my/southbrook/order-builder/new"
                       class="o_sb_btn o_sb_btn_primary o_sb_btn_lg">
                      Design Your Kitchen →
                    </a>
                    <a href="/web/login"
                       class="o_sb_btn o_sb_btn_ghost o_sb_btn_lg">
                      Sign In
                    </a>
                  </p>
                  <p class="o_sb_hero_meta">
                    Free to start. No credit card. Quote in minutes.
                  </p>
                </div>
                <div class="col-lg-5 o_sb_hero_aside">
                  <!-- Interactive 3D sample preview (client-side toy scene;
                       never persists, never calls the backend). The widget
                       in static/src/js/sample_3d_widget.esm.js self-mounts
                       on .o_sb_sample3d_host and fills it (SAMPLE header +
                       canvas + 2 draggable inventory cards). A static
                       fallback renders if WebGL is unavailable. -->
                  <div class="o_sb_hero_card o_sb_sample3d_card">
                    <div class="o_sb_sample3d_host"/>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <!-- STAT BAND (Fulcrum-pattern Tier-1 #2 from docs/Fulcrum.md).
               Three proof pills under the hero. Claims pulled from
               already-published homepage copy — no fabricated numbers.
               Stat-style typography (big mono value + small sans label)
               mirrors the .sb-mono-value treatment in portal_root. -->
          <section class="o_sb_stats">
            <div class="container">
              <div class="o_sb_stats_grid">
                <div class="o_sb_stat">
                  <div class="o_sb_stat_value">
                    &lt;&#160;5<span class="o_sb_stat_unit">min</span>
                  </div>
                  <div class="o_sb_stat_label">
                    Quote inside the configurator
                  </div>
                </div>
                <div class="o_sb_stat">
                  <div class="o_sb_stat_value">
                    4–6<span class="o_sb_stat_unit">wk</span>
                  </div>
                  <div class="o_sb_stat_label">
                    Typical lead time
                  </div>
                </div>
                <div class="o_sb_stat">
                  <div class="o_sb_stat_value o_sb_stat_value_text">
                    Lifetime
                  </div>
                  <div class="o_sb_stat_label">
                    Finish warranty
                  </div>
                </div>
              </div>
            </div>
          </section>

          <!-- FOUR-STEP JOURNEY (Fulcrum-pattern Tier-2 #5 from
               docs/Fulcrum.md). Replaces the prior 3-up FontAwesome
               feature row with a numbered Design -> Configure -> Approve
               -> Build narrative. Chevron divider mirrors the
               .o_owl_stages clip-path treatment from portal_root.scss
               at a marketing scale. -->
          <section class="o_sb_journey">
            <div class="container">
              <header class="o_sb_journey_header">
                <h2 class="o_sb_journey_title">
                  From idea to installed,<br/>
                  <span class="o_sb_journey_accent">in four steps.</span>
                </h2>
                <p class="o_sb_journey_sub">
                  Every stage visible to you. No black-box handoffs
                  between the design tool and the cabinet shop.
                </p>
              </header>
              <ol class="o_sb_journey_stages">
                <li class="o_sb_journey_stage">
                  <div class="o_sb_journey_stage_num">01</div>
                  <h3 class="o_sb_journey_stage_title">Design</h3>
                  <p class="o_sb_journey_stage_body">
                    Sketch your kitchen layout in the planner. Define
                    walls, doors, windows, and appliances.
                  </p>
                </li>
                <li class="o_sb_journey_stage">
                  <div class="o_sb_journey_stage_num">02</div>
                  <h3 class="o_sb_journey_stage_title">Configure</h3>
                  <p class="o_sb_journey_stage_body">
                    Pick cabinet families. Set dimensions to the
                    millimetre. Choose door style, finish, and hardware.
                  </p>
                </li>
                <li class="o_sb_journey_stage">
                  <div class="o_sb_journey_stage_num">03</div>
                  <h3 class="o_sb_journey_stage_title">Approve</h3>
                  <p class="o_sb_journey_stage_body">
                    Review your formal quote, spec sheet, and 3D
                    drawings. Sign off when it's right.
                  </p>
                </li>
                <li class="o_sb_journey_stage">
                  <div class="o_sb_journey_stage_num">04</div>
                  <h3 class="o_sb_journey_stage_title">Build</h3>
                  <p class="o_sb_journey_stage_body">
                    Our shop fabricates from your approved design,
                    Mission Control validates every cabinet before
                    fab, and the kitchen ships flat-pack-ready.
                  </p>
                </li>
              </ol>
            </div>
          </section>

          <!-- SECONDARY CTA STRIP -->
          <section class="o_sb_cta_strip">
            <div class="container">
              <div class="row align-items-center">
                <div class="col-lg-8">
                  <h2 class="o_sb_cta_strip_title">
                    Ready to design your kitchen?
                  </h2>
                  <p class="o_sb_cta_strip_sub">
                    Start a draft project — no commitment, no salesperson.
                  </p>
                </div>
                <div class="col-lg-4 text-lg-end">
                  <a href="/my/southbrook/order-builder/new"
                     class="o_sb_btn o_sb_btn_primary o_sb_btn_lg">
                    Start Now →
                  </a>
                </div>
              </div>
            </div>
          </section>

        </main>
      </div>
    </xpath>

  </template>

</odoo>
