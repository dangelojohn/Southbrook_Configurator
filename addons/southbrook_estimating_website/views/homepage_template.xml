<?xml version="1.0" encoding="utf-8"?>
<!--
  G1 + G2 (customer-flow JTBD gap analysis 2026-06-01) — public
  Southbrook homepage.

  Pre-fix: the website root rendered Odoo's default homepage — no
  Southbrook branding, no value prop, no CTA, no path to the
  configurator. A visitor like Sarah Johnson arriving at the site had
  no idea what Southbrook does or how to begin.

  Approach: inherit the stock `website.homepage` template (which the
  Odoo website controller renders for /) and REPLACE its body with the
  Southbrook hero + features + CTA strip. No new route, no controller
  conflict — Odoo's default `/` handler renders this every time.

  The 'Design Your Kitchen' CTA links to /my/southbrook/order-builder/new
  unconditionally. The /my/... route requires auth, so Odoo auto-
  redirects anonymous visitors to /web/login?redirect=/my/... then
  back to the new-order route after sign-in. Single href, both
  audiences.

  All styling uses the shared design tokens (sb-walnut, sb-linen, etc.
  on :root) per docs/CUSTOMER_TO_MANUFACTURING_FLOW.md §5.
-->
<odoo>

  <template
      id="southbrook_homepage"
      name="Southbrook Homepage"
      inherit_id="website.homepage">

    <!-- Replace the entire body of website.homepage. The xpath targets
         the outermost div of the stock template (Odoo 19 ships a
         <div id="wrap"> in website.homepage, see addons/website/views/
         website_templates.xml). We replace its children wholesale. -->
    <xpath expr="//div[@id='wrap']" position="replace">
      <div id="wrap" class="oe_structure oe_empty">
        <main class="o_sb_home">

          <!-- HERO -->
          <section class="o_sb_hero">
            <div class="container">
              <div class="row">
                <div class="col-lg-7 o_sb_hero_text">
                  <h1 class="o_sb_hero_title">
                    Custom kitchen cabinets,<br/>
                    <span class="o_sb_hero_accent">designed online.</span>
                  </h1>
                  <p class="o_sb_hero_sub">
                    Configure cabinets, see live pricing, request a
                    formal quote — all from your browser. No salesperson
                    on the phone. No spreadsheet roundtrips.
                  </p>
                  <p class="o_sb_hero_cta_row">
                    <a href="/my/southbrook/order-builder/new"
                       class="o_sb_btn o_sb_btn_primary o_sb_btn_lg">
                      Design Your Kitchen →
                    </a>
                    <a href="/web/login"
                       class="o_sb_btn o_sb_btn_ghost o_sb_btn_lg">
                      Sign In
                    </a>
                  </p>
                  <p class="o_sb_hero_meta">
                    Free to start. No credit card. Quote in minutes.
                  </p>
                </div>
                <div class="col-lg-5 o_sb_hero_aside">
                  <div class="o_sb_hero_card">
                    <div class="o_sb_hero_card_label">FEATURED</div>
                    <div class="o_sb_hero_card_title">
                      Signature Series
                    </div>
                    <p class="o_sb_hero_card_body">
                      Solid-wood frames, soft-close hardware, lifetime
                      finish warranty. Configured to your dimensions
                      and shipped flat-pack-ready.
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <!-- STAT BAND (Fulcrum-pattern Tier-1 #2 from docs/Fulcrum.md).
               Three proof pills under the hero. Claims pulled from
               already-published homepage copy — no fabricated numbers.
               Stat-style typography (big mono value + small sans label)
               mirrors the .sb-mono-value treatment in portal_root. -->
          <section class="o_sb_stats">
            <div class="container">
              <div class="o_sb_stats_grid">
                <div class="o_sb_stat">
                  <div class="o_sb_stat_value">
                    &lt;&#160;5<span class="o_sb_stat_unit">min</span>
                  </div>
                  <div class="o_sb_stat_label">
                    Quote inside the configurator
                  </div>
                </div>
                <div class="o_sb_stat">
                  <div class="o_sb_stat_value">
                    4–6<span class="o_sb_stat_unit">wk</span>
                  </div>
                  <div class="o_sb_stat_label">
                    Typical lead time
                  </div>
                </div>
                <div class="o_sb_stat">
                  <div class="o_sb_stat_value o_sb_stat_value_text">
                    Lifetime
                  </div>
                  <div class="o_sb_stat_label">
                    Finish warranty
                  </div>
                </div>
              </div>
            </div>
          </section>

          <!-- FOUR-STEP JOURNEY (Fulcrum-pattern Tier-2 #5 from
               docs/Fulcrum.md). Replaces the prior 3-up FontAwesome
               feature row with a numbered Design -> Configure -> Approve
               -> Build narrative. Chevron divider mirrors the
               .o_owl_stages clip-path treatment from portal_root.scss
               at a marketing scale. -->
          <section class="o_sb_journey">
            <div class="container">
              <header class="o_sb_journey_header">
                <h2 class="o_sb_journey_title">
                  From idea to installed,<br/>
                  <span class="o_sb_journey_accent">in four steps.</span>
                </h2>
                <p class="o_sb_journey_sub">
                  Every stage visible to you. No black-box handoffs
                  between the design tool and the cabinet shop.
                </p>
              </header>
              <ol class="o_sb_journey_stages">
                <li class="o_sb_journey_stage">
                  <div class="o_sb_journey_stage_num">01</div>
                  <h3 class="o_sb_journey_stage_title">Design</h3>
                  <p class="o_sb_journey_stage_body">
                    Sketch your kitchen layout in the planner. Define
                    walls, doors, windows, and appliances.
                  </p>
                </li>
                <li class="o_sb_journey_stage">
                  <div class="o_sb_journey_stage_num">02</div>
                  <h3 class="o_sb_journey_stage_title">Configure</h3>
                  <p class="o_sb_journey_stage_body">
                    Pick cabinet families. Set dimensions to the
                    millimetre. Choose door style, finish, and hardware.
                  </p>
                </li>
                <li class="o_sb_journey_stage">
                  <div class="o_sb_journey_stage_num">03</div>
                  <h3 class="o_sb_journey_stage_title">Approve</h3>
                  <p class="o_sb_journey_stage_body">
                    Review your formal quote, spec sheet, and 3D
                    drawings. Sign off when it's right.
                  </p>
                </li>
                <li class="o_sb_journey_stage">
                  <div class="o_sb_journey_stage_num">04</div>
                  <h3 class="o_sb_journey_stage_title">Build</h3>
                  <p class="o_sb_journey_stage_body">
                    Our shop fabricates from your approved design,
                    Mission Control validates every cabinet before
                    fab, and the kitchen ships flat-pack-ready.
                  </p>
                </li>
              </ol>
            </div>
          </section>

          <!-- COMPARISON: industry default vs Southbrook (Fulcrum-pattern
               Tier-1 #4 from docs/Fulcrum.md). Five paired rows that
               re-frame the custom-cabinet buying experience without
               jokey language. Premium-restrained voice. -->
          <section class="o_sb_compare">
            <div class="container">
              <header class="o_sb_compare_header">
                <h2 class="o_sb_compare_title">
                  The custom-kitchen industry,<br/>
                  <span class="o_sb_compare_accent">reimagined.</span>
                </h2>
                <p class="o_sb_compare_sub">
                  What changes when the design tool, the price engine,
                  and the cabinet shop share one source of truth.
                </p>
              </header>
              <div class="o_sb_compare_rows">

                <article class="o_sb_compare_row">
                  <div class="o_sb_compare_cell o_sb_compare_old">
                    <span class="o_sb_compare_glyph" aria-hidden="true">×</span>
                    <div class="o_sb_compare_body">
                      <span class="o_sb_compare_label">Industry default</span>
                      <p class="o_sb_compare_text">
                        Showroom appointment required to start.
                      </p>
                    </div>
                  </div>
                  <div class="o_sb_compare_cell o_sb_compare_new">
                    <span class="o_sb_compare_glyph" aria-hidden="true">→</span>
                    <div class="o_sb_compare_body">
                      <span class="o_sb_compare_label">Southbrook</span>
                      <p class="o_sb_compare_text">
                        Configure your kitchen from anywhere, on any device.
                      </p>
                    </div>
                  </div>
                </article>

                <article class="o_sb_compare_row">
                  <div class="o_sb_compare_cell o_sb_compare_old">
                    <span class="o_sb_compare_glyph" aria-hidden="true">×</span>
                    <div class="o_sb_compare_body">
                      <span class="o_sb_compare_label">Industry default</span>
                      <p class="o_sb_compare_text">
                        A PDF quote, days after the appointment.
                      </p>
                    </div>
                  </div>
                  <div class="o_sb_compare_cell o_sb_compare_new">
                    <span class="o_sb_compare_glyph" aria-hidden="true">→</span>
                    <div class="o_sb_compare_body">
                      <span class="o_sb_compare_label">Southbrook</span>
                      <p class="o_sb_compare_text">
                        Live pricing in the configurator. Quote in minutes.
                      </p>
                    </div>
                  </div>
                </article>

                <article class="o_sb_compare_row">
                  <div class="o_sb_compare_cell o_sb_compare_old">
                    <span class="o_sb_compare_glyph" aria-hidden="true">×</span>
                    <div class="o_sb_compare_body">
                      <span class="o_sb_compare_label">Industry default</span>
                      <p class="o_sb_compare_text">
                        Lead times revealed after deposit.
                      </p>
                    </div>
                  </div>
                  <div class="o_sb_compare_cell o_sb_compare_new">
                    <span class="o_sb_compare_glyph" aria-hidden="true">→</span>
                    <div class="o_sb_compare_body">
                      <span class="o_sb_compare_label">Southbrook</span>
                      <p class="o_sb_compare_text">
                        Production capacity visible at the quote.
                      </p>
                    </div>
                  </div>
                </article>

                <article class="o_sb_compare_row">
                  <div class="o_sb_compare_cell o_sb_compare_old">
                    <span class="o_sb_compare_glyph" aria-hidden="true">×</span>
                    <div class="o_sb_compare_body">
                      <span class="o_sb_compare_label">Industry default</span>
                      <p class="o_sb_compare_text">
                        Hand-drafted cut lists. Drift between design and shop.
                      </p>
                    </div>
                  </div>
                  <div class="o_sb_compare_cell o_sb_compare_new">
                    <span class="o_sb_compare_glyph" aria-hidden="true">→</span>
                    <div class="o_sb_compare_body">
                      <span class="o_sb_compare_label">Southbrook</span>
                      <p class="o_sb_compare_text">
                        Cut spec and shop drawings auto-generated from the design.
                      </p>
                    </div>
                  </div>
                </article>

                <article class="o_sb_compare_row">
                  <div class="o_sb_compare_cell o_sb_compare_old">
                    <span class="o_sb_compare_glyph" aria-hidden="true">×</span>
                    <div class="o_sb_compare_body">
                      <span class="o_sb_compare_label">Industry default</span>
                      <p class="o_sb_compare_text">
                        Custom means uncertain.
                      </p>
                    </div>
                  </div>
                  <div class="o_sb_compare_cell o_sb_compare_new">
                    <span class="o_sb_compare_glyph" aria-hidden="true">→</span>
                    <div class="o_sb_compare_body">
                      <span class="o_sb_compare_label">Southbrook</span>
                      <p class="o_sb_compare_text">
                        Every cabinet validated before fabrication.
                      </p>
                    </div>
                  </div>
                </article>

              </div>
            </div>
          </section>

          <!-- FAQ ACCORDION (Fulcrum-pattern Tier-2 #9 from
               docs/Fulcrum.md). Eight grounded customer questions above
               the CTA so visitors get policy answers before the final
               ask. Pure HTML5 <details>/<summary> — zero JS, native
               keyboard + screen-reader support. Custom +/- glyph
               replaces the default disclosure triangle. Answers
               grounded in repo code/copy; warranty + shipping carry
               deliberate hedges ("talk to your designer / talk to us")
               pending full policy confirmation. -->
          <section class="o_sb_faq">
            <div class="container">
              <header class="o_sb_faq_header">
                <h2 class="o_sb_faq_title">
                  Questions,<br/>
                  <span class="o_sb_faq_accent">answered.</span>
                </h2>
                <p class="o_sb_faq_sub">
                  What custom-kitchen shoppers ask before they commit.
                </p>
              </header>
              <div class="o_sb_faq_list">

                <details class="o_sb_faq_item">
                  <summary class="o_sb_faq_question">
                    How long does a Southbrook kitchen take to make?
                  </summary>
                  <div class="o_sb_faq_answer">
                    <p>
                      Typical lead time is 4–6 weeks. Orders start at a
                      14-day shop baseline; some options (like Maple
                      boxes) add about two weeks. Your exact lead time
                      appears on the formal quote, so production capacity
                      is visible before you commit.
                    </p>
                  </div>
                </details>

                <details class="o_sb_faq_item">
                  <summary class="o_sb_faq_question">
                    How fast do I get a price for my kitchen?
                  </summary>
                  <div class="o_sb_faq_answer">
                    <p>
                      Live pricing appears inside the configurator as you
                      choose cabinets and options — no waiting for a
                      quote-back email. A full formal quote with spec
                      sheet typically takes under five minutes from
                      inside the planner.
                    </p>
                  </div>
                </details>

                <details class="o_sb_faq_item">
                  <summary class="o_sb_faq_question">
                    What changes the price of a custom cabinet?
                  </summary>
                  <div class="o_sb_faq_answer">
                    <p>
                      Four things move the price: cabinet series
                      (Contractor through Signature), box material
                      (Maple adds about 10%), door style and finish, and
                      accessories like soft-close hardware or pull-outs.
                      Every choice re-prices live, so you see the impact
                      immediately.
                    </p>
                  </div>
                </details>

                <details class="o_sb_faq_item">
                  <summary class="o_sb_faq_question">
                    What's the difference between Signature and Contractor?
                  </summary>
                  <div class="o_sb_faq_answer">
                    <p>
                      Contractor is our value tier — white thermofoil
                      slab doors, fixed option set. Signature is fully
                      custom, including five-piece woodgrain doors,
                      every finish, and Maple-box construction.
                      Contemporary and Elegance sit between them. Pick
                      the series that matches your room and budget.
                    </p>
                  </div>
                </details>

                <details class="o_sb_faq_item">
                  <summary class="o_sb_faq_question">
                    Do my cabinets come with soft-close hardware?
                  </summary>
                  <div class="o_sb_faq_answer">
                    <p>
                      Soft-close hinges and slides are a standard
                      accessory option on every cabinet family except
                      bi-fold corner cabinets (the geometry doesn't
                      support them). You select it alongside drawer
                      organisers and pull-outs when you configure each
                      cabinet.
                    </p>
                  </div>
                </details>

                <details class="o_sb_faq_item">
                  <summary class="o_sb_faq_question">
                    What's covered by the warranty?
                  </summary>
                  <div class="o_sb_faq_answer">
                    <p>
                      Our finish carries a lifetime warranty. Full
                      warranty terms for cabinet boxes, hinges, and
                      slides ship with every order — talk to your
                      designer for specifics on your kitchen.
                    </p>
                  </div>
                </details>

                <details class="o_sb_faq_item">
                  <summary class="o_sb_faq_question">
                    Where do you ship and how do cabinets arrive?
                  </summary>
                  <div class="o_sb_faq_answer">
                    <p>
                      Cabinets ship flat-pack-ready, with cut lists and
                      shop drawings generated directly from your
                      approved design — so the box you open matches the
                      plan you signed off on. Shipping rates and
                      delivery area are quoted with your order; ask us
                      about your address.
                    </p>
                  </div>
                </details>

                <details class="o_sb_faq_item">
                  <summary class="o_sb_faq_question">
                    What do I actually get with my quote?
                  </summary>
                  <div class="o_sb_faq_answer">
                    <p>
                      A formal Signature Spec Sheet PDF: itemised
                      cabinet list, every dimension, every option, the
                      rolled-up price, and 3D drawings of your design.
                      You review it inside your account, sign off when
                      it's right, then it goes to production.
                    </p>
                  </div>
                </details>

              </div>
            </div>
          </section>

          <!-- SECONDARY CTA STRIP -->
          <section class="o_sb_cta_strip">
            <div class="container">
              <div class="row align-items-center">
                <div class="col-lg-8">
                  <h2 class="o_sb_cta_strip_title">
                    Ready to design your kitchen?
                  </h2>
                  <p class="o_sb_cta_strip_sub">
                    Start a draft project — no commitment, no salesperson.
                  </p>
                </div>
                <div class="col-lg-4 text-lg-end">
                  <a href="/my/southbrook/order-builder/new"
                     class="o_sb_btn o_sb_btn_primary o_sb_btn_lg">
                    Start Now →
                  </a>
                </div>
              </div>
            </div>
          </section>

        </main>
      </div>
    </xpath>

  </template>

</odoo>
