<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_kitchen_material_form_material" model="ir.ui.view">
    <field name="name">southbrook.kitchen.material.form.material</field>
    <field name="model">southbrook.kitchen.material</field>
    <field name="inherit_id" ref="southbrook_mrp_kitchen_workcenters.view_sbk_material_form"/>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='note']/parent::group" position="before">
        <group string="Material Master">
          <field name="family_id"/>
          <field name="weight_source"/>
          <field name="density"/>
          <field name="density_source"/>
          <field name="effective_density" readonly="1"/>
          <field name="base_uom_id"/>
          <field name="facing"/>
          <field name="waste_pct"/>
          <field name="linear_density" invisible="weight_source != 'linear_density'"/>
          <field name="weight_per_unit" invisible="weight_source != 'per_unit'"/>
          <field name="manual_unit_price"/>
          <field name="currency_id" invisible="1"/>
        </group>
        <group string="Dimensions (mm + Imperial)">
          <field name="standard_thickness"/>
          <label for="thickness_mm" string="Thickness"/>
          <div class="o_row">
            <field name="thickness_mm"/>
            <span>mm</span>
            <field name="thickness_in"/>
            <span>in</span>
          </div>
          <label for="sheet_width_mm" string="Sheet Width"/>
          <div class="o_row">
            <field name="sheet_width_mm"/>
            <span>mm</span>
            <field name="sheet_width_in"/>
            <span>in</span>
          </div>
          <label for="sheet_height_mm" string="Sheet Height"/>
          <div class="o_row">
            <field name="sheet_height_mm"/>
            <span>mm</span>
            <field name="sheet_height_in"/>
            <span>in</span>
          </div>
        </group>
      </xpath>
    </field>
  </record>
</odoo>
