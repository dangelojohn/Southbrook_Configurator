    <field name="x_pricing_pending" eval="True"/>
    <field name="x_material">LeMans-style swing-out shelves for 800-1000mm corner carcass</field>
  </record>

  <!-- Planero Swing-Out Corner — Vauth-Sagel's high-end mechanism. -->
