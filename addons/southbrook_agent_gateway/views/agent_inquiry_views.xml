<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_agent_inquiry_list" model="ir.ui.view">
        <field name="name">southbrook.agent.inquiry.list</field>
        <field name="model">southbrook.agent.inquiry</field>
        <field name="arch" type="xml">
            <list default_order="create_date desc">
                <field name="reference"/>
                <field name="create_date"/>
                <field name="customer_name"/>
                <field name="email"/>
                <field name="agent_name" optional="show"/>
                <field name="state"
                       decoration-success="state == 'verified'"
                       decoration-muted="state == 'spam'"
                       widget="badge"/>
                <field name="lead_id"/>
            </list>
        </field>
    </record>

    <record id="view_agent_inquiry_form" model="ir.ui.view">
        <field name="name">southbrook.agent.inquiry.form</field>
        <field name="model">southbrook.agent.inquiry</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="reference" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Customer (as submitted)">
                            <field name="customer_name"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="verified_at"/>
                        </group>
                        <group string="Submitting Agent">
                            <field name="agent_name"/>
                            <field name="agent_platform"/>
                            <field name="agent_user_agent"/>
                        </group>
                    </group>
                    <group string="Project">
                        <field name="project_description" nolabel="1"/>
                        <field name="room_type"/>
                        <field name="budget_range"/>
                        <field name="timeline"/>
                    </group>
                    <group string="CRM Links">
                        <field name="partner_id"/>
                        <field name="lead_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_agent_inquiries" model="ir.actions.act_window">
        <field name="name">AI Agent Inquiries</field>
        <field name="res_model">southbrook.agent.inquiry</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_agent_inquiries"
              name="AI Agent Inquiries"
              parent="crm.crm_menu_root"
              action="action_agent_inquiries"
              sequence="60"/>
</odoo>
