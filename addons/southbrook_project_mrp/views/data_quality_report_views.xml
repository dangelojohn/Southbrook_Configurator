<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="data_quality_report_form" model="ir.ui.view">
        <field name="name">southbrook.project.data.quality.report.form</field>
        <field name="model">southbrook.project.data.quality.report</field>
        <field name="arch" type="xml">
            <form string="Southbrook Data Quality Dry Run" create="false"
                  edit="false">
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="project_id" readonly="1"/>
                        <field name="generated_at" readonly="1"/>
                    </group>
                    <group>
                        <field name="summary" readonly="1" nolabel="1"/>
                    </group>
                    <field name="line_ids" readonly="1">
                        <list create="false" edit="false">
                            <field name="severity" widget="badge"
                                   decoration-danger="severity == 'blocker'"
                                   decoration-warning="severity == 'warning'"
                                   decoration-info="severity == 'info'"/>
                            <field name="issue_key"/>
                            <field name="model_name"/>
                            <field name="res_model" optional="hide"/>
                            <field name="res_id" optional="hide"/>
                            <field name="record_ref"/>
                            <field name="reason"/>
                            <field name="recommended_action"/>
                            <field name="cleanup_state" widget="badge"
                                   decoration-success="cleanup_state == 'applied'"
                                   decoration-warning="cleanup_state == 'skipped'"
                                   decoration-info="cleanup_state == 'pending'"/>
                            <field name="cleanup_note" optional="show"/>
                            <button name="action_apply_safe_cleanup"
                                    type="object"
                                    string="Safe Cleanup"
                                    class="btn-secondary"
                                    invisible="cleanup_state != 'pending'"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
