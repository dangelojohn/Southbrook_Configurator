<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="project_task_form_mrp" model="ir.ui.view">
        <field name="name">project.task.form.southbrook.mrp</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">

            <!-- Smart buttons: MOs (B6) + ECOs (B4) -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object"
                        name="action_view_productions" icon="fa-wrench"
                        invisible="production_count == 0">
                    <field name="production_count" widget="statinfo" string="MOs"/>
                </button>
                <button class="oe_stat_button" type="object"
                        name="action_view_ecos" icon="fa-exchange"
                        invisible="eco_count == 0">
                    <field name="eco_count" widget="statinfo" string="ECOs"/>
                </button>
                <!-- TASK 2: WO smart button -->
                <button class="oe_stat_button" type="object"
                        name="action_view_workorders" icon="fa-cogs"
                        invisible="workorder_count == 0">
                    <field name="workorder_count" widget="statinfo" string="WOs"/>
                </button>
                <button class="oe_stat_button" type="object"
                        name="action_view_manufacturing_calculations"
                        icon="fa-calculator"
                        invisible="production_count == 0">
                    <field name="manufacturing_calculation_count"
                           widget="statinfo" string="Calculations"/>
                </button>
                <button class="oe_stat_button" type="object"
                        name="action_view_readiness_lines"
                        icon="fa-list">
                    <field name="readiness_line_count"
                           widget="statinfo" string="Readiness"/>
                </button>
                <button class="oe_stat_button" type="object"
                        name="action_view_procurement_orders" icon="fa-shopping-cart"
                        invisible="procurement_count == 0">
                    <field name="procurement_count" widget="statinfo" string="POs"/>
                </button>
                <button class="oe_stat_button" type="object"
                        name="action_view_maintenance_requests" icon="fa-warning"
                        invisible="maintenance_request_count == 0">
                    <field name="maintenance_request_count" widget="statinfo" string="Maint."/>
                </button>
            </xpath>

            <!-- B3/B4/B5: risk / spec-change / stage-divergence banners -->
            <xpath expr="//div[@name='button_box']" position="after">
                <div class="alert alert-danger" role="alert"
                     invisible="not job_at_risk">
                    <strong>At risk: </strong>
                    <field name="job_risk_reason" nolabel="1" class="oe_inline"/>
                </div>
                <div class="alert alert-warning" role="alert"
                     invisible="eco_pending_count == 0">
                    <strong>Spec change in flight: </strong>
                    <field name="eco_pending_count" nolabel="1" class="oe_inline"/>
                    pending engineering change(s) on this job's BoMs.
                </div>
                <div class="alert alert-warning" role="alert"
                     invisible="not stage_mo_divergence">
                    <field name="stage_mo_note" nolabel="1" class="oe_inline"/>
                </div>
                <div class="alert alert-warning" role="alert"
                     invisible="not material_at_risk">
                    <strong>Material at risk: </strong>
                    <field name="material_readiness_summary" nolabel="1" class="oe_inline"/>
                </div>
                <div class="alert alert-danger" role="alert"
                     invisible="not equipment_blocked">
                    <strong>Equipment blocked: </strong>
                    <field name="equipment_readiness_summary" nolabel="1" class="oe_inline"/>
                </div>
            </xpath>

            <!-- B1: the accountable PM -->
            <xpath expr="//field[@name='user_ids']" position="after">
                <field name="pm_id" widget="many2one_avatar_user"/>

                <!-- B3: build status, read-only, from mrp/stock -->
                <field name="components_available" widget="badge"
                       decoration-success="components_available == 'ready'"
                       decoration-warning="components_available == 'partial'"
                       decoration-danger="components_available == 'waiting'"
                       invisible="production_count == 0"/>
                <field name="mo_state_summary" invisible="production_count == 0"/>
                <field name="mo_reference" invisible="production_count == 0"/>
                <field name="mo_product_summary" invisible="production_count == 0"/>

                <!-- B2: cost (actual + estimated) -->
                <field name="company_currency_id" column_invisible="1"/>
                <field name="job_industrial_cost" invisible="production_count == 0"/>
                <field name="job_estimated_cost" invisible="production_count == 0"/>

                <field name="job_install_due" invisible="not job_install_due"/>
                <field name="job_cad_status" invisible="not job_cad_status"/>
                <field name="job_next_action" invisible="not job_next_action"/>
            </xpath>

            <!-- Phase 1: Kitchen Job Command Center summary. Read-only fields
                 are computed from existing Project/MRP facts and kept above
                 the raw manufacturing tables so the PM sees decision context
                 before drilling into MOs or WOs. -->
            <xpath expr="//sheet" position="inside">
                <group string="Kitchen Job Command Center">
                    <group>
                        <field name="source_order_id" readonly="1"/>
                        <field name="customer_id" readonly="1"/>
                        <field name="install_due_date" readonly="1"/>
                        <field name="pm_phase" readonly="1"/>
                        <field name="manufacturing_reality" readonly="1"/>
                    </group>
                    <group>
                        <field name="readiness_decision"
                               widget="badge"
                               decoration-success="readiness_decision == 'ready'"
                               decoration-warning="readiness_decision == 'review'"
                               decoration-danger="readiness_decision == 'blocked'"
                               readonly="1"/>
                        <field name="readiness_score" readonly="1"/>
                        <field name="risk_level"
                               widget="badge"
                               decoration-success="risk_level == 'low'"
                               decoration-warning="risk_level in ('medium', 'high')"
                               decoration-danger="risk_level == 'critical'"
                               readonly="1"/>
                        <field name="risk_reason" readonly="1"/>
                        <field name="top_blocker" readonly="1"/>
                        <field name="next_best_action" readonly="1"/>
                    </group>
                    <group string="Counts">
                        <field name="linked_mo_count" readonly="1"/>
                        <field name="linked_wo_count" readonly="1"/>
                        <field name="unscheduled_wo_count" readonly="1"/>
                        <field name="unassigned_wo_count" readonly="1"/>
                    </group>
                    <group string="Cabinet Mix">
                        <field name="current_bottleneck_workcenter_id" readonly="1"/>
                        <field name="cabinet_family_summary" readonly="1"/>
                        <field name="job_type"/>
                    </group>
                </group>
            </xpath>

            <!-- B6: Manufacturing page — the job's MOs (rows open the MO) -->
            <xpath expr="//notebook" position="inside">
                <page name="southbrook_readiness" string="Readiness">
                    <group string="Readiness Decision">
                        <group>
                            <field name="readiness_decision"
                                   widget="badge"
                                   decoration-success="readiness_decision == 'ready'"
                                   decoration-warning="readiness_decision == 'review'"
                                   decoration-danger="readiness_decision == 'blocked'"
                                   readonly="1"/>
                            <field name="readiness_score" readonly="1"/>
                            <field name="risk_level"
                                   widget="badge"
                                   decoration-success="risk_level == 'low'"
                                   decoration-warning="risk_level in ('medium', 'high')"
                                   decoration-danger="risk_level == 'critical'"
                                   readonly="1"/>
                        </group>
                        <group>
                            <field name="top_blocker" readonly="1"/>
                            <field name="next_best_action" readonly="1"/>
                            <field name="risk_reason" readonly="1"/>
                        </group>
                    </group>
                    <button type="object"
                            name="action_recompute_readiness_lines"
                            string="Refresh Readiness Evidence"
                            class="btn-secondary"/>
                    <field name="readiness_line_ids" readonly="1">
                        <list create="false" edit="false">
                            <field name="sequence" optional="hide"/>
                            <field name="name"/>
                            <field name="status" widget="badge"
                                   decoration-success="status == 'ready'"
                                   decoration-warning="status == 'review'"
                                   decoration-danger="status == 'blocked'"
                                   decoration-info="status == 'info'"/>
                            <field name="severity" widget="badge"
                                   decoration-danger="severity == 'blocker'"
                                   decoration-warning="severity == 'warning'"
                                   decoration-info="severity == 'info'"/>
                            <field name="reason"/>
                            <field name="evidence" optional="show"/>
                            <field name="recommended_action" optional="show"/>
                        </list>
                    </field>
                </page>

                <page name="southbrook_project_mrp_cabinet_specs"
                      string="Cabinet Specs">
                    <group>
                        <group string="Core Specs">
                            <field name="southbrook_specs_complete"
                                   widget="boolean_toggle" readonly="1"/>
                            <field name="x_southbrook_material_species"/>
                            <field name="southbrook_door_style"/>
                            <field name="southbrook_finish"/>
                        </group>
                        <group string="Hardware">
                            <field name="southbrook_hinge_type"/>
                            <field name="southbrook_drawer_slide_type"/>
                            <field name="x_southbrook_hardware_specs"/>
                        </group>
                    </group>
                    <group>
                        <group string="Engineering References">
                            <field name="southbrook_cad_package_link"/>
                            <field name="southbrook_cutlist_reference"/>
                            <field name="southbrook_worktop_dependency"/>
                        </group>
                        <group string="Final Measurement">
                            <field name="southbrook_final_measurement_notes"
                                   nolabel="1"/>
                        </group>
                    </group>
                </page>

                <page name="manufacturing" string="Manufacturing"
                      groups="mrp.group_mrp_user">
                    <field name="x_southbrook_sale_order_id" invisible="1"/>
                    <button type="object"
                            name="action_link_productions_from_sale"
                            string="Link MOs from Sale" class="btn-secondary"
                            invisible="not x_southbrook_sale_order_id"/>
                    <field name="production_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="product_id"/>
                            <field name="bom_id"/>
                            <field name="product_qty"/>
                            <field name="state" widget="badge"/>
                            <field name="reservation_state" widget="badge"
                                   optional="show"/>
                            <field name="date_deadline" optional="show"/>
                        </list>
                    </field>
                </page>

                <!-- TASK 2: Work Orders page — per-WC duration + planned
                     start + state. Operators see what's "Not scheduled" at a
                     glance; the button above the list opens the WOs filtered
                     to this job so the scheduler can set start dates in the
                     native Work Orders view. -->
                <page name="job_workorders" string="Work Orders"
                      groups="mrp.group_mrp_user"
                      invisible="workorder_count == 0">
                    <group string="Manufacturing Readiness">
                        <group>
                            <field name="manufacturing_readiness_state"
                                   widget="badge"
                                   decoration-success="manufacturing_readiness_state == 'ready'"
                                   decoration-warning="manufacturing_readiness_state == 'review'"
                                   decoration-danger="manufacturing_readiness_state == 'blocked'"
                                   readonly="1"/>
                            <field name="manufacturing_readiness_score"
                                   readonly="1"/>
                        </group>
                        <group>
                            <field name="manufacturing_blocker_summary"
                                   nolabel="1" readonly="1" widget="text"/>
                        </group>
                        <field name="manufacturing_waterfall_summary"
                               nolabel="1" readonly="1" widget="text"/>
                        <field name="manufacturing_warning_summary"
                               nolabel="1" readonly="1" widget="text"/>
                        <field name="manufacturing_info_summary"
                               nolabel="1" readonly="1" widget="text"/>
                    </group>
                    <group>
                        <field name="workorder_summary" readonly="1"/>
                        <field name="unscheduled_workorder_count" readonly="1"/>
                    </group>
                    <!-- TASK 3: Work-center load summary — per-WC booked
                         minutes vs daily capacity. Read-only; no scheduler. -->
                    <group string="Work-center Load (vs Daily Capacity)">
                        <field name="workcenter_over_capacity"
                               widget="boolean_toggle" readonly="1"/>
                        <field name="workcenter_load_summary"
                               nolabel="1" readonly="1"
                               widget="text"/>
                    </group>
                    <!-- TASK 4: Crew indicator — who's assigned across MOs +
                         WOs; flag any gaps. Read-only, no auto-assignment. -->
                    <group string="Crew">
                        <field name="crew_summary" readonly="1"/>
                        <field name="crew_gap"
                               widget="boolean_toggle" readonly="1"/>
                        <field name="unassigned_mo_count" readonly="1"/>
                        <field name="unassigned_workorder_count" readonly="1"/>
                    </group>
                    <group string="Material &amp; Procurement">
                        <group>
                            <field name="material_ready_count" readonly="1"/>
                            <field name="material_partial_count" readonly="1"/>
                            <field name="material_unavailable_count" readonly="1"/>
                            <field name="material_at_risk"
                                   widget="boolean_toggle" readonly="1"/>
                        </group>
                        <group>
                            <field name="procurement_summary"
                                   nolabel="1" readonly="1" widget="text"/>
                        </group>
                        <field name="material_readiness_summary"
                               nolabel="1" readonly="1" widget="text"/>
                        <field name="procurement_order_ids" readonly="1">
                            <list create="false" edit="false">
                                <field name="name"/>
                                <field name="partner_id"/>
                                <field name="date_planned"/>
                                <field name="state" widget="badge"/>
                            </list>
                        </field>
                    </group>
                    <group string="Tooling &amp; Equipment Readiness">
                        <field name="equipment_blocked"
                               widget="boolean_toggle" readonly="1"/>
                        <field name="equipment_readiness_summary"
                               nolabel="1" readonly="1" widget="text"/>
                        <field name="maintenance_request_ids" readonly="1">
                            <list create="false" edit="false">
                                <field name="name"/>
                                <field name="equipment_id"/>
                                <field name="maintenance_team_id"/>
                                <field name="stage_id"/>
                            </list>
                        </field>
                    </group>
                    <!-- TASK 5: Waste / variance — read-only sums of the
                         work-order Kitchen Metrics. No costing engine; just
                         aggregation of fields the shop floor already
                         records. -->
                    <group string="Waste &amp; Variance (Σ across WOs)">
                        <group>
                            <field name="job_expected_min" readonly="1"/>
                            <field name="job_variance_min" readonly="1"/>
                            <field name="job_actual_cost" readonly="1"/>
                            <field name="job_cost_variance" readonly="1"/>
                        </group>
                        <group>
                            <field name="job_rework_count" readonly="1"/>
                            <field name="job_rework_cost" readonly="1"/>
                            <field name="job_downtime_min" readonly="1"/>
                            <field name="job_downtime_cost" readonly="1"/>
                        </group>
                    </group>
                    <button type="object" name="action_view_workorders"
                            string="Open Work Orders View" class="btn-primary"/>
                    <button type="object"
                            name="action_view_workorders_can_start_today"
                            string="What Can Start Today"
                            class="btn-secondary"/>
                    <field name="workorder_ids" readonly="1">
                        <list create="false" edit="false">
                            <field name="name"/>
                            <field name="workcenter_id"/>
                            <field name="duration_expected"
                                   string="Expected (min)"/>
                            <field name="date_start"
                                   string="Planned Start"
                                   widget="datetime"/>
                            <field name="southbrook_not_scheduled"
                                   string="Not Scheduled"
                                   widget="boolean_toggle"/>
                            <field name="southbrook_can_start_today"
                                   widget="boolean_toggle"/>
                            <field name="southbrook_start_blocker"
                                   optional="show"/>
                            <field name="state" widget="badge"
                                   decoration-info="state == 'ready'"
                                   decoration-muted="state == 'pending'"
                                   decoration-warning="state == 'waiting'"
                                   decoration-success="state == 'done'"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

    <record id="project_project_form_readiness_actions" model="ir.ui.view">
        <field name="name">project.project.form.southbrook.readiness.actions</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object"
                        name="action_southbrook_open_blocked_manufacturing_jobs"
                        icon="fa-ban"
                        invisible="southbrook_blocked_job_count == 0">
                    <field name="southbrook_blocked_job_count"
                           widget="statinfo" string="Blocked"/>
                </button>
                <button class="oe_stat_button" type="object"
                        name="action_southbrook_open_unscheduled_manufacturing_jobs"
                        icon="fa-calendar"
                        invisible="southbrook_unscheduled_job_count == 0">
                    <field name="southbrook_unscheduled_job_count"
                           widget="statinfo" string="Schedule"/>
                </button>
                <button class="oe_stat_button" type="object"
                        name="action_southbrook_open_workorders_can_start_today"
                        icon="fa-play"
                        invisible="southbrook_can_start_today_wo_count == 0">
                    <field name="southbrook_can_start_today_wo_count"
                           widget="statinfo" string="Start Today"/>
                </button>
                <button class="oe_stat_button" type="object"
                        name="action_southbrook_open_cad_cutlist_jobs"
                        icon="fa-pencil"
                        invisible="southbrook_cad_cutlist_job_count == 0">
                    <field name="southbrook_cad_cutlist_job_count"
                           widget="statinfo" string="CAD"/>
                </button>
                <button class="oe_stat_button" type="object"
                        name="action_southbrook_open_crew_gap_jobs"
                        icon="fa-users"
                        invisible="southbrook_crew_gap_count == 0">
                    <field name="southbrook_crew_gap_count"
                           widget="statinfo" string="Crew"/>
                </button>
                <button class="oe_stat_button" type="object"
                        name="action_southbrook_open_install_risk_jobs"
                        icon="fa-truck"
                        invisible="southbrook_install_risk_job_count == 0">
                    <field name="southbrook_install_risk_job_count"
                           widget="statinfo" string="Install"/>
                </button>
                <button class="oe_stat_button" type="object"
                        name="action_southbrook_open_material_risk_jobs"
                        icon="fa-cubes"
                        invisible="southbrook_material_risk_count == 0">
                    <field name="southbrook_material_risk_count"
                           widget="statinfo" string="Materials"/>
                </button>
                <button class="oe_stat_button" type="object"
                        name="action_southbrook_open_equipment_blocked_jobs"
                        icon="fa-warning"
                        invisible="southbrook_equipment_blocked_count == 0">
                    <field name="southbrook_equipment_blocked_count"
                           widget="statinfo" string="Equip."/>
                </button>
                <button class="oe_stat_button" type="object"
                        name="action_southbrook_open_over_capacity_jobs"
                        icon="fa-dashboard"
                        invisible="southbrook_over_capacity_count == 0">
                    <field name="southbrook_over_capacity_count"
                           widget="statinfo" string="Capacity"/>
                </button>
                <button class="oe_stat_button" type="object"
                        name="action_southbrook_open_review_manufacturing_jobs"
                        icon="fa-exclamation-triangle"
                        invisible="southbrook_review_job_count == 0">
                    <field name="southbrook_review_job_count"
                           widget="statinfo" string="Review"/>
                </button>
                <button class="oe_stat_button" type="object"
                        name="action_southbrook_open_ready_manufacturing_jobs"
                        icon="fa-check"
                        invisible="southbrook_ready_job_count == 0">
                    <field name="southbrook_ready_job_count"
                           widget="statinfo" string="Ready"/>
                </button>
            </xpath>
        </field>
    </record>

    <record id="project_task_list_readiness" model="ir.ui.view">
        <field name="name">project.task.list.southbrook.readiness</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='stage_id']" position="after">
                <field name="customer_id" optional="show"/>
                <field name="source_order_name" optional="show"/>
                <field name="install_due_date" optional="show"/>
                <field name="pm_phase" optional="hide"/>
                <field name="manufacturing_reality" optional="show"/>
                <field name="manufacturing_readiness_state"
                       widget="badge"
                       decoration-success="manufacturing_readiness_state == 'ready'"
                       decoration-warning="manufacturing_readiness_state == 'review'"
                       decoration-danger="manufacturing_readiness_state == 'blocked'"
                       optional="show"/>
                <field name="manufacturing_readiness_score"
                       optional="show"/>
                <field name="risk_level"
                       widget="badge"
                       decoration-success="risk_level == 'low'"
                       decoration-warning="risk_level in ('medium', 'high')"
                       decoration-danger="risk_level == 'critical'"
                       optional="show"/>
                <field name="top_blocker" optional="show"/>
                <field name="next_best_action" optional="show"/>
                <field name="cad_cutlist_review_required"
                       widget="boolean_toggle" optional="hide"/>
                <field name="install_date_missing"
                       widget="boolean_toggle" optional="hide"/>
                <field name="pm_stage_mismatch"
                       widget="boolean_toggle" optional="hide"/>
                <field name="material_at_risk"
                       widget="boolean_toggle" optional="hide"/>
                <field name="crew_gap"
                       widget="boolean_toggle" optional="hide"/>
                <field name="equipment_blocked"
                       widget="boolean_toggle" optional="hide"/>
                <field name="workcenter_over_capacity"
                       widget="boolean_toggle" optional="hide"/>
                <field name="southbrook_specs_complete"
                       widget="boolean_toggle" optional="hide"/>
                <field name="southbrook_door_style" optional="hide"/>
                <field name="southbrook_finish" optional="hide"/>
                <field name="linked_mo_count" optional="show"/>
                <field name="linked_wo_count" optional="show"/>
                <field name="unscheduled_workorder_count"
                       optional="show"/>
                <field name="unscheduled_wo_count" optional="hide"/>
                <field name="current_bottleneck_workcenter_id" optional="hide"/>
                <field name="cabinet_family_summary" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="project_task_search_readiness" model="ir.ui.view">
        <field name="name">project.task.search.southbrook.readiness</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_search_form"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='message_needaction']"
                   position="before">
                <separator/>
                <filter name="manufacturing_blocked"
                        string="Manufacturing Blocked"
                        domain="[('manufacturing_readiness_state', '=', 'blocked')]"/>
                <filter name="manufacturing_review"
                        string="Manufacturing Review"
                        domain="[('manufacturing_readiness_state', '=', 'review')]"/>
                <filter name="manufacturing_ready"
                        string="Manufacturing Ready"
                        domain="[('manufacturing_readiness_state', '=', 'ready')]"/>
                <filter name="needs_cad_cutlist"
                        string="Needs CAD / Cutlist"
                        domain="[('cad_cutlist_review_required', '=', True)]"/>
                <filter name="needs_scheduling"
                        string="Needs Scheduling"
                        domain="[('unscheduled_workorder_count', '&gt;', 0)]"/>
                <filter name="needs_crew"
                        string="Needs Crew"
                        domain="[('crew_gap', '=', True)]"/>
                <filter name="needs_materials"
                        string="Needs Materials"
                        domain="[('material_at_risk', '=', True)]"/>
                <filter name="equipment_blocked"
                        string="Equipment Blocked"
                        domain="[('equipment_blocked', '=', True)]"/>
                <filter name="over_capacity"
                        string="Over Capacity"
                        domain="[('workcenter_over_capacity', '=', True)]"/>
                <filter name="install_date_missing"
                        string="Install Date Missing"
                        domain="[('install_date_missing', '=', True)]"/>
                <filter name="late_at_risk"
                        string="Late / At Risk"
                        domain="[('job_at_risk', '=', True)]"/>
                <filter name="pm_stage_mismatch"
                        string="PM Stage Mismatch"
                        domain="[('pm_stage_mismatch', '=', True)]"/>
                <filter name="missing_cabinet_specs"
                        string="Missing Cabinet Specs"
                        domain="[('southbrook_specs_complete', '=', False)]"/>
                <separator/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter name="group_manufacturing_readiness"
                        string="Manufacturing Readiness"
                        context="{'group_by': 'manufacturing_readiness_state'}"/>
                <filter name="group_customer"
                        string="Customer"
                        context="{'group_by': 'customer_id'}"/>
                <filter name="group_source_order"
                        string="Source Sales Order"
                        context="{'group_by': 'source_order_id'}"/>
                <filter name="group_pm_phase"
                        string="PM Phase"
                        context="{'group_by': 'pm_phase'}"/>
                <filter name="group_door_style"
                        string="Door Style"
                        context="{'group_by': 'southbrook_door_style'}"/>
                <filter name="group_finish"
                        string="Finish"
                        context="{'group_by': 'southbrook_finish'}"/>
            </xpath>
        </field>
    </record>

    <!-- B3 (ideal): flag at-risk / ECO jobs on the Kanban card. -->
    <record id="project_task_kanban_mrp" model="ir.ui.view">
        <field name="name">project.task.kanban.southbrook.mrp</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//templates" position="before">
                <field name="job_at_risk"/>
                <field name="eco_pending_count"/>
                <field name="components_available"/>
                <field name="activity_ids"/>
                <field name="color"/>
                <field name="date_deadline"/>
                <field name="displayed_image_id"/>
                <field name="is_rotting"/>
                <field name="milestone_id"/>
                <field name="name"/>
                <field name="parent_id"/>
                <field name="partner_id"/>
                <field name="priority"/>
                <field name="project_id"/>
                <field name="rotting_days"/>
                <field name="tag_ids"/>
                <field name="task_properties"/>
                <field name="user_ids"/>
            </xpath>
            <xpath expr="//footer" position="inside">
                <span class="badge text-bg-danger ms-1" t-if="record.job_at_risk.raw_value"
                      title="At risk">At risk</span>
                <span class="badge text-bg-warning ms-1"
                      t-if="record.eco_pending_count.raw_value &gt; 0"
                      title="Pending ECO">ECO</span>
            </xpath>
        </field>
    </record>

    <record id="project_project_kanban_mission_control" model="ir.ui.view">
        <field name="name">project.project.kanban.southbrook.mission.control</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_kanban"/>
        <field name="active" eval="False"/>
        <field name="arch" type="xml">
            <xpath expr="//templates" position="before">
                <field name="southbrook_job_count"/>
                <field name="southbrook_active_mo_count"/>
                <field name="southbrook_ready_job_count"/>
                <field name="southbrook_at_risk_job_count"/>
                <field name="southbrook_material_risk_count"/>
                <field name="southbrook_unscheduled_wo_count"/>
                <field name="southbrook_crew_gap_count"/>
                <field name="southbrook_equipment_blocked_count"/>
                <field name="southbrook_over_capacity_count"/>
                <field name="southbrook_job_cost_total"/>
                <field name="southbrook_intelligence_prompt"/>
                <field name="southbrook_intelligence_severity"/>
            </xpath>
            <xpath expr="//footer" position="before">
                <div class="o_southbrook_project_mission mt-2"
                     t-if="record.southbrook_job_count.raw_value">
                    <div class="small fw-semibold mb-1">
                        <field name="southbrook_intelligence_prompt"/>
                    </div>
                    <div class="d-flex flex-wrap gap-1">
                        <span class="badge text-bg-success"
                              t-if="record.southbrook_ready_job_count.raw_value">
                            <field name="southbrook_ready_job_count"/> ready
                        </span>
                        <span class="badge text-bg-danger"
                              t-if="record.southbrook_at_risk_job_count.raw_value">
                            <field name="southbrook_at_risk_job_count"/> at risk
                        </span>
                        <span class="badge text-bg-danger"
                              t-if="record.southbrook_material_risk_count.raw_value">
                            <field name="southbrook_material_risk_count"/> material
                        </span>
                        <span class="badge text-bg-warning"
                              t-if="record.southbrook_unscheduled_wo_count.raw_value">
                            <field name="southbrook_unscheduled_wo_count"/> unscheduled WO
                        </span>
                        <span class="badge text-bg-warning"
                              t-if="record.southbrook_crew_gap_count.raw_value">
                            <field name="southbrook_crew_gap_count"/> crew gap
                        </span>
                        <span class="badge text-bg-danger"
                              t-if="record.southbrook_equipment_blocked_count.raw_value">
                            <field name="southbrook_equipment_blocked_count"/> equipment
                        </span>
                        <span class="badge text-bg-warning"
                              t-if="record.southbrook_over_capacity_count.raw_value">
                            <field name="southbrook_over_capacity_count"/> capacity
                        </span>
                    </div>
                    <a type="object"
                       name="action_southbrook_open_manufacturing_jobs"
                       class="btn btn-sm btn-outline-primary mt-2">
                        Open Production Board
                    </a>
                </div>
            </xpath>
        </field>
    </record>

    <record id="southbrook_project_readiness_line_list" model="ir.ui.view">
        <field name="name">southbrook.project.readiness.line.list</field>
        <field name="model">southbrook.project.readiness.line</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="task_id"/>
                <field name="sequence" optional="hide"/>
                <field name="name"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'ready'"
                       decoration-warning="status == 'review'"
                       decoration-danger="status == 'blocked'"
                       decoration-info="status == 'info'"/>
                <field name="severity" widget="badge"
                       decoration-danger="severity == 'blocker'"
                       decoration-warning="severity == 'warning'"
                       decoration-info="severity == 'info'"/>
                <field name="reason"/>
                <field name="evidence" optional="show"/>
                <field name="recommended_action" optional="show"/>
            </list>
        </field>
    </record>

    <record id="southbrook_project_readiness_line_form" model="ir.ui.view">
        <field name="name">southbrook.project.readiness.line.form</field>
        <field name="model">southbrook.project.readiness.line</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <field name="task_id"/>
                        <field name="project_id"/>
                        <field name="customer_id"/>
                        <field name="source_order_id"/>
                    </group>
                    <group>
                        <field name="check_key"/>
                        <field name="status" widget="badge"/>
                        <field name="severity" widget="badge"/>
                        <field name="reason"/>
                    </group>
                    <group>
                        <field name="evidence" widget="text"/>
                        <field name="recommended_action" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
