    <record id="job_template_full_kitchen" model="southbrook.project.job.template">
        <field name="name">Full Kitchen</field>
        <field name="sequence">10</field>
        <field name="job_type">full_kitchen</field>
        <field name="typical_cabinet_families">Base, Wall, Tall, Drawer, Sink Base, Corner, Accessory, Worktop</field>
        <field name="required_specs">Door style, material/species, finish, hardware, drawer slide, hinge, final measurement notes, CAD package, cutlist reference.</field>
        <field name="release_checklist">Final site measurements, CAD approved, cutlist approved, BoM verified, components available, WOs generated, WOs scheduled, crew reserved, equipment available, install due confirmed.</field>
    </record>
    <record id="job_template_full_kitchen_line_cad" model="southbrook.project.job.template.line">
        <field name="template_id" ref="job_template_full_kitchen"/>
        <field name="sequence">10</field>
        <field name="name">CAD / Cutlist Release</field>
    </record>
    <record id="job_template_full_kitchen_line_release" model="southbrook.project.job.template.line">
        <field name="template_id" ref="job_template_full_kitchen"/>
        <field name="sequence">20</field>
        <field name="name">Production Release Checklist</field>
    </record>
