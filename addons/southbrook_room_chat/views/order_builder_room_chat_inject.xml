<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Inject the RoomChatWidget mount point into the Order Builder portal
       page. Mirrors southbrook_hermes's order_builder_chat_inject.xml
       exactly (same inherit_id + xpath target) — OrderBuilder's own
       template is an inline owl `xml\`...\`` literal (no stable qweb
       name, not patchable), so a standalone panel injected at the
       server-template level, same as Hermes's own chat, is the
       established workaround for reaching this page at all. The mount
       is auto-discovered by this addon's OWL bundle's autoMount()
       routine and appears as its own panel alongside Hermes's chat,
       below the order header card. -->
  <!-- 2026-07-07 — DEACTIVATED. The Room Chat + preview widget was
       cluttering the sales-rep Order Builder workflow; it was relocated
       to the customer Kitchen Project detail page. Kept inactive (not
       deleted) so it's a one-flag revert if we ever want it back here.
       The new mount lives in
       southbrook_customer_portal/views/relocated_app_mounts.xml. -->
  <template id="room_chat_inject_order_builder"
            inherit_id="southbrook_estimating_website.portal_order_builder"
            name="Room Chat — Order Builder mount (deactivated 2026-07-07)"
            active="False">
    <!-- Body emptied 2026-07-07 — the mount div was relocated to the
         kitchen-project page (see customer_portal relocated_app_mounts.xml).
         Odoo preserves a view's `active` across upgrades, so flipping
         active=False alone does NOT remove an already-active inject on an
         existing DB; emptying the injected body (arch always updates on -u)
         is what actually clears it here. Kept as a no-op inherit for a
         trivial revert. -->
    <xpath expr="//div[hasclass('o_southbrook_portal_header')]" position="after">
      <t/>
    </xpath>
  </template>
</odoo>
