<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="product_configurator.BooleanButtonField" owl="1">
        <div t-ref="root">
            <!-- 2026-07-01 E2E audit — OWL tokenizer rejects `or`/`and`/`not`
                 word operators in expression attributes ([[owl_tokenizer_constraints]]);
                 use JS `||` instead. This XML compiles fine in current OWL
                 but is a latent tokenizer-regression trap. -->
            <CheckBox
                id="props.id"
                value="props.state || false"
                className="'d-inline-block me-2'"
                disabled="isReadonly"
            />
        </div>
    </t>

</templates>
