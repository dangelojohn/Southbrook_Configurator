<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
        W053 / R7.6 — 5-minute MI recompute sweep.

        MI status (x_mi_status, x_mi_blocker_count, ...) is normally
        stamped on event hooks (write hooks, FreeCAD ingest, deviation
        waiver approvals). Some upstream signals never round-trip back
        into the MO write path (a CAD-status flip on the cabinet,
        attachment-only changes, stock-move availability re-eval) so
        values drift stale.

        This cron sweeps every in-flight MO every 5 minutes and re-runs
        the recompute. The recompute is idempotent — when nothing
        changed, no write hits the DB (see _recompute_production's
        delta-filter in mi_engine.py).

        Inherits ir.actions.server in v19 — DO NOT add numbercall /
        doall fields, they are gone (per ~/.claude memory:
        odoo19_ir_cron_schema_change).
    -->
    <record id="cron_mi_recompute_sweep" model="ir.cron">
        <field name="name">Southbrook MI: sweep recompute (5 min)</field>
        <field name="model_id" ref="mrp.model_mrp_production"/>
        <field name="state">code</field>
        <field name="code">model._cron_mi_recompute_sweep()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
