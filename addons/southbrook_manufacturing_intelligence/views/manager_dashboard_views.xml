<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_southbrook_mi_check_list" model="ir.ui.view">
        <field name="name">southbrook.mi.check.list</field>
        <field name="model">southbrook.mi.check</field>
        <field name="arch" type="xml">
            <list string="Manufacturing Intelligence Checks"
                  decoration-danger="severity == 'blocker'"
                  decoration-warning="severity == 'warning'"
                  decoration-info="severity == 'info'">
                <field name="severity"/>
                <field name="category"/>
                <field name="name"/>
                <field name="production_package_id"/>
                <field name="production_id"/>
                <field name="message"/>
                <field name="recommendation"/>
                <!-- W001 — tiny thumbnail so supervisors can spot
                     photo-backed NCRs without opening each row. -->
                <field name="image" widget="image" options="{'size': [32, 32]}"/>
            </list>
        </field>
    </record>

    <!-- W001 — standalone form view so the inspector can open an NCR,
         see/capture the defect photo, and use chatter to attach more
         photos or @mention engineering. The embedded one2many inside
         the MO form still uses the implicit list view above; opening
         a row in that list now pops THIS form. -->
    <record id="view_southbrook_mi_check_form" model="ir.ui.view">
        <field name="name">southbrook.mi.check.form</field>
        <field name="model">southbrook.mi.check</field>
        <field name="arch" type="xml">
            <form string="Manufacturing Intelligence Check">
                <sheet>
                    <field name="image" widget="image"
                           class="oe_avatar"
                           options="{'preview_image': 'image'}"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Short title (e.g. 'Edge chip on door L')"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="severity" widget="badge"
                                   decoration-danger="severity == 'blocker'"
                                   decoration-warning="severity == 'warning'"
                                   decoration-info="severity == 'info'"/>
                            <field name="category"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="production_id"/>
                            <field name="production_package_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="findings" string="Findings">
                            <group>
                                <field name="message" placeholder="What did you see?" nolabel="1"/>
                            </group>
                            <group string="Recommendation">
                                <field name="recommendation" placeholder="What should happen next?" nolabel="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_southbrook_mi_check_search" model="ir.ui.view">
        <field name="name">southbrook.mi.check.search</field>
        <field name="model">southbrook.mi.check</field>
        <field name="arch" type="xml">
            <search string="Manufacturing Intelligence">
                <field name="name"/>
                <field name="severity"/>
                <field name="category"/>
                <filter name="blockers" string="Blockers" domain="[('severity','=','blocker')]"/>
                <filter name="warnings" string="Warnings" domain="[('severity','=','warning')]"/>
                <separator/>
                <filter name="category_cut" string="Cut" domain="[('category','=','cut')]"/>
                <filter name="category_production" string="Production" domain="[('category','=','production')]"/>
                <filter name="category_assembly" string="Assembly" domain="[('category','=','assembly')]"/>
                <filter name="category_install" string="Install" domain="[('category','=','install')]"/>
                <group>
                    <filter name="group_category" string="Category" context="{'group_by':'category'}"/>
                    <filter name="group_severity" string="Severity" context="{'group_by':'severity'}"/>
                    <filter name="group_package" string="Package" context="{'group_by':'production_package_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_southbrook_mi_package_list" model="ir.ui.view">
        <field name="name">sb.production.package.list.manufacturing.intelligence</field>
        <field name="model">sb.production.package</field>
        <field name="arch" type="xml">
            <list string="Production Packages - Manufacturing Intelligence"
                  decoration-danger="x_mi_status == 'blocked'"
                  decoration-warning="x_mi_status == 'review'"
                  decoration-success="x_mi_status == 'ok'">
                <field name="name"/>
                <field name="mo_id"/>
                <field name="state"/>
                <field name="x_mi_status"/>
                <field name="x_mi_blocker_count"/>
                <field name="x_mi_warning_count"/>
                <field name="x_mi_next_action"/>
            </list>
        </field>
    </record>

    <record id="action_southbrook_mi_checks" model="ir.actions.act_window">
        <field name="name">Manufacturing Intelligence Checks</field>
        <field name="res_model">southbrook.mi.check</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_southbrook_mi_check_search"/>
        <field name="context">{'search_default_blockers': 1, 'search_default_group_category': 1}</field>
    </record>

    <record id="action_southbrook_mi_packages" model="ir.actions.act_window">
        <field name="name">Production Intelligence Board</field>
        <field name="res_model">sb.production.package</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_southbrook_mi_package_list"/>
    </record>

    <!-- Wire the two actions into the PM dashboard menu (provided by
         southbrook_mrp_pm dep). Without these menuitems the actions
         existed but had no entry point — plant managers had to know the
         action xml_ids to reach the boards. -->
    <menuitem id="menu_southbrook_mi_checks"
              parent="southbrook_mrp_pm.menu_southbrook_pm_root"
              name="MI Checks"
              action="action_southbrook_mi_checks"
              sequence="10"/>

    <menuitem id="menu_southbrook_mi_packages"
              parent="southbrook_mrp_pm.menu_southbrook_pm_root"
              name="MI Production Board"
              action="action_southbrook_mi_packages"
              sequence="11"/>
</odoo>
