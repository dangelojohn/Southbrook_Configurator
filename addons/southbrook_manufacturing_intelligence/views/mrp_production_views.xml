<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mrp_production_form_mi" model="ir.ui.view">
        <field name="name">mrp.production.form.manufacturing.intelligence</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <!-- W012 — deviation-waiver smart button. Surfaced on the MO
                 form so a warranty tech 18 months out can answer
                 "did this cabinet ship with a known defect?" in 1 click.
                 div[@name='button_box'] is the standard Odoo MO header
                 smart-button container. -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_deviation_waivers"
                        type="object" class="oe_stat_button"
                        icon="fa-file-text-o"
                        invisible="deviation_waiver_count == 0"
                        groups="mrp.group_mrp_user">
                    <field name="deviation_waiver_count"
                           widget="statinfo"
                           string="Waivers"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="manufacturing_intelligence" string="Intelligence">
                    <button name="action_recompute_manufacturing_intelligence"
                            string="Recompute Intelligence"
                            type="object"
                            class="btn-primary"/>
                    <group>
                        <group>
                            <field name="x_mi_status"
                                   widget="badge"
                                   decoration-success="x_mi_status == 'ok'"
                                   decoration-warning="x_mi_status == 'review'"
                                   decoration-danger="x_mi_status == 'blocked'"/>
                            <!-- W025 — FAI status badge. Surfaces the gate
                                 state near the rest of the MI surface.
                                 Colored to match the action-required
                                 severity: pending/in_progress=warning,
                                 failed=danger, passed=success. -->
                            <field name="fai_status"
                                   widget="badge"
                                   decoration-success="fai_status == 'passed'"
                                   decoration-warning="fai_status in ('pending', 'in_progress')"
                                   decoration-danger="fai_status == 'failed'"
                                   invisible="fai_status == 'not_required'"/>
                            <field name="x_mi_next_action"/>
                            <!-- x_mi_bottleneck_workcenter_id is reserved
                                 for a future MI engine extension and is
                                 not written by _recompute_production yet;
                                 hidden until that lands so users don't
                                 see a perpetually empty field. -->
                        </group>
                        <group>
                            <field name="x_mi_blocker_count"/>
                            <field name="x_mi_warning_count"/>
                            <field name="x_mi_yield_pct"/>
                            <field name="x_mi_waste_area_m2"/>
                        </group>
                    </group>
                    <field name="x_mi_check_ids" readonly="1">
                        <list>
                            <field name="severity"/>
                            <field name="category"/>
                            <field name="name"/>
                            <field name="message"/>
                            <field name="recommendation"/>
                            <!-- W001 — inline thumbnail. Tap the row to open
                                 the standalone form (chatter + full image). -->
                            <field name="image" widget="image" options="{'size': [32, 32]}"/>
                            <!-- W024 — auto_fixable drives Fix-button
                                 visibility. Field is fetched (not optional)
                                 so the `invisible` clause has access. -->
                            <field name="auto_fixable" column_invisible="1"/>
                            <button name="action_auto_fix" type="object"
                                    string="Fix" class="btn-link"
                                    icon="fa-magic"
                                    invisible="not auto_fixable"
                                    help="Run the deterministic auto-fix for this
                                          check (W024). Idempotent: safe to click
                                          twice; MI recomputes after."/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
