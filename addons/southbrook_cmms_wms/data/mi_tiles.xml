<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
      Seed a single Maintenance & Logistics Snapshot record so the Snapshot menu
      (and the MI dashboard that reads southbrook.cmms.mi_tiles) render on
      install. The tile fields are computed on read from live MTBF/MTTR,
      breakdown, contract and picking data, so this one record is the whole
      snapshot. Without a seed the menu opened empty — and plain users have
      perm_create=0, so they could never populate it. noupdate so a rename
      survives upgrades.
    -->
    <data noupdate="1">
        <record id="mi_tiles_default" model="southbrook.cmms.mi_tiles">
            <field name="label">Maintenance &amp; Logistics Snapshot</field>
        </record>
    </data>
</odoo>
