<?xml version="1.0" encoding="utf-8"?>
<!--
  Daily 06:00 cron — sweeps service contracts and message_posts an alert
  to CMMS managers for any contract within its expiry_alert_at window.

  No `numbercall` / `doall` fields — they were removed from ir.cron in v19.
-->
<odoo>
    <data noupdate="1">

        <record id="cron_southbrook_cmms_service_contract_expiry"
                model="ir.cron">
            <field name="name">Southbrook CMMS: Service contract expiry sweep</field>
            <field name="model_id" ref="model_southbrook_cmms_service_contract"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_expiry()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

    </data>
</odoo>
