<odoo>

    <record id="view_os_switch_search" model="ir.ui.view">
        <field name="name">southbrook.os.switch.search</field>
        <field name="model">southbrook.os.switch</field>
        <field name="arch" type="xml">
            <search string="Kill Switches">
                <field name="key"/>
                <field name="name"/>
                <filter name="enabled" string="Enabled" domain="[('enabled', '=', True)]"/>
                <filter name="disabled" string="Disabled" domain="[('enabled', '=', False)]"/>
                <separator/>
                <group>
                    <filter name="gb_category" string="Category" context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_os_switch_list" model="ir.ui.view">
        <field name="name">southbrook.os.switch.list</field>
        <field name="model">southbrook.os.switch</field>
        <field name="arch" type="xml">
            <list string="Kill Switches">
                <field name="key"/>
                <field name="name"/>
                <field name="category"/>
                <field name="enabled" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_os_switch_form" model="ir.ui.view">
        <field name="name">southbrook.os.switch.form</field>
        <field name="model">southbrook.os.switch</field>
        <field name="arch" type="xml">
            <form string="Kill Switch">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="key"/>
                            <field name="category"/>
                            <field name="enabled"/>
                        </group>
                    </group>
                    <group string="Note">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_os_switch" model="ir.actions.act_window">
        <field name="name">Kill Switches</field>
        <field name="res_model">southbrook.os.switch</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No kill switches yet.</p>
            <p>Master and per-feature switches every AI/agent/integration surface gates itself on.</p>
        </field>
    </record>

</odoo>
