<odoo>

    <!-- Search: filters/group-by on STORED fields only. NO expand= on
         <group> in a search view; v19 RELAX-NG rejects it. -->
    <record id="view_os_ai_request_search" model="ir.ui.view">
        <field name="name">southbrook.os.ai.request.search</field>
        <field name="model">southbrook.os.ai.request</field>
        <field name="arch" type="xml">
            <search string="AI Requests">
                <field name="name"/>
                <field name="feature"/>
                <field name="provider"/>
                <field name="user_id"/>
                <filter name="state_done" string="Done" domain="[('state', '=', 'done')]"/>
                <filter name="state_error" string="Error" domain="[('state', '=', 'error')]"/>
                <filter name="state_blocked" string="Blocked" domain="[('state', '=', 'blocked')]"/>
                <separator/>
                <filter name="my_requests" string="My Requests" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <group>
                    <filter name="gb_feature" string="Feature" context="{'group_by': 'feature'}"/>
                    <filter name="gb_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="gb_create_date" string="Request Date" context="{'group_by': 'create_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- List: ledger rows are never hand-authored/edited inline. -->
    <record id="view_os_ai_request_list" model="ir.ui.view">
        <field name="name">southbrook.os.ai.request.list</field>
        <field name="model">southbrook.os.ai.request</field>
        <field name="arch" type="xml">
            <list string="AI Requests" create="0" edit="0"
                  decoration-danger="state=='error'"
                  decoration-warning="state=='blocked'"
                  decoration-success="state=='done'">
                <field name="name"/>
                <field name="feature"/>
                <field name="provider"/>
                <field name="model_name"/>
                <field name="state"/>
                <field name="user_id"/>
                <field name="tokens_prompt"/>
                <field name="tokens_completion"/>
                <field name="cost_usd"/>
                <field name="duration_ms"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_os_ai_request_form" model="ir.ui.view">
        <field name="name">southbrook.os.ai.request.form</field>
        <field name="model">southbrook.os.ai.request</field>
        <field name="arch" type="xml">
            <form string="AI Request" create="0" edit="0">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="feature"/>
                            <field name="provider"/>
                            <field name="model_name"/>
                            <field name="state"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="source_model"/>
                            <field name="source_res_id"/>
                            <field name="tokens_prompt"/>
                            <field name="tokens_completion"/>
                            <field name="cost_usd"/>
                            <field name="duration_ms"/>
                        </group>
                    </group>
                    <group string="Error" invisible="not error">
                        <field name="error" nolabel="1"/>
                    </group>
                    <group string="Prompt Preview">
                        <field name="prompt_preview" nolabel="1"/>
                    </group>
                    <group string="Response Preview">
                        <field name="response_preview" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_os_ai_request_pivot" model="ir.ui.view">
        <field name="name">southbrook.os.ai.request.pivot</field>
        <field name="model">southbrook.os.ai.request</field>
        <field name="arch" type="xml">
            <pivot string="AI Requests">
                <field name="feature" type="row"/>
                <field name="create_date" type="col" interval="day"/>
                <field name="cost_usd" type="measure"/>
                <field name="tokens_prompt" type="measure"/>
                <field name="tokens_completion" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_os_ai_request_graph" model="ir.ui.view">
        <field name="name">southbrook.os.ai.request.graph</field>
        <field name="model">southbrook.os.ai.request</field>
        <field name="arch" type="xml">
            <graph string="AI Requests">
                <field name="feature"/>
                <field name="cost_usd" type="measure"/>
                <field name="tokens_prompt" type="measure"/>
                <field name="tokens_completion" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_os_ai_request" model="ir.actions.act_window">
        <field name="name">AI Requests</field>
        <field name="res_model">southbrook.os.ai.request</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No AI requests logged yet.</p>
            <p>Every southbrook.os.ai.kernel.run() call is logged here, done, error, or blocked.</p>
        </field>
    </record>

</odoo>
