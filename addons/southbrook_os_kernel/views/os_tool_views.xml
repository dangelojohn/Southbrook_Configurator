<odoo>

    <record id="view_os_tool_search" model="ir.ui.view">
        <field name="name">southbrook.os.tool.search</field>
        <field name="model">southbrook.os.tool</field>
        <field name="arch" type="xml">
            <search string="Tools">
                <field name="name"/>
                <field name="code"/>
                <field name="path"/>
                <field name="module_name"/>
                <filter name="active_only" string="Active" domain="[('active', '=', True)]"/>
                <separator/>
                <group>
                    <filter name="gb_auth" string="Auth" context="{'group_by': 'auth'}"/>
                    <filter name="gb_module" string="Module" context="{'group_by': 'module_name'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_os_tool_list" model="ir.ui.view">
        <field name="name">southbrook.os.tool.list</field>
        <field name="model">southbrook.os.tool</field>
        <field name="arch" type="xml">
            <list string="Tools">
                <field name="code"/>
                <field name="name"/>
                <field name="http_method"/>
                <field name="path"/>
                <field name="module_name"/>
                <field name="auth"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_os_tool_form" model="ir.ui.view">
        <field name="name">southbrook.os.tool.form</field>
        <field name="model">southbrook.os.tool</field>
        <field name="arch" type="xml">
            <form string="Tool">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="http_method"/>
                            <field name="path"/>
                        </group>
                        <group>
                            <field name="module_name"/>
                            <field name="auth"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_os_tool" model="ir.actions.act_window">
        <field name="name">Tools</field>
        <field name="res_model">southbrook.os.tool</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active_only': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No tools registered yet.</p>
            <p>Callable HTTP surfaces (path, method, auth) for tool-calling consumers. See manifest().</p>
        </field>
    </record>

</odoo>
