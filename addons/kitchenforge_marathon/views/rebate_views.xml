<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_marathon_rebate_list" model="ir.ui.view">
        <field name="name">kitchenforge.marathon.rebate.list</field>
        <field name="model">kitchenforge.marathon.rebate</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="create_date"/>
                <field name="sale_order_id"/>
                <field name="cabinet_count"/>
                <field name="rate_per_cabinet_usd"/>
                <field name="amount_usd" sum="Total"/>
                <field name="period"/>
                <field name="reconciled"/>
            </list>
        </field>
    </record>

    <record id="action_marathon_rebate" model="ir.actions.act_window">
        <field name="name">Marathon Rebates</field>
        <field name="res_model">kitchenforge.marathon.rebate</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
