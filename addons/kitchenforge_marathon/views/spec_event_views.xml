<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_marathon_spec_event_list" model="ir.ui.view">
        <field name="name">kitchenforge.marathon.spec.event.list</field>
        <field name="model">kitchenforge.marathon.spec.event</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="create_date"/>
                <field name="product_id"/>
                <field name="qty"/>
                <field name="cabinet_family"/>
                <field name="pull_finish"/>
                <field name="pull_size_mm"/>
                <field name="sale_order_id"/>
                <field name="delivered_to_webhook"/>
            </list>
        </field>
    </record>

    <record id="action_marathon_spec_event" model="ir.actions.act_window">
        <field name="name">Marathon Spec Events</field>
        <field name="res_model">kitchenforge.marathon.spec.event</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
