<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- TEST page at /test (John, 2026-07-27) — publishes the OWL
       cabinet_3d_viewer public component on its own website page.
       Odoo 19's public root auto-mounts <owl-component> elements whose
       name is registered in registry.category("public_components")
       (cabinet_3d_viewer.js does exactly that). noupdate="0" so page
       tweaks land via -u. -->
  <data noupdate="0">

    <record id="view_test_cabinet_3d_page" model="ir.ui.view">
      <field name="name">Test — 3D Cabinet Viewer</field>
      <field name="type">qweb</field>
      <field name="key">cabinet_3d_viewer.test_cabinet_3d_page</field>
      <field name="arch" type="xml">
        <t t-name="cabinet_3d_viewer.test_cabinet_3d_page">
          <t t-call="website.layout">
            <div id="wrap" class="oe_structure">
              <section class="container py-4">
                <h1 class="mb-3">3D Cabinet Viewer — Test</h1>
                <owl-component name="cabinet_3d_viewer"/>
              </section>
            </div>
          </t>
        </t>
      </field>
    </record>

    <record id="page_test_cabinet_3d" model="website.page">
      <field name="name">3D Cabinet Viewer Test</field>
      <field name="url">/test</field>
      <field name="view_id" ref="view_test_cabinet_3d_page"/>
      <field name="is_published" eval="True"/>
      <field name="website_indexed" eval="False"/>
    </record>

  </data>
</odoo>
