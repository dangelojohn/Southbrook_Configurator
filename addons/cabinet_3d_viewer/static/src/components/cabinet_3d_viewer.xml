<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Render fix (2026-07-27, John: "renders incorrectly"): the
         original export used Tailwind utility classes (bg-slate-900,
         text-sky-400, rounded-xl, text-sm, ...) that do not exist in
         Odoo's Bootstrap — the dark background never applied while
         text-white DID, leaving white-on-white text. And the canvas
         host was h-100 inside a parent with only min-height, so its
         computed height was 0 and overflow-hidden CLIPPED the WebGL
         canvas invisible. Fixed with Bootstrap classes + explicit
         inline slate palette and a fixed-height canvas host. -->
    <t t-name="cabinet_3d_viewer.Cabinet3dViewerTemplate">
        <div class="s_cabinet_3d_viewer container-fluid py-4 text-white rounded-3 shadow my-3"
             style="background-color:#0f172a;">
            <div class="row align-items-center">
                <!-- 3D Canvas Container -->
                <div class="col-lg-8 position-relative">
                    <div t-ref="canvasContainer"
                         class="w-100 rounded-2 overflow-hidden"
                         style="height:500px; border:1px solid #334155; background-color:#f8fafc;"></div>
                    <t t-if="state.isLoading">
                        <div class="position-absolute top-50 start-50 translate-middle text-center">
                            <div class="spinner-border text-primary" role="status"></div>
                            <p class="mt-2 text-muted">Loading Interactive 3D Cabinet...</p>
                        </div>
                    </t>
                </div>

                <!-- Odoo Website Interactive Specification Panel -->
                <div class="col-lg-4 p-4">
                    <h3 class="fw-bold mb-2" style="color:#38bdf8;">24" 3-Drawer Base Cabinet</h3>
                    <p class="small mb-4" style="color:#94a3b8;">Interactive 3D Euro-Standard Cabinet Configurator powered by Odoo v19 CE &amp; OWL Component Architecture.</p>

                    <div class="card text-white p-3 mb-3"
                         style="background-color:#1e293b; border:1px solid #334155;">
                        <h6 class="text-uppercase small font-monospace mb-2" style="color:#94a3b8;">3D Cabinet Specifications</h6>
                        <ul class="list-unstyled mb-0 small">
                            <li class="d-flex justify-content-between py-1" style="border-bottom:1px solid #334155;">
                                <span>Width:</span> <strong style="color:#7dd3fc;"><t t-esc="state.width"/>"</strong>
                            </li>
                            <li class="d-flex justify-content-between py-1" style="border-bottom:1px solid #334155;">
                                <span>Height:</span> <strong style="color:#7dd3fc;"><t t-esc="state.height"/>"</strong>
                            </li>
                            <li class="d-flex justify-content-between py-1" style="border-bottom:1px solid #334155;">
                                <span>Depth:</span> <strong style="color:#7dd3fc;"><t t-esc="state.depth"/>"</strong>
                            </li>
                            <li class="d-flex justify-content-between py-1" style="border-bottom:1px solid #334155;">
                                <span>Countertop:</span> <strong style="color:#fcd34d;"><t t-esc="state.countertop"/></strong>
                            </li>
                            <li class="d-flex justify-content-between py-1">
                                <span>Standard:</span> <strong style="color:#34d399;">32mm Euro System</strong>
                            </li>
                        </ul>
                    </div>

                    <a href="/shop/cart" class="btn btn-primary btn-lg w-100 fw-bold shadow">
                        <i class="fa fa-shopping-cart me-2"></i> Add Custom Cabinet to Cart
                    </a>
                </div>
            </div>
        </div>
    </t>

</templates>
