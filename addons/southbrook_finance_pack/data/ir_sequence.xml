<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_southbrook_finance_asset" model="ir.sequence">
            <field name="name">Southbrook Finance Asset</field>
            <field name="code">southbrook.finance.asset</field>
            <field name="prefix">ASSET/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_southbrook_finance_hst_return" model="ir.sequence">
            <field name="name">Southbrook Finance HST Return</field>
            <field name="code">southbrook.finance.hst_return</field>
            <field name="prefix">HST/%(year)s/Q</field>
            <field name="padding">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_southbrook_finance_wip_report" model="ir.sequence">
            <field name="name">Southbrook Finance WIP Report</field>
            <field name="code">southbrook.finance.wip_report</field>
            <field name="prefix">WIP/%(year)s-%(month)s-%(day)s/</field>
            <field name="padding">2</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
