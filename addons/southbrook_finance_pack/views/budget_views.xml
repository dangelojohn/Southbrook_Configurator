<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_budget_list" model="ir.ui.view">
        <field name="name">southbrook.finance.budget.list</field>
        <field name="model">southbrook.finance.budget</field>
        <field name="arch" type="xml">
            <list string="Budgets">
                <field name="name"/>
                <field name="period_from"/>
                <field name="period_to"/>
                <field name="total_budget"/>
                <field name="total_actual"/>
                <field name="state"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_budget_form" model="ir.ui.view">
        <field name="name">southbrook.finance.budget.form</field>
        <field name="model">southbrook.finance.budget</field>
        <field name="arch" type="xml">
            <form string="Budget">
                <header>
                    <button name="action_activate" type="object"
                            string="Activate" invisible="state != 'draft'"
                            class="oe_highlight"/>
                    <button name="action_close" type="object"
                            string="Close" invisible="state != 'active'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="period_from"/>
                            <field name="period_to"/>
                        </group>
                        <group>
                            <field name="total_budget" readonly="1"/>
                            <field name="total_actual" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="account_id"/>
                                    <field name="period_month"/>
                                    <field name="budget_amount"/>
                                    <field name="actual_amount" readonly="1"/>
                                    <field name="variance" readonly="1"/>
                                    <field name="variance_pct" readonly="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_budget_line_pivot" model="ir.ui.view">
        <field name="name">southbrook.finance.budget_line.pivot</field>
        <field name="model">southbrook.finance.budget_line</field>
        <field name="arch" type="xml">
            <!-- actual_amount / variance are NON-STORED, search-based computes;
                 a pivot/graph measure must be stored (read_group cannot
                 aggregate a non-stored field) or opening this view raises.
                 Only budget_amount (stored) is a valid measure here. Actual vs
                 variance are shown per-line in the budget form's embedded
                 list, which renders non-stored computes fine. -->
            <pivot string="Budget by Account / Month">
                <field name="account_id" type="row"/>
                <field name="period_month" type="col"/>
                <field name="budget_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_budget" model="ir.actions.act_window">
        <field name="name">Budgets</field>
        <field name="res_model">southbrook.finance.budget</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_budget_line_pivot" model="ir.actions.act_window">
        <field name="name">Budget Pivot</field>
        <field name="res_model">southbrook.finance.budget_line</field>
        <field name="view_mode">pivot,list</field>
    </record>
</odoo>
