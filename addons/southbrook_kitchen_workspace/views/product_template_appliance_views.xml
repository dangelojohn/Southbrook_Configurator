<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Expose the kitchen-appliance metadata on the product.template
        form view as a dedicated tab. Tab + fields appear unconditionally
        so users can flag any existing product as an appliance template;
        the inner dimensional fields are gated readonly when the flag is
        off to make the cause-and-effect obvious.
    -->
    <record id="view_product_template_form_kitchen_appliance"
            model="ir.ui.view">
        <field name="name">product.template.form.kitchen.appliance</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Kitchen Appliance" name="kitchen_appliance">
                    <group>
                        <field name="is_kitchen_appliance"/>
                    </group>
                    <group invisible="not is_kitchen_appliance">
                        <group string="Classification">
                            <field name="kitchen_appliance_type"/>
                            <field name="kitchen_appliance_install_type"/>
                            <field name="kitchen_appliance_fuel_type"/>
                        </group>
                        <group string="Dimensions (mm)">
                            <field name="kitchen_appliance_width_mm"/>
                            <field name="kitchen_appliance_depth_mm"/>
                            <field name="kitchen_appliance_height_mm"/>
                            <field name="kitchen_appliance_clearance_mm"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!--
        Quick-pick list of all appliance templates for the designer's
        catalog browser action. Searchable by type / install / fuel.
    -->
    <record id="view_product_template_list_kitchen_appliance"
            model="ir.ui.view">
        <field name="name">product.template.list.kitchen.appliance</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list class="o_sb_kitchen_workspace_scroll"
                  string="Kitchen Appliance Catalog">
                <field name="default_code"/>
                <field name="name"/>
                <field name="kitchen_appliance_type"/>
                <field name="kitchen_appliance_install_type"/>
                <field name="kitchen_appliance_fuel_type"/>
                <field name="kitchen_appliance_width_mm" string="W (mm)"/>
                <field name="kitchen_appliance_depth_mm" string="D (mm)"/>
                <field name="kitchen_appliance_height_mm" string="H (mm)"/>
                <field name="kitchen_appliance_clearance_mm"
                       string="Clearance (mm)"/>
                <field name="list_price"/>
            </list>
        </field>
    </record>

    <record id="view_product_template_search_kitchen_appliance"
            model="ir.ui.view">
        <field name="name">product.template.search.kitchen.appliance</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <search string="Kitchen Appliance Catalog">
                <field name="name"/>
                <field name="default_code"/>
                <field name="kitchen_appliance_type"/>
                <filter string="Appliances"
                        name="filter_is_kitchen_appliance"
                        domain="[('is_kitchen_appliance', '=', True)]"/>
                <group expand="0">
                    <filter string="Type" name="group_type"
                            context="{'group_by': 'kitchen_appliance_type'}"/>
                    <filter string="Install Type" name="group_install"
                            context="{'group_by': 'kitchen_appliance_install_type'}"/>
                    <filter string="Fuel" name="group_fuel"
                            context="{'group_by': 'kitchen_appliance_fuel_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_kitchen_appliance_catalog"
            model="ir.actions.act_window">
        <field name="name">Kitchen Appliance Catalog</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id"
               ref="view_product_template_search_kitchen_appliance"/>
        <field name="view_id"
               ref="view_product_template_list_kitchen_appliance"/>
        <field name="domain">[('is_kitchen_appliance', '=', True)]</field>
        <field name="context">{'search_default_filter_is_kitchen_appliance': 1, 'default_is_kitchen_appliance': True}</field>
    </record>
</odoo>
