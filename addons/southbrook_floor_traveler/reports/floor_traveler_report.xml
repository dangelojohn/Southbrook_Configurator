<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!--
    P8 — Floor Traveler QWeb template.
    One page per sb.production.package. The QR encodes "sb-package:<id>"
    so external scanners drive the /southbrook/api/floor-traveler/scan
    endpoint.
  -->
  <template id="floor_traveler_document">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="package">
        <t t-call="web.external_layout">
          <div class="page">
            <h2>Floor Traveler — <span t-esc="package.name"/></h2>

            <div class="row mt-3">
              <div class="col-7">
                <table class="table table-sm">
                  <tr>
                    <th>Manufacturing Order</th>
                    <td t-esc="package.mo_id.name or '-'"/>
                  </tr>
                  <tr>
                    <th>Cutlist</th>
                    <td>
                      <span t-esc="package.cutlist_id.name or '-'"/>
                      <span t-if="package.cutlist_id">
                        (<t t-esc="package.cutlist_id.line_count"/> panels)
                      </span>
                    </td>
                  </tr>
                  <tr>
                    <th>Hardware Package</th>
                    <td>
                      <span t-esc="package.hardware_package_id.name or '-'"/>
                      <span t-if="package.hardware_package_id">
                        (<t t-esc="package.hardware_package_id.line_count"/> SKUs)
                      </span>
                    </td>
                  </tr>
                  <tr>
                    <th>Status</th>
                    <td t-esc="dict(package._fields['state'].selection).get(package.state)"/>
                  </tr>
                </table>
              </div>
              <div class="col-5 text-end">
                <t t-if="package.qr_image_base64">
                  <img
                    t-att-src="'data:image/png;base64,' + package.qr_image_base64"
                    style="width: 180px; height: 180px;"
                    alt="QR code"/>
                </t>
                <t t-else="">
                  <div style="border:1px solid #999; padding:1rem; width:180px; height:180px;">
                    <small>QR unavailable (qrcode lib not installed)</small>
                  </div>
                </t>
                <div class="mt-2">
                  <small><t t-esc="package.qr_payload"/></small>
                </div>
              </div>
            </div>

            <h4 class="mt-4">Cutlist</h4>
            <table class="table table-sm">
              <thead><tr>
                <th>Panel</th>
                <th class="text-end">Qty</th>
                <th class="text-end">Length (mm)</th>
                <th class="text-end">Width (mm)</th>
                <th>Substrate</th>
              </tr></thead>
              <tbody>
                <t t-foreach="package.cutlist_id.line_ids" t-as="line">
                  <tr>
                    <td t-esc="dict(line._fields['panel_name'].selection).get(line.panel_name)"/>
                    <td class="text-end" t-esc="line.qty"/>
                    <td class="text-end" t-esc="round(line.length_mm, 1)"/>
                    <td class="text-end" t-esc="round(line.width_mm, 1)"/>
                    <td t-esc="dict(line._fields['substrate'].selection).get(line.substrate) or ''"/>
                  </tr>
                </t>
              </tbody>
            </table>
          </div>
        </t>
      </t>
    </t>
  </template>
</odoo>
