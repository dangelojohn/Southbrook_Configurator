<!--
    MO form redesign for the expert MRP user — surfaces the high-value
    Southbrook fields on the header and adds a consolidated Cabinet
    Label tab alongside the existing notebook.

    All inherits target the BASE mrp.production form. Inheriting from
    sibling Southbrook addons (mrp_kitchen_workcenters / mi) would
    create a dependency loop because those addons depend transitively
    on southbrook_kitchen_mrp. The x_sbk_* and x_mi_* fields are
    written by their owning addons at runtime; the view validator
    accepts them because they ARE on mrp.production at view-load
    time.

    Five priority bands:

      priority 17 — Header context bar
                    Promotes Cabinet Code, Room/Zone, Install Due,
                    Deadline, Source SO, and the MI status badge from
                    deep-tab locations to the always-visible header.

      priority 18 — Tab renames for clarity
                    "Miscellaneous" → "Admin / Locations".

      priority 19 — Cabinet Label tab
                    NEW notebook page consolidating all the
                    sbk_label_* fields a floor operator needs to
                    verify what will print on the label, with the
                    Print button right there.

      priority 20 — MI inline on Availability tab
                    Adds an MI status section to the Availability tab
                    (where present in the merged form) so blockers
                    are visible alongside material availability.
                    This is a position="inside" on the availability
                    page; it is a no-op if that page is not present.
-->
<odoo>

    <!-- ====================================================== -->
    <!-- Priority 17 — Header context bar                       -->
    <!-- ====================================================== -->
    <record id="view_mrp_production_form_sbk_header_context" model="ir.ui.view">
        <field name="name">mrp.production.form.sbk_header_context</field>
        <field name="model">mrp.production</field>
        <field name="priority">17</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">

            <!-- Cabinet Code, Room/Zone, Install Due — after Responsible -->
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="x_sbk_cabinet_code"
                       readonly="state not in ('draft','confirmed','progress')"
                       placeholder="e.g. B3D24"/>
                <field name="x_sbk_kitchen_room"
                       readonly="state == 'done'"/>
                <field name="x_sbk_install_due_date"
                       widget="date"/>
            </xpath>

            <!-- Deadline + Source SO — after Start Date -->
            <xpath expr="//field[@name='date_start']" position="after">
                <field name="date_deadline"
                       widget="date"
                       decoration-danger="date_deadline and date_deadline &lt; context_today().strftime('%Y-%m-%d')"/>
                <field name="origin"
                       string="Source SO"
                       readonly="1"/>
            </xpath>

            <!-- MI status badge + blocker count — after Component Status -->
            <xpath expr="//field[@name='components_availability']" position="after">
                <field name="x_mi_status"
                       widget="badge"
                       decoration-danger="x_mi_status == 'blocked'"
                       decoration-warning="x_mi_status == 'warning'"
                       decoration-success="x_mi_status == 'ok'"
                       readonly="1"/>
                <field name="x_mi_blocker_count"
                       decoration-danger="x_mi_blocker_count &gt; 0"
                       readonly="1"/>
            </xpath>

        </field>
    </record>

    <!-- ====================================================== -->
    <!-- Priority 18 — Tab renames for clarity                  -->
    <!-- ====================================================== -->
    <record id="view_mrp_production_form_sbk_tab_renames" model="ir.ui.view">
        <field name="name">mrp.production.form.sbk_tab_renames</field>
        <field name="model">mrp.production</field>
        <field name="priority">18</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//page[@name='miscellaneous']" position="attributes">
                <attribute name="string">Admin / Locations</attribute>
            </xpath>

        </field>
    </record>

    <!-- ====================================================== -->
    <!-- Priority 19 — NEW Cabinet Label tab                    -->
    <!--                                                        -->
    <!-- One-stop view of every string that will print on the   -->
    <!-- Avery 9421 cabinet label, with the Print button right  -->
    <!-- there. Operator can verify the data without rendering  -->
    <!-- the PDF.                                                -->
    <!-- ====================================================== -->
    <record id="view_mrp_production_form_sbk_label_tab" model="ir.ui.view">
        <field name="name">mrp.production.form.sbk_label_tab</field>
        <field name="model">mrp.production</field>
        <field name="priority">19</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">
                <page string="Cabinet Label" name="sbk_label">
                    <group string="Label Data — what prints on the Avery 9421 sticker">
                        <group>
                            <field name="sbk_label_customer_name" readonly="1"/>
                            <field name="sbk_label_po_ref" readonly="1"/>
                            <field name="sbk_label_tag" readonly="1"/>
                            <field name="sbk_label_door_name" readonly="1"/>
                            <field name="sbk_label_door_color" readonly="1"/>
                        </group>
                        <group>
                            <field name="sbk_label_interior" readonly="1"/>
                            <field name="sbk_label_hinge" readonly="1"/>
                            <field name="sbk_label_fin" readonly="1"/>
                            <field name="sbk_label_code" readonly="1"/>
                            <field name="sbk_label_qr_url" readonly="1" widget="url"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_print_cabinet_label"
                                type="object"
                                string="🏷 Print Cabinet Label"
                                class="btn-primary"
                                groups="mrp.group_mrp_user"/>
                    </footer>
                </page>
            </xpath>

        </field>
    </record>

    <!-- ====================================================== -->
    <!-- Priority 20 — MI inline on Availability tab            -->
    <!--                                                        -->
    <!-- position="inside" the availability page IF the         -->
    <!-- availability page exists. Where mrp_sfc_availability_  -->
    <!-- check is not installed, this xpath silently no-ops     -->
    <!-- because page[@name='availability'] is absent.          -->
    <!-- ====================================================== -->
    <record id="view_mrp_production_form_sbk_mi_inline" model="ir.ui.view">
        <field name="name">mrp.production.form.sbk_mi_inline</field>
        <field name="model">mrp.production</field>
        <field name="priority">20</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//page[@name='availability']" position="inside">
                <separator string="Manufacturing Intelligence"/>
                <group>
                    <group>
                        <field name="x_mi_status" widget="badge"
                               decoration-danger="x_mi_status == 'blocked'"
                               decoration-warning="x_mi_status == 'warning'"
                               decoration-success="x_mi_status == 'ok'"
                               readonly="1"/>
                        <field name="x_mi_next_action" readonly="1"/>
                        <field name="x_mi_blocker_count"
                               decoration-danger="x_mi_blocker_count &gt; 0"
                               readonly="1"/>
                        <field name="x_mi_warning_count"
                               decoration-warning="x_mi_warning_count &gt; 0"
                               readonly="1"/>
                    </group>
                    <group>
                        <field name="x_mi_yield_pct" readonly="1"/>
                        <field name="x_mi_waste_area_m2" readonly="1"/>
                    </group>
                </group>
                <field name="x_mi_check_ids" readonly="1" nolabel="1">
                    <list decoration-danger="severity == 'blocked'"
                          decoration-warning="severity == 'warning'">
                        <field name="severity" widget="badge"
                               decoration-danger="severity == 'blocked'"
                               decoration-warning="severity == 'warning'"
                               decoration-success="severity == 'ok'"/>
                        <field name="category"/>
                        <field name="name"/>
                        <field name="message"/>
                        <field name="recommendation"/>
                    </list>
                </field>
            </xpath>

        </field>
    </record>

</odoo>
