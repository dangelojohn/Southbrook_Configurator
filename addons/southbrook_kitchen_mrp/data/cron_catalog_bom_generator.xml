<?xml version="1.0" encoding="utf-8"?>
<!--
  M4 — catalog-wide cabinet BoM generator. Nightly sweep that creates a
  real, non-empty mrp.bom for any southbrook_is_cabinet=True product
  template still missing one (fillers/accessories included). Idempotent
  and non-destructive by construction (see mrp_bom_catalog.py) — safe to
  run unattended and safe to "Run Manually" from Settings > Technical >
  Automation > Scheduled Actions.

  No `numbercall` / `doall` fields — removed from ir.cron in v19; ir.cron
  now inherits ir.actions.server (state="code" + code + interval_number/
  interval_type/active).
-->
<odoo>
    <data noupdate="1">

        <record id="cron_southbrook_catalog_bom_generator" model="ir.cron">
            <field name="name">Southbrook: Catalog-wide cabinet BoM generator (M4)</field>
            <field name="model_id" ref="mrp.model_mrp_bom"/>
            <field name="state">code</field>
            <field name="code">model._southbrook_generate_catalog_boms()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
        </record>

    </data>
</odoo>
