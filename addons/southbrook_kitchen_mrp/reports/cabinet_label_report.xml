<!--
    Cabinet Manufacturing Label — Avery Presta 94215 (3 × 4 in).

    Replaces the legacy paper label the shop has used by hand for
    years. Same layout as the user's sample photo:

      ┌──────────────────────────────────────────────────────┐
      │ SOUTHBROOK CABINETRY LOGO          [QR code square]   │
      │ www.southbrookcabinetry.com    905-761-9801          │
      ├──────────────────────────────────────────────────────┤
      │ Customer:  | JOHN DEANGELO                           │
      │ PO #:      |                                          │
      │ TAG:       | JOHN DEANGELO                           │
      │ Door Name: | NAPLES                                   │
      │ Door Color:| SNOW WHITE                               │
      │ Cabinet    | White: [X]    Maple: [ ]                │
      │  Interior  |                                          │
      ├──────────────────────────────────────────────────────┤
      │       Code       │  Hinge  │     Fin                  │
      │       B3D24      │   LH    │    B,L                   │
      └──────────────────────────────────────────────────────┘

    Page dimensions match Avery Presta 94215 landscape orientation
    (4 in wide × 3 in tall = 101.6 mm × 76.2 mm). Print on plain
    Avery 94215 label sheets — the printer aligns to the sheet's
    pre-cut bounds.

    Multi-MO selection on the list view: action_report calls render
    once per record and concatenates pages, so a batch of 12 cabinets
    yields a 12-page PDF that fills two Avery sheets at 6 labels/sheet.
-->
<odoo>

    <record id="paperformat_avery_presta_94215" model="report.paperformat">
        <field name="name">Avery Presta 94215 (2-up row, 8x3 in)</field>
        <field name="format">custom</field>
        <!-- 2 identical labels per MO, printed side-by-side. Page is
             one row of an Avery 94215 sheet: 2 columns × 3 in tall
             = 8 in × 3 in (204 × 76 mm). v19 paperformat fields are
             integer mm; the 0.4 mm clip on width is within label
             tolerance. -->
        <field name="page_height">76</field>       <!-- 3 in -->
        <field name="page_width">204</field>       <!-- 8 in (2 × 4 in cells) -->
        <field name="orientation">Landscape</field>
        <field name="margin_top">2</field>
        <field name="margin_bottom">2</field>
        <field name="margin_left">2</field>
        <field name="margin_right">2</field>
        <field name="header_line">0</field>
        <field name="header_spacing">0</field>
        <field name="dpi">300</field>
    </record>

    <record id="action_report_cabinet_label" model="ir.actions.report">
        <field name="name">Cabinet Label (Avery 94215)</field>
        <field name="model">mrp.production</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">southbrook_kitchen_mrp.report_cabinet_label</field>
        <field name="report_file">southbrook_kitchen_mrp.report_cabinet_label</field>
        <field name="paperformat_id" ref="paperformat_avery_presta_94215"/>
        <field name="binding_model_id" ref="mrp.model_mrp_production"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Cabinet Label %s' % (object.name)</field>
    </record>

    <!--
        Main report — one page per MO. Each page is a row of two
        identical labels, side-by-side, matching one row of an
        Avery 94215 sheet (2 columns × 3 rows = 6 labels per sheet).
        The shop floor uses two: one stuck to the cabinet itself,
        one stapled to the shop traveller.
    -->
    <template id="report_cabinet_label">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="mo">
                <div class="page sbk-label-page">
                    <style>
                        /* 2-up row layout — page is 204 × 76 mm
                           (8 in × 3 in landscape), each label is
                           96 × 72 mm with a 4 mm gutter between them. */
                        .sbk-label-page {
                            font-family: Arial, sans-serif;
                            color: #000;
                            width: 200mm;
                            height: 72mm;
                            display: flex;
                            gap: 4mm;
                            box-sizing: border-box;
                            padding: 0;
                            margin: 0;
                        }
                        .sbk-label {
                            color: #000;
                            width: 96mm;
                            height: 72mm;
                            box-sizing: border-box;
                            padding: 2mm;
                            font-size: 9pt;
                            line-height: 1.15;
                            flex-shrink: 0;
                        }
                        .sbk-label-header {
                            display: flex;
                            justify-content: space-between;
                            align-items: flex-start;
                            border-bottom: 1px solid #000;
                            padding-bottom: 2mm;
                            margin-bottom: 2mm;
                        }
                        .sbk-label-brand {
                            flex: 1;
                            display: flex;
                            flex-direction: column;
                            justify-content: space-between;
                            padding-right: 3mm;
                        }
                        .sbk-label-brand img {
                            width: 48mm;
                            max-height: 14mm;
                            object-fit: contain;
                            display: block;
                        }
                        .sbk-label-contact {
                            font-size: 7pt;
                            margin-top: 1.5mm;
                            display: flex;
                            justify-content: space-between;
                            font-weight: 600;
                        }
                        .sbk-label-qr {
                            width: 22mm;
                            height: 22mm;
                            margin-left: 2mm;
                        }
                        .sbk-label-qr img {
                            width: 100%;
                            height: 100%;
                            display: block;
                        }
                        .sbk-label-grid {
                            border: 1px solid #000;
                            border-collapse: collapse;
                            width: 100%;
                            font-size: 8.5pt;
                        }
                        .sbk-label-grid td {
                            border: 1px solid #000;
                            padding: 1mm 2mm;
                            vertical-align: middle;
                        }
                        .sbk-label-grid .sbk-label-key {
                            font-weight: 700;
                            width: 28%;
                            background: #f0f0f0;
                        }
                        .sbk-label-grid .sbk-label-val {
                            font-weight: 700;
                            font-size: 9pt;
                        }
                        .sbk-label-footer {
                            margin-top: 1mm;
                            border: 1px solid #000;
                            border-collapse: collapse;
                            width: 100%;
                            font-size: 8.5pt;
                            text-align: center;
                        }
                        .sbk-label-footer td {
                            border: 1px solid #000;
                            padding: 1mm;
                            vertical-align: top;
                        }
                        .sbk-label-footer-h {
                            font-weight: 700;
                            background: #f0f0f0;
                        }
                        .sbk-label-code {
                            font-size: 13pt;
                            font-weight: 900;
                            letter-spacing: 1px;
                        }
                        .sbk-checkbox {
                            display: inline-block;
                            width: 9pt;
                            height: 9pt;
                            border: 1px solid #000;
                            text-align: center;
                            font-weight: 900;
                            line-height: 8pt;
                            margin: 0 1mm;
                            font-size: 8pt;
                        }
                    </style>

                    <!-- Render the same single-label markup twice
                         side-by-side so the operator gets 2 identical
                         labels per MO (one for the cabinet, one for
                         the shop traveller). t-call passes `mo` into
                         the inner template via the surrounding scope. -->
                    <div class="sbk-label">
                        <t t-call="southbrook_kitchen_mrp.report_cabinet_label_one"/>
                    </div>
                    <div class="sbk-label">
                        <t t-call="southbrook_kitchen_mrp.report_cabinet_label_one"/>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <!--
        Single-label inner template — the actual label markup.
        Called twice from the main report. Expects `mo` in scope
        (the calling foreach loop binds it).
    -->
    <template id="report_cabinet_label_one">
        <!-- Brand header + QR -->
        <div class="sbk-label-header">
            <div class="sbk-label-brand">
                <img src="/southbrook_kitchen_mrp/static/src/img/sb_label_logo.png"
                     alt="Southbrook Cabinetry"/>
                <div class="sbk-label-contact">
                    <span>www.southbrookcabinetry.com</span>
                    <span>905-761-9801</span>
                </div>
            </div>
            <div class="sbk-label-qr">
                <img t-if="mo.sbk_label_qr_image"
                     t-att-src="'data:image/png;base64,%s' % mo.sbk_label_qr_image.decode('ascii')"
                     alt="QR code"/>
            </div>
        </div>

        <!-- Body grid -->
        <table class="sbk-label-grid">
            <tr>
                <td class="sbk-label-key">Customer</td>
                <td class="sbk-label-val" colspan="3" t-out="mo.sbk_label_customer_name"/>
            </tr>
            <tr>
                <td class="sbk-label-key">PO #</td>
                <td class="sbk-label-val" colspan="3" t-out="mo.sbk_label_po_ref"/>
            </tr>
            <tr>
                <td class="sbk-label-key">TAG</td>
                <td class="sbk-label-val" colspan="3" t-out="mo.sbk_label_tag"/>
            </tr>
            <tr>
                <td class="sbk-label-key">Door Name</td>
                <td class="sbk-label-val" colspan="3" t-out="mo.sbk_label_door_name"/>
            </tr>
            <tr>
                <td class="sbk-label-key">Door Color</td>
                <td class="sbk-label-val" colspan="3" t-out="mo.sbk_label_door_color"/>
            </tr>
            <tr>
                <td class="sbk-label-key" rowspan="1">Cabinet Interior</td>
                <td colspan="3" style="font-weight:700">
                    White:
                    <span class="sbk-checkbox">
                        <t t-if="mo.sbk_label_interior_is_white">X</t>
                    </span>
                    Maple:
                    <span class="sbk-checkbox">
                        <t t-if="mo.sbk_label_interior_is_maple">X</t>
                    </span>
                    <t t-if="mo.sbk_label_interior and not mo.sbk_label_interior_is_white and not mo.sbk_label_interior_is_maple">
                        &#160;—&#160;<span t-out="mo.sbk_label_interior"/>
                    </t>
                </td>
            </tr>
        </table>

        <!-- Footer grid: Code / Hinge / Fin -->
        <table class="sbk-label-footer">
            <tr>
                <td class="sbk-label-footer-h" style="width:54%">Code</td>
                <td class="sbk-label-footer-h" style="width:23%">Hinge</td>
                <td class="sbk-label-footer-h" style="width:23%">Fin</td>
            </tr>
            <tr>
                <td class="sbk-label-code" t-out="mo.sbk_label_code"/>
                <td class="sbk-label-code" t-out="mo.sbk_label_hinge"/>
                <td class="sbk-label-code" t-out="mo.sbk_label_fin"/>
            </tr>
        </table>
    </template>

    <!-- Smart button on the MO form -->
    <record id="view_mrp_production_form_sbk_label" model="ir.ui.view">
        <field name="name">mrp.production.form.sbk_label_btn</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_print_cabinet_label"
                        type="object"
                        string="🏷 Print Cabinet Label"
                        groups="mrp.group_mrp_user"/>
            </xpath>
        </field>
    </record>

</odoo>
