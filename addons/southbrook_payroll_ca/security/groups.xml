<?xml version="1.0" encoding="utf-8"?>
<!--
  Southbrook Payroll groups.

  v19 dropped res.groups.category_id; we set name + implied_ids only.
  v19 renamed res.users.groups_id -> group_ids (n/a here, no admin
  bootstrap in this file).
-->
<odoo>
    <data noupdate="1">
        <record id="group_southbrook_payroll_user" model="res.groups">
            <field name="name">Southbrook Payroll / User</field>
            <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
            <field name="comment">Read payroll runs, payslips, T4 previews, ROEs, certifications.</field>
        </record>

        <record id="group_southbrook_payroll_manager" model="res.groups">
            <field name="name">Southbrook Payroll / Manager</field>
            <field name="implied_ids" eval="[(4, ref('southbrook_payroll_ca.group_southbrook_payroll_user')), (4, ref('hr.group_hr_manager')), (4, ref('account.group_account_user'))]"/>
            <field name="comment">Full payroll access including computing runs, posting journal entries, and editing tax bracket master data.</field>
        </record>
    </data>
</odoo>
