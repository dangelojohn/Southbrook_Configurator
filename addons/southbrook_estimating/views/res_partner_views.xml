<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!--
    Minimum-to-be-visible view extension for res.partner: surface the
    channel + tradesperson_tier fields in the Sales tab of the partner
    form. No other view work in this commit — the Order Builder views
    arrive in commit 9 per the §10 step 7 plan.
  -->
  <record id="view_partner_form_southbrook" model="ir.ui.view">
    <field name="name">res.partner.form.southbrook</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
      <xpath expr="//page[@name='sales_purchases']" position="inside">
        <group string="Southbrook Channel" name="southbrook_channel">
          <field name="channel"/>
          <field name="tradesperson_tier"
                 invisible="channel != 'tradesperson'"/>
          <!-- Pipeline stage — computed from this customer's orders.
               Read-only: it reflects order state, not a manual pick.
               Property type is set with Contact Tags (top of the form). -->
          <field name="southbrook_pipeline_stage"/>
        </group>
      </xpath>
    </field>
  </record>

  <!-- Contacts search: group-by + quick filters for Pipeline Stage.
       (Property type is classified with Contact Tags, which Odoo already
       exposes as a native group-by/filter in this same search view.) -->
  <record id="view_res_partner_filter_southbrook" model="ir.ui.view">
    <field name="name">res.partner.search.southbrook</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_res_partner_filter"/>
    <field name="arch" type="xml">
      <xpath expr="//search" position="inside">
        <separator/>
        <filter name="sb_stage_active_job" string="Active Job"
                domain="[('southbrook_pipeline_stage','=','active_job')]"/>
        <filter name="sb_stage_proposal" string="Proposal"
                domain="[('southbrook_pipeline_stage','=','proposal')]"/>
        <filter name="sb_stage_quote" string="Quote"
                domain="[('southbrook_pipeline_stage','=','quote')]"/>
        <filter name="sb_stage_prospect" string="Prospect"
                domain="[('southbrook_pipeline_stage','=','prospect')]"/>
        <filter name="sb_group_pipeline_stage" string="Pipeline Stage"
                context="{'group_by': 'southbrook_pipeline_stage'}"/>
      </xpath>
    </field>
  </record>
</odoo>
