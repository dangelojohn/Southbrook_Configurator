<odoo>

    <record id="view_builder_po_intake_list" model="ir.ui.view">
        <field name="name">southbrook.builder.po.intake.list</field>
        <field name="model">southbrook.builder.po.intake</field>
        <field name="arch" type="xml">
            <list string="Builder PO Intake"
                  decoration-muted="state == 'cancelled'"
                  decoration-info="state == 'draft'"
                  decoration-warning="state in ('parsed','error')"
                  decoration-success="state == 'applied'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="customer_po_number"/>
                <field name="intake_method"/>
                <field name="line_count"/>
                <field name="error_line_count"/>
                <field name="sale_order_id" optional="show"/>
                <field name="state" widget="badge"/>
                <field name="create_date" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_builder_po_intake_form" model="ir.ui.view">
        <field name="name">southbrook.builder.po.intake.form</field>
        <field name="model">southbrook.builder.po.intake</field>
        <field name="arch" type="xml">
            <form string="Builder PO Intake">
                <header>
                    <button name="action_parse" type="object"
                            string="Parse" class="oe_highlight"
                            invisible="state not in ('draft','error')"/>
                    <button name="action_apply" type="object"
                            string="Apply → Create SO" class="oe_highlight"
                            invisible="state != 'parsed' or error_line_count > 0"/>
                    <button name="action_cancel" type="object"
                            string="Cancel"
                            invisible="state in ('applied','cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,parsed,applied"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Applied" bg_color="text-bg-success"
                            invisible="state != 'applied'"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" options="{'no_create': True}"
                                   readonly="state not in ('draft','parsed','error')"/>
                            <field name="customer_po_number"
                                   readonly="state not in ('draft','parsed','error')"/>
                            <field name="intake_method"
                                   readonly="state not in ('draft')"/>
                        </group>
                        <group>
                            <field name="line_count" readonly="1"/>
                            <field name="error_line_count" readonly="1"
                                   decoration-danger="error_line_count > 0"/>
                            <field name="sale_order_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="CSV File"
                           invisible="intake_method != 'csv'">
                        <field name="file_data" filename="file_name"
                               readonly="state == 'applied'"/>
                        <field name="file_name" invisible="1"/>
                    </group>
                    <group string="Raw Payload (JSON)"
                           invisible="intake_method not in ('json','api','edi_850')">
                        <field name="raw_payload" nolabel="1"
                               readonly="state == 'applied'"
                               placeholder='[{"unit_number": "M-4521", "cabinet_code": "B30", "qty": 1, "due_date": "2026-08-01", "notes": ""}]'/>
                    </group>
                    <notebook>
                        <page string="Parsed Lines" name="lines">
                            <field name="line_ids"
                                   readonly="state in ('applied','cancelled')">
                                <list editable="bottom"
                                      decoration-danger="error_message">
                                    <field name="sequence" widget="handle"/>
                                    <field name="unit_number"/>
                                    <field name="cabinet_code"/>
                                    <field name="qty"/>
                                    <field name="due_date"/>
                                    <field name="notes"/>
                                    <field name="product_id" readonly="1"/>
                                    <field name="error_message" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_builder_po_intake" model="ir.actions.act_window">
        <field name="name">Builder PO Intake</field>
        <field name="res_model">southbrook.builder.po.intake</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No builder POs yet.
            </p>
            <p>
                Mattamy / Great Gulf / Brookfield builder POs land here.
                v1: upload CSV with columns <em>unit_number, cabinet_code,
                qty, due_date, notes</em>. Parse → review → Apply
                creates a draft sale.order. EDI 850 middleware lands in
                Phase 4 — this model already carries the envelope shape.
            </p>
        </field>
    </record>

    <menuitem id="menu_sb_estimating_builder_po"
              name="Builder PO Intake"
              parent="sale.menu_sale_quotations"
              action="action_builder_po_intake"
              sequence="50"/>

</odoo>
