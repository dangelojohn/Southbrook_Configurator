<?xml version="1.0" encoding="utf-8"?>
<!--
  Southbrook BoM line Configuration Sets.

  These records populate Product Configurator -> Configuration -> Configuration
  Sets with reusable manufacturing conditions for BoM lines. They intentionally
  do NOT attach themselves to BoM lines yet: automatic attachment would change
  BoM explosion behavior. Production should link these sets to specific
  component lines after confirming which materials/hardware are conditional.

  Child configuration rows are separate XML records instead of one2many create
  commands so repeated module updates do not duplicate configuration rows.
-->
<odoo noupdate="0">

  <!-- Series gates -->
  <record id="config_set_series_contractor" model="mrp.bom.line.configuration.set">
    <field name="name">SBK - Series - Contractor</field>
  </record>
  <record id="config_series_contractor" model="mrp.bom.line.configuration">
    <field name="config_set_id" ref="config_set_series_contractor"/>
    <field name="value_ids" eval="[(6, 0, [ref('value_series_contractor')])]"/>
  </record>

