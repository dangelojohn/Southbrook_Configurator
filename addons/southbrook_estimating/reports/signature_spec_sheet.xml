<?xml version="1.0" encoding="utf-8"?>
<!--
  Signature Spec Sheet — customer-facing PDF, bound to sale.order.

  Per Build Spec section 4 routine #6. The customer's deliverable when they
  hit "Request a Price" — Signature Series styled summary of the configured
  kitchen with cabinet list, totals, and lead time.

  Visual target: docs/southbrook_book_templates.pdf (when #7 lands).

  19.0.4.5.0 (2026-06-23) — captured John's live-DB invoice improvements
  back into git. Two-page → one-page; table-based layout (wkhtmltopdf
  flexbox is broken in the Odoo-bundled ancient WebKit); dedicated
  paperformat (Southbrook Invoice A4 — 28/16/7/7 mm margins) so the
  default A4's 52mm top + 52mm header_spacing don't blow out a second
  page; scoped border reset on .sb-layout-table because the global
  southbrook_report_styles rule forces borders on every td.

  The body-band logo from 19.0.4.4.0 was removed: the standard external
  layout already renders it once in the page header, so showing it again
  in the body was a duplicate that ate vertical space.

  19.0.4.4.0 (earlier) — initial INVOICE-band concept with flexbox; did
  not survive contact with wkhtmltopdf (collapsed/stacked in PDF). See
  memory note southbrook_spec_sheet_invoice_v19_4_4_0.md for the gotcha
  catalog (QWeb safe_eval excludes base64, barcode() returns raw PNG
  bytes, /report/barcode controller URL is the only working QR path).
-->
<odoo>

  <!-- Customer-facing spec sheet -->
  <template id="report_signature_spec_sheet_doc"
            name="Signature Spec Sheet Document">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="o">
        <!-- Helper variables. Defined before t-call so they flow into
             the external_layout's body content via QWeb scope. -->
        <t t-set="company" t-value="o.company_id or env.company"/>
        <t t-set="web_logo" t-value="env['website'].sudo().search([], limit=1).logo"/>
        <t t-set="base_url" t-value="env['ir.config_parameter'].sudo().get_param('web.base.url')"/>
        <t t-set="page_url" t-value="base_url + '/my/southbrook/order-builder/' + str(o.id)"/>
        <t t-call="web.external_layout">
          <t t-call="southbrook_estimating.southbrook_report_styles"/>
          <div class="page southbrook-report">
            <!-- Scoped border reset for layout tables. The global
                 .southbrook-report table rule in southbrook_report_styles
                 forces border+padding+background on every td — fine for
                 the Cabinets table, ugly for the layout/meta tables.
                 Descendant selectors only (not `>`) — wkhtmltopdf's old
                 WebKit handles child combinators poorly. -->
            <style>
              .southbrook-report .sb-layout-table,
              .southbrook-report .sb-layout-table td,
              .southbrook-report .sb-layout-table tr,
              .southbrook-report .sb-layout-table th,
              .southbrook-report .sb-meta-table,
              .southbrook-report .sb-meta-table td,
              .southbrook-report .sb-meta-table tr,
              .southbrook-report .sb-meta-table th {
                border: 0 !important;
                border-collapse: collapse !important;
                background: transparent !important;
                background-color: transparent !important;
                box-shadow: none !important;
              }
            </style>

            <div class="sb-illustrative-banner"
                 t-if="env['ir.config_parameter'].sudo().get_param('southbrook.seed_mode') == 'illustrative'">
              ILLUSTRATIVE SEED — demo numbers, not production data.
            </div>

            <!-- Title strip: "Your Southbrook Kitchen / Signature Spec Sheet"
                 left, "INVOICE" right. Table layout (NOT flexbox — flexbox
                 collapses in wkhtmltopdf). -->
            <table class="sb-layout-table" style="width:100%;border-collapse:collapse;border:none;margin-bottom:4px;">
              <tr>
                <td style="border:none;vertical-align:top;padding:0;">
                  <div style="font-size:24px;font-weight:bold;color:#3d3d3d;line-height:1.1;">Your Southbrook Kitchen</div>
                  <div style="font-size:14px;color:#8a8a8a;margin-top:2px;">Signature Spec Sheet</div>
                </td>
                <td style="border:none;vertical-align:top;padding:0;text-align:right;white-space:nowrap;">
                  <div style="font-size:22px;font-weight:bold;letter-spacing:2px;color:#6e5b4f;text-transform:uppercase;">Invoice</div>
                </td>
              </tr>
            </table>
            <hr class="sb-rule" style="margin:6px 0 12px 0;border:0;border-top:2px solid #6e5b4f;"/>

            <!-- Two-column meta: customer (left) · meta values + QR (right).
                 Right-cell meta is stacked DIVs, NOT a nested table, so the
                 global td-border rule has nothing to grab onto. -->
            <table class="sb-layout-table" style="width:100%;border-collapse:collapse;border:none;margin-bottom:6px;">
              <tr>
                <td style="border:none;vertical-align:top;padding:0;">
                  <div style="font-size:11px;text-transform:uppercase;letter-spacing:1px;color:#777;margin-bottom:3px;">Prepared For</div>
                  <div style="font-size:13px;line-height:1.7;"><strong>Customer:</strong> <span t-out="o.partner_id.name"/></div>
                  <div style="font-size:13px;line-height:1.7;"><strong>Reference:</strong> <span t-out="o.name"/> <span class="sb-muted">(v<span t-out="o.version"/>)</span></div>
                  <div style="font-size:13px;line-height:1.7;"><strong>Quote Date:</strong> <span t-out="o.date_order" t-options="{'widget': 'date'}"/></div>
                </td>
                <td style="border:none;vertical-align:top;padding:0;text-align:right;width:230px;">
                  <div style="text-align:right;font-size:11px;line-height:1.7;margin-bottom:10px;">
                    <div><span style="color:#777;">Reference&#160;&#160;</span><strong><span t-out="o.name"/></strong></div>
                    <div><span style="color:#777;">Version&#160;&#160;</span><span t-out="o.version"/></div>
                    <div><span style="color:#777;">Date&#160;&#160;</span><span t-out="o.date_order" t-options="{'widget': 'date'}"/></div>
                  </div>
                  <div class="sb-qr" style="text-align:right;">
                    <!-- QR via /report/barcode controller URL — see gotcha
                         catalog in memory/southbrook_spec_sheet_invoice_v19_4_4_0.md
                         for why this is the only form that works (NOT base64). -->
                    <t t-set="qr_url" t-value="'/report/barcode/?barcode_type=QR&amp;value=' + page_url + '&amp;width=240&amp;height=240'"/>
                    <img t-att-src="qr_url"
                         style="width:92px;height:92px;border:1px solid #e2dcd4;padding:4px;background:#fff;display:inline-block;"
                         alt="Scan to view online"/>
                    <div style="font-size:8px;color:#999;margin-top:2px;letter-spacing:.5px;">SCAN TO VIEW ONLINE</div>
                  </div>
                </td>
              </tr>
            </table>

            <hr class="sb-rule" style="margin:4px 0 12px 0;"/>

            <!-- Cabinets table — KEEPS the global td-border styling (no
                 sb-layout-table class on this one). -->
            <h2>Cabinets</h2>
            <table>
              <thead>
                <tr>
                  <th>Zone</th>
                  <th>Cabinet</th>
                  <th>Qty</th>
                  <th>Unit Price</th>
                  <th>Line Total</th>
                </tr>
              </thead>
              <tbody>
                <tr t-foreach="o.order_line" t-as="line">
                  <td>
                    <span t-out="dict(line._fields['zone'].selection).get(line.zone, '—')"/>
                    <span t-if="line.zone_label">
                      / <span t-out="line.zone_label"/>
                    </span>
                  </td>
                  <td t-out="line.product_id.display_name or line.name"/>
                  <td t-out="line.product_uom_qty"/>
                  <td t-out="line.price_unit"
                      t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                  <td t-out="line.price_subtotal"
                      t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                </tr>
              </tbody>
              <tfoot>
                <tr class="sb-total-row">
                  <td colspan="4">Total</td>
                  <td t-out="o.amount_total"
                      t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                </tr>
              </tfoot>
            </table>

            <p class="sb-muted">
              This spec sheet was generated by the Southbrook Estimating
              Application. The cabinet specifications and pricing reflect
              your configuration at the time of generation. Real
              manufacturing lead times and any adjustments will be
              confirmed by your assigned dealer.
            </p>
            <div class="sb-invoice-footer"
                 style="margin-top:24px;border-top:1px solid #ddd;padding-top:10px;text-align:center;font-size:10px;color:#999;">
              Southbrook Cabinetry &#160;·&#160; info@southbrookcabinetry.space &#160;·&#160; southbrookcabinetry.space
            </div>

          </div>

          <!--
            Phase 5 — Room Summary page (conditional on doc.room_ids).
            Renders only when the order has at least one room declared.
            Existing single-page orders without rooms render unchanged.
          -->
          <div class="page" t-if="o.room_ids">
            <t t-set="room" t-value="o.room_ids[0]"/>
            <t t-set="summary" t-value="room.to_summary_dict()"/>
            <h2 class="report_h2" style="margin: 0 0 12px 0;">
              Kitchen Room — <t t-esc="summary['name']"/>
            </h2>
            <table class="sb-meta-table" style="width:100%; border-collapse:collapse; font-size: 9pt;">
              <tr>
                <th style="text-align:left;padding:4px 8px 4px 0;">Shape</th>
                <td style="padding:4px 12px 4px 0;"><t t-esc="summary['shape_label']"/></td>
                <th style="text-align:left;padding:4px 8px 4px 0;">Ceiling</th>
                <td style="padding:4px 0;"><t t-esc="summary['ceiling_mm']"/> mm</td>
              </tr>
              <tr>
                <th style="text-align:left;padding:4px 8px 4px 0;">Linear</th>
                <td style="padding:4px 12px 4px 0;"><t t-esc="summary['total_linear_mm']"/> mm</td>
                <th style="text-align:left;padding:4px 8px 4px 0;">Walls</th>
                <td style="padding:4px 0;"><t t-esc="summary['wall_count']"/></td>
              </tr>
              <tr t-if="summary['plumbing']">
                <th style="text-align:left;padding:4px 8px 4px 0;">Plumbing</th>
                <td colspan="3" style="color:#C28840;padding:4px 0;">Sink or dishwasher present</td>
              </tr>
            </table>
            <h3 class="report_h3" style="margin: 14px 0 6px 0;">Walls</h3>
            <table style="width:100%; border-collapse:collapse; font-size:9pt;">
              <thead>
                <tr>
                  <th>Wall</th><th>Length</th><th>Used</th>
                  <th>Remaining</th><th>Constraints</th><th>Conflict</th>
                </tr>
              </thead>
              <tbody>
                <t t-foreach="summary['walls']" t-as="w">
                  <tr>
                    <td t-esc="w['name']"/>
                    <td t-esc="str(w['length_mm']) + ' mm'"/>
                    <td t-esc="str(w['used_mm']) + ' mm'"/>
                    <td t-esc="str(w['remaining_mm']) + ' mm'"
                        t-att-style="'color:' + ('#A03E2D' if w['remaining_mm'] &lt; 0 else '#3D2F22') + ';'"/>
                    <td t-esc="w['constraint_count']"/>
                    <td t-esc="'YES' if w['conflicts'] else 'no'"/>
                  </tr>
                </t>
              </tbody>
            </table>
            <h3 class="report_h3" t-if="summary['constraints']"
                style="margin: 14px 0 6px 0;">Constraints</h3>
            <table t-if="summary['constraints']"
                   style="width:100%; border-collapse:collapse; font-size:9pt;">
              <thead>
                <tr>
                  <th>Wall</th><th>Type</th><th>Position</th>
                  <th>Width</th><th>Height</th>
                </tr>
              </thead>
              <tbody>
                <t t-foreach="summary['constraints']" t-as="c">
                  <tr>
                    <td t-esc="c['wall_name']"/>
                    <td t-esc="c['type_label']"/>
                    <td t-esc="str(c['position_mm']) + ' mm'"/>
                    <td t-esc="str(c['width_mm']) + ' mm'"/>
                    <td t-esc="(str(c['height_mm']) + ' mm') if c['height_mm'] else '—'"/>
                  </tr>
                </t>
              </tbody>
            </table>
          </div>

          <!--
            Phase 5 — Floor Plan page. SVG returned by to_svg() is
            inlined via plain t-out. The markup is trusted — to_svg()
            itself now returns a markupsafe.Markup-wrapped string (the
            standard Odoo pattern for "trusted HTML/SVG from Python"),
            html-escaping any user-supplied label text before assembly.
            QA fix (2026-07-04, found while testing Print): the
            original `t-out="Markup(room.to_svg(720, 540))"` referenced
            `Markup` BY NAME inside the template expression, but that
            name isn't bound in the namespace t-out/t-if expressions
            evaluate against (only in ir.qweb's own internal compiler
            globals) — every render of this report raised `KeyError:
            'Markup'`. Pre-wrapping the return value in Python and
            using a plain t-out here is the correct fix; t-raw is
            deprecated (noisy warning, removal planned) so it isn't
            used as the alternative.
          -->
          <div class="page" t-if="o.room_ids">
            <t t-set="room" t-value="o.room_ids[0]"/>
            <h2 class="report_h2" style="margin: 0 0 8px 0;">Floor Plan</h2>
            <div style="text-align:center; margin: 8px 0;">
              <t t-out="room.to_svg(720, 540)"/>
            </div>
            <p style="font-size: 8pt; color:#776B5C; text-align:center; margin-top: 6px;">
              Top-down view. Cabinet positions are nominal — verify against
              on-site measurements before manufacture.
            </p>
          </div>
        </t>
      </t>
    </t>
  </template>

  <!-- Dedicated paperformat: tight margins so the invoice fits on ONE A4 page.
       The default company A4 has margin_top=52 + header_spacing=52, which
       leaves an enormous empty gap and pushes the doc to page 2. Scoped only
       to this report via the paperformat_id below — global A4 untouched. -->
  <record id="paperformat_southbrook_invoice_a4" model="report.paperformat">
    <field name="name">Southbrook Invoice A4</field>
    <field name="format">A4</field>
    <field name="orientation">Portrait</field>
    <field name="dpi">90</field>
    <field name="margin_top">28</field>
    <field name="margin_bottom">16</field>
    <field name="margin_left">7</field>
    <field name="margin_right">7</field>
    <field name="header_spacing">16</field>
    <field name="header_line" eval="False"/>
  </record>

  <!-- ir.actions.report — binds the template to sale.order, with the
       dedicated Southbrook Invoice A4 paperformat. -->
  <record id="action_report_signature_spec_sheet" model="ir.actions.report">
    <field name="name">Signature Spec Sheet</field>
    <field name="model">sale.order</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">southbrook_estimating.report_signature_spec_sheet_doc</field>
    <field name="report_file">southbrook_estimating.report_signature_spec_sheet_doc</field>
    <field name="print_report_name">'Spec Sheet - %s' % (object.name)</field>
    <field name="paperformat_id" ref="paperformat_southbrook_invoice_a4"/>
    <field name="binding_model_id" ref="sale.model_sale_order"/>
    <field name="binding_type">report</field>
  </record>

</odoo>
