<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared inline styles for all 3 QWeb reports.

  Sky / Walnut / Linen palette from the prior intranet design language
  (Brief section 2.1). Hex values are placeholders until SIGNATURE_SERIES_TOKENS.md
  (#7, the Signature Series spec book PDF) lands; when it does, swap the hex
  literals below.

  IMPORTANT: wkhtmltopdf (QtWebKit) CANNOT resolve CSS custom properties.
  A prior version defined these as ":root" CSS variables and consumed them via
  the css var() function, which silently rendered Shop Copy / Door Order with NO
  colours, borders, or zone highlights. Values are inlined as literal hex here,
  the same wkhtmltopdf-compat discipline already documented in
  southbrook_room.py:to_svg() and signature_spec_sheet.xml. Do NOT reintroduce
  CSS variables in report styles.
-->
<odoo>

  <template id="southbrook_report_styles" name="Southbrook Report Styles">
    <style>
      .southbrook-report {
        font-family: "Source Sans Pro", "Helvetica", sans-serif;
        color: #2A2A2A;
        background: #F8F4EC;
        padding: 1.5cm;
      }
      .southbrook-report h1, .southbrook-report h2 {
        font-family: "Cardo", "Times New Roman", serif;
        color: #5C4033;
        margin: 0 0 0.4em 0;
      }
      .southbrook-report .sb-rule {
        border: 0;
        border-top: 1px solid #D6CFC1;
        margin: 1em 0;
      }
      .southbrook-report table {
        width: 100%;
        border-collapse: collapse;
      }
      .southbrook-report th {
        text-align: left;
        font-weight: 600;
        border-bottom: 2px solid #5C4033;
        padding: 0.4em 0.6em;
      }
      .southbrook-report td {
        border-bottom: 1px solid #D6CFC1;
        padding: 0.3em 0.6em;
      }
      .southbrook-report .sb-zone-header {
        background: #C8D9E0;
        color: #2A2A2A;
        font-weight: 600;
      }
      .southbrook-report .sb-muted {
        color: #8A8478;
        font-size: 0.9em;
      }
      .southbrook-report .sb-total-row td {
        font-weight: 700;
        border-top: 2px solid #5C4033;
      }
      .southbrook-report .sb-illustrative-banner {
        background: #FFF3CD;
        color: #856404;
        padding: 0.4em 0.8em;
        margin-bottom: 1em;
        border: 1px solid #FFEBA7;
        font-size: 0.85em;
        text-align: center;
      }
    </style>
  </template>

</odoo>
