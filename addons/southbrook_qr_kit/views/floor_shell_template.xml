<!--
  W073 (R8.8, 2026-06-27) — HTML shell for the standalone floor
  companion screens (Bin Scan, Load Unit). Bare-minimum host: pulls
  the lazy `web.assets_qr_floor` bundle (NOT web.assets_backend) so
  the operator tablet doesn't pay the backend bundle's load cost,
  then mounts a single <div id="sb_floor_root"> with a
  `data-sb-floor-app` attribute that the boot in
  static/src/js/floor_screens.esm.js reads to pick which screen to
  instantiate (BinScanScreen vs LoadUnitScreen).

  Body carries `sb-dense` (W039) so touch targets are sized for
  operator hands by default.
-->
<odoo>
    <template id="floor_shell" name="Southbrook QR Floor Shell">
        <html>
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport"
                      content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no"/>
                <title>
                    <t t-esc="title"/> — Southbrook Floor
                </title>
                <t t-call-assets="web.assets_qr_floor" t-js="true"/>
                <t t-call-assets="web.assets_qr_floor" t-css="true"/>
            </head>
            <body class="sb-dense">
                <div id="sb_floor_root"
                     t-att-data-sb-floor-app="app_name">
                    <div style="padding:2rem;font-family:system-ui;color:#888">
                        Loading floor app…
                    </div>
                </div>
            </body>
        </html>
    </template>
</odoo>
