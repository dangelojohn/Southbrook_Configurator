<odoo noupdate="1">
    <!-- The hmac_secret is auto-generated on first use; no seed
         needed. -->

    <!-- W036 (R8.7) — global mute for scan-success/fail audio cues.
         Default "0" = audio on. Flip to "1" to silence every tablet
         site-wide; each tablet can also locally mute via
         `localStorage["southbrook.qr_kit.audio_muted"] = "1"`. -->
    <record id="ir_config_param_qr_audio_muted" model="ir.config_parameter">
        <field name="key">southbrook.qr_kit.audio_muted</field>
        <field name="value">0</field>
    </record>

    <!-- W035 (R8.14) — operator session timeout in minutes. After
         N minutes of inactivity (no scans, no whoami refreshes) the
         tablet's bound operator is cleared and the next scan reverts
         to env.user.employee_id fallback (or empty). Range is clamped
         to [1, 1440] in the controller. Default 30 minutes. -->
    <record id="ir_config_param_operator_session_timeout"
            model="ir.config_parameter">
        <field name="key">southbrook.operator_session_timeout_min</field>
        <field name="value">30</field>
    </record>

    <!-- W037 (R8.4) — Service-Worker offline-scan-queue cap. The
         in-browser IndexedDB FIFO holds at most this many queued
         scans during a wifi outage; beyond the cap the OLDEST entry
         is evicted (so the operator always keeps the most recent
         scans). Default 500 ≈ one shift of dense scanning at a
         single station. The Service Worker reads this via a small
         postMessage from the client glue (offline_scan_queue.js).
         Clamped client-side to [1, 10000]. -->
    <record id="ir_config_param_offline_queue_cap"
            model="ir.config_parameter">
        <field name="key">southbrook.qr_kit.offline_queue_cap</field>
        <field name="value">500</field>
    </record>

    <!-- W037 (R8.4) — Server-side client_uuid replay-dedup TTL in
         seconds. Replays of the same client_uuid within this window
         return the cached response without re-running the handler.
         Default 600s (10 min) — covers typical wifi-outage drain
         windows while keeping the worker-local cache bounded. -->
    <record id="ir_config_param_client_uuid_ttl_sec"
            model="ir.config_parameter">
        <field name="key">southbrook.qr_kit.client_uuid_ttl_sec</field>
        <field name="value">600</field>
    </record>

    <!-- W035 (R8.14) — global on/off for the operator PIN gate. "1" =
         default behaviour (badge + auto-modal on /odoo /web /sb/ URLs
         when no operator is bound). "0" = feature completely disabled:
         no badge injected, no auto-prompt, no /sb/qr/whoami loops from
         the client glue. Flip in Settings → Technical → System
         Parameters when a site has no shop-floor tablet workflow (or
         when the modal is blocking backend admin use). -->
    <record id="ir_config_param_operator_pin_modal_enabled"
            model="ir.config_parameter">
        <field name="key">southbrook.qr_kit.operator_pin_modal_enabled</field>
        <field name="value">0</field>
    </record>

    <!-- W038 (R8.5) — night-shift dark mode auto-engage flag. When
         "1" the dark_mode_toggle.js will auto-flip to dark in the
         22:00-06:00 local window IF the user has NEVER set an
         explicit preference (URL param OR localStorage). Once the
         user manually toggles (sbDarkMode.on/off) the choice
         persists and auto-engage is bypassed.
         Default "0" — auto-engage OFF so day-shift users never get
         surprised by an automatic theme swap. -->
    <record id="ir_config_param_dark_mode_auto_engage"
            model="ir.config_parameter">
        <field name="key">southbrook.dark_mode.auto_engage</field>
        <field name="value">0</field>
    </record>
</odoo>

