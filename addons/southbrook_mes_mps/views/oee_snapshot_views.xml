<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_oee_snapshot_list" model="ir.ui.view">
    <field name="name">southbrook.mes_mps.oee_snapshot.list</field>
    <field name="model">southbrook.mes_mps.oee_snapshot</field>
    <field name="arch" type="xml">
      <list string="OEE Snapshots"
            decoration-success="oee_class == 'world_class'"
            decoration-info="oee_class == 'good'"
            decoration-warning="oee_class == 'typical'"
            decoration-danger="oee_class == 'unacceptable'">
        <field name="name"/>
        <field name="workcenter_id"/>
        <field name="shift_date"/>
        <field name="shift"/>
        <field name="availability" widget="percentage"/>
        <field name="performance" widget="percentage"/>
        <field name="quality" widget="percentage"/>
        <field name="oee" widget="percentage"/>
        <field name="oee_class"/>
      </list>
    </field>
  </record>

  <record id="view_oee_snapshot_form" model="ir.ui.view">
    <field name="name">southbrook.mes_mps.oee_snapshot.form</field>
    <field name="model">southbrook.mes_mps.oee_snapshot</field>
    <field name="arch" type="xml">
      <form string="OEE Snapshot">
        <sheet>
          <div class="oe_title">
            <h1><field name="name" readonly="1"/></h1>
          </div>
          <group>
            <group string="Setup">
              <field name="workcenter_id"/>
              <field name="shift_date"/>
              <field name="shift"/>
              <field name="planned_minutes"/>
            </group>
            <group string="Actuals">
              <field name="actual_run_minutes"/>
              <field name="actual_idle_minutes"/>
              <field name="actual_downtime_minutes"/>
              <field name="units_produced"/>
              <field name="units_target"/>
              <field name="units_rejected"/>
            </group>
          </group>
          <group string="Computed OEE">
            <field name="availability" widget="percentage" readonly="1"/>
            <field name="performance" widget="percentage" readonly="1"/>
            <field name="quality" widget="percentage" readonly="1"/>
            <field name="oee" widget="percentage" readonly="1"/>
            <field name="oee_class" readonly="1"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_oee_snapshot_graph" model="ir.ui.view">
    <field name="name">southbrook.mes_mps.oee_snapshot.graph</field>
    <field name="model">southbrook.mes_mps.oee_snapshot</field>
    <field name="arch" type="xml">
      <graph string="OEE Over Time" type="line">
        <field name="shift_date" interval="day"/>
        <field name="workcenter_id"/>
        <field name="oee" type="measure"/>
      </graph>
    </field>
  </record>

  <record id="action_oee_snapshot" model="ir.actions.act_window">
    <field name="name">OEE Snapshots</field>
    <field name="res_model">southbrook.mes_mps.oee_snapshot</field>
    <field name="view_mode">list,form,graph</field>
  </record>

</odoo>
