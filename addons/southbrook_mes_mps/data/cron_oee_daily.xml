<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">

    <!-- v19: ir.cron inherits ir.actions.server; legacy call counters
         are removed. Code-state cron uses model + code only. -->
    <record id="cron_oee_daily" model="ir.cron">
      <field name="name">MES: OEE Snapshot (Daily 23:55)</field>
      <field name="model_id" ref="model_southbrook_mes_mps_oee_snapshot"/>
      <field name="state">code</field>
      <field name="code">model.action_compute_from_workcenter_productivity()</field>
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
      <field name="active" eval="True"/>
    </record>

  </data>
</odoo>
