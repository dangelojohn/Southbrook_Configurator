<?xml version="1.0" encoding="utf-8"?>
<!--
  Sale Order form inherit — Production Approval header + tab.

  Tier 0 fix history: the database had this view living under the
  module's xmlid but no corresponding file. After the model fields
  landed, Odoo's manifest-aware loader auto-deleted the orphan on
  module upgrade — re-shipping the view as a tracked file so it
  comes back cleanly and stays in sync with future model changes.

  The state machine itself is on sale.order
  (see models/sale_order.py — production_approval_state +
   action_request_production / action_approve_production /
   action_reject_production).
-->
<odoo>

    <record id="view_order_form_production_approval"
            model="ir.ui.view">
        <field name="name">sale.order.form.southbrook.production.approval</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <header position="inside">
                <button name="action_request_production"
                        type="object"
                        string="Request Production"
                        class="btn-primary"
                        invisible="state != 'sale' or production_approval_state not in ('none', 'rejected')"/>
                <button name="action_approve_production"
                        type="object"
                        string="Approve Production"
                        class="btn-primary"
                        groups="southbrook_mrp_pm.group_southbrook_production_approver"
                        invisible="production_approval_state != 'pending'"/>
                <button name="action_reject_production"
                        type="object"
                        string="Reject"
                        groups="southbrook_mrp_pm.group_southbrook_production_approver"
                        invisible="production_approval_state != 'pending'"/>
                <field name="production_approval_state"
                       widget="badge"
                       decoration-info="production_approval_state == 'pending'"
                       decoration-success="production_approval_state == 'approved'"
                       decoration-danger="production_approval_state == 'rejected'"/>
            </header>

            <!--
              W009 — Production-approval HARD GATE bypass.
              Manager-only (sales_team.group_sale_manager). Every flip
              of force_production_release is auto-tracked into chatter
              via tracking=True on the field. Placed inside the
              notebook as its own page so it's reachable in every
              order state (the existing Production Approval page is
              hidden when state='none' which is exactly when a manager
              might want to set the bypass pre-confirm). Only sales
              managers see the page at all.
            -->
            <xpath expr="//page[@name='production_approval']"
                   position="after">
                <page name="production_approval_bypass"
                      string="Approval Bypass"
                      groups="sales_team.group_sale_manager"
                      invisible="production_approval_state == 'approved'">
                    <group>
                        <field name="force_production_release"/>
                    </group>
                    <p class="text-muted">
                        Manager-only override. When checked, this order can be
                        confirmed even if production approval was not granted.
                        Use sparingly — every flip is logged in the order
                        chatter for audit. Prefer the normal Request → Approve
                        flow.
                    </p>
                </page>
            </xpath>

            <notebook position="inside">
                <page name="production_approval"
                      string="Production Approval"
                      invisible="production_approval_state == 'none'">
                    <group>
                        <group string="Request">
                            <field name="production_requested_by" readonly="1"/>
                            <field name="production_requested_date" readonly="1"/>
                        </group>
                        <group string="Decision">
                            <field name="production_approved_by" readonly="1"/>
                            <field name="production_approved_date" readonly="1"/>
                        </group>
                    </group>
                    <group string="Rejection Reason"
                           invisible="production_approval_state not in ('pending', 'rejected')">
                        <field name="production_reject_reason"
                               nolabel="1"
                               placeholder="Required context when rejecting — shown to the requester."/>
                    </group>
                </page>
            </notebook>

        </field>
    </record>

</odoo>
