<?xml version="1.0" encoding="utf-8"?>
<!--
  M17 (Manufacturing PM JTBD 2026-06-01) — Floor Manager
  res.groups + module category.

  Defines:

    module_category_southbrook_pm     Settings > Users module
                                       category so the Floor
                                       Manager group appears in
                                       the user-form access tab
                                       alongside other Sothbrook
                                       application toggles.

    group_floor_manager               'Floor Manager'. Inherits
                                       base.group_portal so members
                                       are portal users by default
                                       (can be promoted to internal
                                       by the admin if needed).
                                       Grants the model-level
                                       accesses defined in
                                       security/ir.model.access.csv.
-->
<odoo>
  <data noupdate="1">

    <!-- res.groups in Odoo 19 dropped category_id (replaced by
         privilege_id which is module-internal). For our purposes
         the group just needs a name + portal inheritance + the
         ir.model.access.csv hookup. -->
    <record id="group_floor_manager" model="res.groups">
      <field name="name">Southbrook Floor Manager</field>
      <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
      <field name="comment">
        Members can access /my/southbrook/floor to see their
        station's work-order queue, start/finish their own work
        orders, and toggle the condition pill on equipment
        assigned to their work center.
      </field>
    </record>

    <!--
      Production Approver — gates the Sale → MO transition. The
      existing `view_order_form_production_approval` view (declared
      in this module) restricts the Approve / Reject buttons to
      members of this group; the state machine itself lives on
      sale.order.production_approval_state (added in the same
      Tier-0-fix commit). Internal-user implied so an approver also
      has read on partners + sale orders by default.
    -->
    <record id="group_southbrook_production_approver" model="res.groups">
      <field name="name">Southbrook Production Approver</field>
      <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
      <field name="comment">
        Members can approve or reject a confirmed sale order's
        request to manufacture. Approving fires action_send_to_production,
        which materialises one mrp.production per BoM-matched line and
        (when southbrook_project is installed) links the new MOs to a
        project.task in the production-tracking project.
      </field>
    </record>

  </data>

  <!--
    REG-R1.1 extension records — MUST live OUTSIDE the noupdate=1 data
    block above. Background: the noupdate=1 semantics in Odoo 19 are
    "load once on -i, skip silently on every -u if the xmlid already
    exists". The two records below target xmlids (base.user_admin,
    sales_team.group_sale_manager) that EXIST BEFORE -u of this module
    runs — so under noupdate=1 they'd be silently skipped, which is
    exactly what happened on the first attempted ship of this fix
    (state file marked deploy OK; admin group still empty in the DB).

    By placing them in a default <data> block (no noupdate), Odoo treats
    them as standard upgrade-time writes. The (4, ref(...)) tuple is
    idempotent — adding an already-present link is a no-op — so
    re-running -u doesn't churn.

    The tradeoff: a manual revocation of admin's approver group will
    be re-applied on the next -u of this module. If SOX-style
    separation-of-duty matters, override by moving these records to a
    noupdate=1 site-local module (or removing the imply at the
    sale_manager → approver edge instead of at admin's membership).
  -->
  <data>

    <!--
      REG-R1.1 (2026-06-18): admin (base.user_admin) is NOT auto-
      added to custom-module groups in Odoo 19 (see session memory
      odoo19_res_users_group_ids_rename.md). Without this record the
      Approve / Reject buttons on the Production Approval header are
      hidden from the admin user, even though the buttons + state +
      methods all ship correctly — caught by Claude Chrome end-to-end
      Run 1 report (finding 1.1).

      Field name is `group_ids` on res.users in v19 (renamed from
      `groups_id`; see memory note).
    -->
    <record id="base.user_admin" model="res.users">
      <field name="group_ids"
             eval="[(4, ref('southbrook_mrp_pm.group_southbrook_production_approver'))]"/>
    </record>

    <!--
      REG-R1.1 part 2: imply the Production Approver group from
      Sales Manager. Anyone who can manage sales orders is, by
      default, also able to approve production for them. Matches
      Odoo core's own imply-chain pattern (Sales User → Sales
      Manager → Accounting Manager).
    -->
    <record id="sales_team.group_sale_manager" model="res.groups">
      <field name="implied_ids"
             eval="[(4, ref('southbrook_mrp_pm.group_southbrook_production_approver'))]"/>
    </record>

  </data>

</odoo>
