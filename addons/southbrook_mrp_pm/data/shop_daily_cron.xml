<?xml version="1.0" encoding="utf-8"?>
<!--
  W048 (R7.4, 2026-06-27) — daily shop snapshot cron.

  At 23:55 every day, snapshot the day that is closing for every
  active mrp.workcenter. Idempotent: re-runs delete the same day's
  rows then re-create from the source tables.

  Odoo 19: ir.cron inherits ir.actions.server; `numbercall` and
  `doall` fields are gone (memory: odoo19_ir_cron_schema_change).
  Schedule is encoded via interval_number + interval_type + nextcall.
-->
<odoo>
    <data noupdate="1">

        <record id="ir_cron_southbrook_shop_daily_snapshot" model="ir.cron">
            <field name="name">Southbrook · Shop Daily Snapshot (W048)</field>
            <field name="model_id" ref="model_southbrook_shop_daily"/>
            <field name="state">code</field>
            <field name="code">model._cron_snapshot_today()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <!-- First run scheduled at 23:55 UTC on the install day so
                 the very first night closes a snapshot without an
                 admin having to twiddle nextcall by hand. -->
            <field name="nextcall"
                   eval="(DateTime.utcnow().replace(hour=23, minute=55, second=0, microsecond=0)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
