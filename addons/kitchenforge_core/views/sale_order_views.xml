<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_order_form_kitchenforge" model="ir.ui.view">
        <field name="name">sale.order.form.kitchenforge</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale_info']" position="inside">
                <field name="kitchenforge_template_id" readonly="1"
                       invisible="not kitchenforge_template_id"/>
                <field name="kitchenforge_project_id" readonly="1"
                       invisible="not kitchenforge_project_id"/>
            </xpath>
        </field>
    </record>

</odoo>
