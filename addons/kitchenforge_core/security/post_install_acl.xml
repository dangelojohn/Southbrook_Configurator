<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
        Post-install ACL records.

        Why XML and noupdate=1: when installing via base_import_module,
        the CSV is processed before Python classes register their models
        in ir.model. That causes lookups like model_kitchenforge_template_line
        to fail with "No matching record found for external id".

        XML <record> with <field name="model_id" ref="..."/> is processed
        the same way and would fail too — BUT we can use a search-based
        ref via eval and a domain that matches the model name string.
        The reference resolves at apply-time, by which point ir.model
        has been populated.
    -->

    <record id="access_kf_template_line_user" model="ir.model.access">
        <field name="name">kf template line user</field>
        <field name="model_id"
               search="[('model', '=', 'kitchenforge.template.line')]"/>
        <field name="group_id" ref="group_kitchenforge_user"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <record id="access_kf_template_line_manager" model="ir.model.access">
        <field name="name">kf template line manager</field>
        <field name="model_id"
               search="[('model', '=', 'kitchenforge.template.line')]"/>
        <field name="group_id" ref="group_kitchenforge_manager"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>

    <record id="access_kf_instantiate_wizard_user" model="ir.model.access">
        <field name="name">kf instantiate wizard user</field>
        <field name="model_id"
               search="[('model', '=', 'kitchenforge.instantiate.wizard')]"/>
        <field name="group_id" ref="group_kitchenforge_user"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>

</odoo>
