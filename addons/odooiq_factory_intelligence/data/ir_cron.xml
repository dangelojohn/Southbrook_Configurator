<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_oiq_refresh_audit" model="ir.cron">
            <field name="name">OdooIQ: Refresh Factory Audit</field>
            <field name="model_id" ref="model_oiq_scheduling_intelligence"/>
            <field name="state">code</field>
            <field name="code">
for company in env['res.company'].search([]):
    env['oiq.scheduling.intelligence'].analyze(company)
            </field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
        </record>

        <record id="cron_oiq_shadow_schedule" model="ir.cron">
            <field name="name">OdooIQ: Shadow Schedule + Backfill Actuals</field>
            <field name="model_id" ref="model_oiq_scheduling_intelligence"/>
            <field name="state">code</field>
            <field name="code">
for company in env['res.company'].search([]):
    env['oiq.scheduling.intelligence'].backfill_actuals(company)
    env['oiq.scheduling.intelligence'].shadow_schedule(company, 14)
            </field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
        </record>

        <record id="cron_oiq_calibration" model="ir.cron">
            <field name="name">OdooIQ: Harvest Completions + Recompute Calibration</field>
            <field name="model_id" ref="model_oiq_scheduling_intelligence"/>
            <field name="state">code</field>
            <field name="code">
for company in env['res.company'].search([]):
    env['oiq.scheduling.intelligence'].harvest_completions(company)
    env['oiq.scheduling.intelligence'].recompute_calibration(company)
            </field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>
