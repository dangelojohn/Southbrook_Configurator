<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_oiq_factory_audit_list" model="ir.ui.view">
        <field name="name">oiq.factory.audit.list</field>
        <field name="model">oiq.factory.audit</field>
        <field name="arch" type="xml">
            <list string="Factory Intelligence Audits">
                <field name="date"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="readiness_level" string="Readiness"/>
                <field name="structural_score"/>
                <field name="behavioral_score_available" string="Behavioral"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_oiq_factory_audit_form" model="ir.ui.view">
        <field name="name">oiq.factory.audit.form</field>
        <field name="model">oiq.factory.audit</field>
        <field name="arch" type="xml">
            <form string="Factory Intelligence Audit">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="readiness_level" readonly="1"/> <span> / 5 — Readiness Level</span></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="horizon_days"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="structural_score"/>
                            <field name="behavioral_score_available"/>
                            <field name="behavioral_score" invisible="not behavioral_score_available"/>
                        </group>
                    </group>
                    <group string="Summary">
                        <field name="summary_text" nolabel="1" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Findings">
                            <field name="finding_ids">
                                <list>
                                    <field name="severity" widget="badge"
                                           decoration-danger="severity == 'blocker'"
                                           decoration-warning="severity == 'warn'"/>
                                    <field name="signal_code"/>
                                    <field name="tier"/>
                                    <field name="title"/>
                                    <field name="affected_count"/>
                                    <field name="expected_improvement"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_oiq_factory_audit" model="ir.actions.act_window">
        <field name="name">Factory Intelligence Audits</field>
        <field name="res_model">oiq.factory.audit</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_oiq_run_audit_now" model="ir.actions.server">
        <field name="name">Run Factory Audit Now</field>
        <field name="model_id" ref="model_oiq_scheduling_intelligence"/>
        <field name="state">code</field>
        <field name="code">action = env['oiq.scheduling.intelligence'].analyze(env.company).get_formview_action()</field>
    </record>

    <menuitem id="menu_oiq_root" name="Factory Intelligence" sequence="90"
              web_icon="mrp,static/description/icon.png"/>
    <menuitem id="menu_oiq_audits" name="Audits" parent="menu_oiq_root"
              action="action_oiq_factory_audit" sequence="10"
              groups="group_odooiq_user"/>
    <menuitem id="menu_oiq_run_audit" name="Run Audit Now" parent="menu_oiq_root"
              action="action_oiq_run_audit_now" sequence="20"
              groups="group_odooiq_manager"/>

</odoo>
