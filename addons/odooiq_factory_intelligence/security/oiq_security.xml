<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="group_odooiq_user" model="res.groups">
            <field name="name">OdooIQ User</field>
            <field name="comment">Read access to factory intelligence audits and findings.</field>
        </record>

        <record id="group_odooiq_manager" model="res.groups">
            <field name="name">OdooIQ Manager</field>
            <field name="implied_ids" eval="[(4, ref('group_odooiq_user'))]"/>
            <field name="comment">Full access: run audits, manage findings.</field>
        </record>

        <!-- Multi-company isolation -->
        <record id="rule_oiq_factory_audit_company" model="ir.rule">
            <field name="name">Factory audit: multi-company</field>
            <field name="model_id" ref="model_oiq_factory_audit"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_oiq_factory_audit_finding_company" model="ir.rule">
            <field name="name">Factory audit finding: multi-company</field>
            <field name="model_id" ref="model_oiq_factory_audit_finding"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_oiq_schedule_run_company" model="ir.rule">
            <field name="name">Schedule run: multi-company</field>
            <field name="model_id" ref="model_oiq_schedule_run"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_oiq_schedule_slot_company" model="ir.rule">
            <field name="name">Schedule slot: multi-company</field>
            <field name="model_id" ref="model_oiq_schedule_slot"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
