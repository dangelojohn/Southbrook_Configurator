<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Install Risk board — jobs that are either flagged at risk by the
        readiness engine OR have an install date within 14 days. The
        union is intentional: a job 10 days out that isn't flagged is
        still install-critical.
    -->

    <record id="view_install_risk_list" model="ir.ui.view">
        <field name="name">project.task.install.risk.list</field>
        <field name="model">project.task</field>
        <field name="priority">16</field>
        <field name="arch" type="xml">
            <list string="Install Risk"
                  decoration-danger="job_at_risk or readiness_decision == 'blocked'"
                  decoration-warning="readiness_decision == 'review'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="x_install_due_date"/>
                <field name="readiness_decision" widget="badge"
                       decoration-danger="readiness_decision == 'blocked'"
                       decoration-warning="readiness_decision == 'review'"
                       decoration-success="readiness_decision == 'ready'"/>
                <field name="readiness_score"/>
                <field name="southbrook_unscheduled_wo_count"/>
                <field name="southbrook_production_release_state"/>
                <field name="job_at_risk" widget="boolean_toggle" readonly="1"/>
                <field name="x_southbrook_sale_order_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_install_risk_kanban" model="ir.ui.view">
        <field name="name">project.task.install.risk.kanban</field>
        <field name="model">project.task</field>
        <field name="priority">16</field>
        <field name="arch" type="xml">
            <kanban default_group_by="readiness_decision"
                    class="o_kanban_small_column"
                    sample="1">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="x_install_due_date"/>
                <field name="readiness_decision"/>
                <field name="readiness_score"/>
                <field name="job_at_risk"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_top">
                            <div class="o_kanban_record_headings">
                                <strong>
                                    <field name="name"/>
                                </strong>
                                <small class="text-muted">
                                    <field name="partner_id"/>
                                </small>
                            </div>
                            <field name="readiness_decision"
                                   widget="label_selection"
                                   options="{'classes': {'blocked':'danger','review':'warning','ready':'success'}}"/>
                        </div>
                        <div class="o_kanban_record_body">
                            <div t-if="record.x_install_due_date.raw_value">
                                <span class="fw-bold">Install: </span>
                                <field name="x_install_due_date"/>
                            </div>
                            <div t-if="record.job_at_risk.raw_value">
                                <span class="badge text-bg-danger">At Risk</span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_install_risk_search" model="ir.ui.view">
        <field name="name">project.task.install.risk.search</field>
        <field name="model">project.task</field>
        <field name="priority">16</field>
        <field name="arch" type="xml">
            <search string="Install Risk">
                <field name="name"/>
                <field name="partner_id"/>
                <filter name="at_risk"
                        string="Flagged At Risk"
                        domain="[('job_at_risk','=',True)]"/>
                <filter name="install_7_days"
                        string="Install Within 7 Days"
                        domain="[('x_install_due_date','&lt;=', (context_today() + relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <filter name="install_14_days"
                        string="Install Within 14 Days"
                        domain="[('x_install_due_date','&lt;=', (context_today() + relativedelta(days=14)).strftime('%Y-%m-%d'))]"/>
                <group name="group_by_install_risk">
                    <filter name="group_readiness"
                            string="Readiness"
                            context="{'group_by': 'readiness_decision'}"/>
                    <filter name="group_install_date"
                            string="Install Date"
                            context="{'group_by': 'x_install_due_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_install_risk_board" model="ir.actions.act_window">
        <field name="name">Install Risk</field>
        <field name="res_model">project.task</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">['|',('job_at_risk','=',True),('x_install_due_date','&lt;=',(context_today() + relativedelta(days=14)).strftime('%Y-%m-%d'))]</field>
        <field name="search_view_id" ref="view_install_risk_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No jobs at install risk
            </p>
            <p>
                Jobs land here when the readiness engine flags them at
                risk, or when their install date is within 14 days.
            </p>
        </field>
    </record>

</odoo>
