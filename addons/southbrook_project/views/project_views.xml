<?xml version="1.0" encoding="utf-8"?>
<!--
  project.project form inherit — surface the corrected
  southbrook_top_level_task_count next to the stock task count so
  operators see real customer-job count, not subtask-inflated totals.

  Stock open_task_count stays put for backwards-compatibility with
  any module that already reads it (Tasks Analysis, Burndown, etc.).
-->
<odoo>

    <record id="view_project_form_inherit_southbrook"
            model="ir.ui.view">
        <field name="name">project.project.form.inherit.southbrook</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="class" add="o_southbrook_project_chatter_bottom" separator=" "/>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button"
                        type="object"
                        icon="fa-briefcase"
                        name="action_view_tasks">
                    <field name="southbrook_top_level_task_count"
                           widget="statinfo"
                           string="Customer Jobs"/>
                </button>
            </xpath>
        </field>
    </record>

    <record id="view_project_form_simplified_chatter_bottom_southbrook"
            model="ir.ui.view">
        <field name="name">project.project.form.simplified.chatter.bottom.southbrook</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.project_project_view_form_simplified"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="class" add="o_southbrook_project_chatter_bottom" separator=" "/>
            </xpath>
        </field>
    </record>

    <record id="view_project_update_form_chatter_bottom_southbrook"
            model="ir.ui.view">
        <field name="name">project.update.form.chatter.bottom.southbrook</field>
        <field name="model">project.update</field>
        <field name="inherit_id" ref="project.project_update_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="class" add="o_southbrook_project_chatter_bottom" separator=" "/>
            </xpath>
        </field>
    </record>

    <!--
      FIX A — project overview kanban: replace the inflated open_task_count
      (which counts every task, including production subtasks under each
      customer job) with southbrook_top_level_task_count (top-level only).

      The user's complaint: /odoo/project shows "Test" with "4 Tasks" when
      it's really 1 customer job + 3 sub-steps. Operators read this as
      4 jobs, which misreads queue volume.

      We surgically replace the field reference inside the existing button
      so:
        * label_tasks ("Tasks") stays
        * the card layout is untouched
        * the task-progress 0/3 chip on the card (computed elsewhere) is
          unaffected
    -->
    <record id="view_project_kanban_inherit_southbrook"
            model="ir.ui.view">
        <field name="name">project.project.kanban.inherit.southbrook</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_kanban"/>
        <field name="active" eval="False"/>
        <field name="arch" type="xml">
            <xpath expr="//templates" position="before">
                <field name="southbrook_top_level_task_count"/>
                <field name="label_tasks"/>
                <field name="milestone_count"/>
                <field name="milestone_count_reached"/>
                <field name="last_update_status"/>
                <field name="is_favorite"/>
                <field name="activity_ids"/>
                <field name="alias_email"/>
                <field name="color"/>
                <field name="date_start"/>
                <field name="display_name"/>
                <field name="partner_id"/>
                <field name="rating_avg"/>
                <field name="tag_ids"/>
                <field name="user_id"/>
            </xpath>
            <xpath expr="//field[@name='open_task_count']"
                   position="replace">
                <field name="southbrook_top_level_task_count"
                       class="o_value"/>
            </xpath>
        </field>
    </record>

</odoo>
