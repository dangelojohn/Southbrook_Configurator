<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_kf_subscription_plan_list" model="ir.ui.view">
        <field name="name">kitchenforge.subscription.plan.list</field>
        <field name="model">kitchenforge.subscription.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="monthly_usd"/>
                <field name="annual_usd"/>
                <field name="max_seats"/>
                <field name="max_active_projects"/>
                <field name="marathon_rebate_eligible"/>
                <field name="subscriber_count"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_kf_subscription_plan_form" model="ir.ui.view">
        <field name="name">kitchenforge.subscription.plan.form</field>
        <field name="model">kitchenforge.subscription.plan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="marathon_rebate_eligible"/>
                        </group>
                        <group>
                            <field name="monthly_usd"/>
                            <field name="annual_usd"/>
                            <field name="max_seats"/>
                            <field name="max_active_projects"/>
                            <field name="subscriber_count"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_kf_subscription_plan" model="ir.actions.act_window">
        <field name="name">Subscription Plans</field>
        <field name="res_model">kitchenforge.subscription.plan</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
