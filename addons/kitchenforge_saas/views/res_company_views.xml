<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_res_company_form_kf_brand" model="ir.ui.view">
        <field name="name">res.company.form.kitchenforge.brand</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="KitchenForge Branding" name="kitchenforge_brand">
                    <field name="kitchenforge_tenant_id"/>
                    <field name="kitchenforge_brand_logo" widget="image"/>
                    <field name="kitchenforge_brand_primary_color"/>
                    <field name="kitchenforge_brand_secondary_color"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
