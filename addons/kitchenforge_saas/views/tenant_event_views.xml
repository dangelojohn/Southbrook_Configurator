<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_kf_tenant_event_list" model="ir.ui.view">
        <field name="name">kitchenforge.tenant.event.list</field>
        <field name="model">kitchenforge.tenant.event</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="create_date"/>
                <field name="tenant_id"/>
                <field name="event_type"/>
                <field name="message"/>
            </list>
        </field>
    </record>

    <record id="view_kf_tenant_event_form" model="ir.ui.view">
        <field name="name">kitchenforge.tenant.event.form</field>
        <field name="model">kitchenforge.tenant.event</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <sheet>
                    <group>
                        <field name="tenant_id"/>
                        <field name="event_type"/>
                        <field name="message"/>
                        <field name="create_date"/>
                    </group>
                    <group string="Payload">
                        <field name="payload_json" nolabel="1" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_kf_tenant_event" model="ir.actions.act_window">
        <field name="name">Tenant Events</field>
        <field name="res_model">kitchenforge.tenant.event</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
