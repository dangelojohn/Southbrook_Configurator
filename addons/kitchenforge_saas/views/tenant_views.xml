<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_kf_tenant_list" model="ir.ui.view">
        <field name="name">kitchenforge.tenant.list</field>
        <field name="model">kitchenforge.tenant</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="slug"/>
                <field name="status" widget="badge"
                    decoration-success="status == 'live'"
                    decoration-info="status == 'provisioning'"
                    decoration-warning="status == 'suspended'"
                    decoration-muted="status == 'cancelled'"/>
                <field name="tier"/>
                <field name="plan_id"/>
                <field name="mrr_usd" sum="MRR"/>
                <field name="seats" sum="Seats"/>
                <field name="cabinets_last_30d" sum="Cabinets/30d"/>
                <field name="marathon_referred" optional="hide"/>
                <field name="admin_email"/>
                <field name="created_at" optional="hide"/>
                <field name="provisioned_at" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_kf_tenant_kanban" model="ir.ui.view">
        <field name="name">kitchenforge.tenant.kanban</field>
        <field name="model">kitchenforge.tenant</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_small_column">
                <field name="id"/>
                <field name="name"/>
                <field name="slug"/>
                <field name="status"/>
                <field name="tier"/>
                <field name="mrr_usd"/>
                <field name="seats"/>
                <field name="cabinets_last_30d"/>
                <field name="admin_email"/>
                <field name="marathon_referred"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <span class="o_kanban_record_subtitle text-muted">
                                        <field name="slug"/>.kitchenforge.app
                                    </span>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div>
                                    <span class="badge text-bg-info">
                                        <field name="tier"/>
                                    </span>
                                    <t t-if="record.marathon_referred.raw_value">
                                        <span class="badge text-bg-warning ms-1">Marathon</span>
                                    </t>
                                </div>
                                <div class="mt-2">
                                    <strong>$<field name="mrr_usd"/></strong> MRR
                                    · <field name="seats"/> seats
                                </div>
                                <div class="text-muted">
                                    <field name="cabinets_last_30d"/> cabinets in last 30d
                                </div>
                                <div class="text-muted">
                                    <field name="admin_email"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_kf_tenant_form" model="ir.ui.view">
        <field name="name">kitchenforge.tenant.form</field>
        <field name="model">kitchenforge.tenant</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_provision" type="object"
                            string="Provision" class="btn-primary"
                            invisible="status not in ('pending', 'suspended')"/>
                    <button name="action_suspend" type="object"
                            string="Suspend" class="btn-secondary"
                            invisible="status not in ('live', 'provisioning')"
                            confirm="Suspending will lock the tenant's sale order confirmations and revoke their API keys. Continue?"/>
                    <button name="action_resume" type="object"
                            string="Resume" class="btn-primary"
                            invisible="status != 'suspended'"/>
                    <button name="action_cancel" type="object"
                            string="Cancel" class="btn-danger"
                            invisible="status == 'cancelled'"
                            confirm="Cancelling is terminal: Stripe subscription will be deleted and the docker stack torn down. Continue?"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="pending,provisioning,live,suspended,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_events" type="object"
                                class="oe_stat_button" icon="fa-list">
                            <field name="event_count" widget="statinfo" string="Events"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-key" disabled="1">
                            <field name="api_key_count" widget="statinfo" string="API Keys"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Acme Cabinetry"/></h1>
                        <div>
                            <field name="slug" placeholder="acme-cabinetry"/>.kitchenforge.app
                        </div>
                    </div>
                    <group>
                        <group name="plan">
                            <field name="tier"/>
                            <field name="plan_id"/>
                            <field name="mrr_usd"/>
                            <field name="seats"/>
                            <field name="cabinets_last_30d" readonly="1"/>
                            <field name="marathon_referred"/>
                        </group>
                        <group name="billing">
                            <field name="billing_provider"/>
                            <field name="stripe_customer_id"/>
                            <field name="stripe_subscription_id"/>
                            <field name="admin_email"/>
                            <field name="admin_user_id"/>
                            <field name="partner_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Provisioned Infra" name="infra">
                            <group>
                                <field name="docker_compose_path"/>
                                <field name="caddy_snippet_path"/>
                                <field name="created_at" readonly="1"/>
                                <field name="provisioned_at" readonly="1"/>
                                <field name="suspended_at" readonly="1"/>
                                <field name="cancelled_at" readonly="1"/>
                            </group>
                        </page>
                        <page string="Lifecycle Events" name="events">
                            <field name="event_ids" readonly="1">
                                <list>
                                    <field name="create_date"/>
                                    <field name="event_type"/>
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>
                        <page string="Companies (white-label)" name="companies">
                            <field name="company_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="kitchenforge_brand_primary_color"/>
                                    <field name="kitchenforge_brand_secondary_color"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_kf_tenant_search" model="ir.ui.view">
        <field name="name">kitchenforge.tenant.search</field>
        <field name="model">kitchenforge.tenant</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="slug"/>
                <field name="admin_email"/>
                <separator/>
                <filter name="filter_live" string="Live"
                        domain="[('status', '=', 'live')]"/>
                <filter name="filter_pending" string="Pending"
                        domain="[('status', '=', 'pending')]"/>
                <filter name="filter_provisioning" string="Provisioning"
                        domain="[('status', '=', 'provisioning')]"/>
                <filter name="filter_suspended" string="Suspended"
                        domain="[('status', '=', 'suspended')]"/>
                <filter name="filter_marathon" string="Marathon-Referred"
                        domain="[('marathon_referred', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_status" string="Status"
                            context="{'group_by': 'status'}"/>
                    <filter name="group_tier" string="Tier"
                            context="{'group_by': 'tier'}"/>
                    <filter name="group_plan" string="Plan"
                            context="{'group_by': 'plan_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_kf_tenant" model="ir.actions.act_window">
        <field name="name">Tenants</field>
        <field name="res_model">kitchenforge.tenant</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_kf_tenant_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Onboard the first cabinet shop.
            </p>
            <p>
                Each tenant is one cabinet-shop subscriber on its own
                isolated KitchenForge stack.
            </p>
        </field>
    </record>

</odoo>
