<?xml version="1.0" encoding="utf-8"?>
<!--
  W034 (R4.W5, 2026-06-27) — Report Engineering Issue wizard view.

  Single tablet-friendly form. Pre-filled WO/MO/cabinet context block
  at the top is readonly; operator fills title + description, picks
  severity, attaches photo (optional) + optional MI check link.

  Submit creates a DRAFT ECO and opens it. Cancel discards.
-->
<odoo>

    <record id="view_sbk_wo_raise_eco_wizard_form" model="ir.ui.view">
        <field name="name">southbrook.wo.raise.eco.wizard.form</field>
        <field name="model">southbrook.wo.raise.eco.wizard</field>
        <field name="arch" type="xml">
            <form string="Report Engineering Issue">
                <sheet>
                    <div class="oe_title">
                        <h2>Report Engineering Issue</h2>
                        <p class="text-muted">
                            A draft ECO will be created with the WO
                            context and your photo. Engineering will
                            triage and approve — your ECO is NEVER
                            applied automatically.
                        </p>
                    </div>
                    <group string="Context (auto-filled from this Work Order)">
                        <group>
                            <field name="workorder_id" readonly="1"/>
                            <field name="production_id" readonly="1"/>
                            <field name="workcenter_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="product_id" readonly="1"/>
                            <field name="cabinet_code" readonly="1"/>
                            <field name="kitchen_room" readonly="1"/>
                        </group>
                    </group>
                    <group string="Issue">
                        <field name="title" placeholder="e.g. CNC drill hole 4mm off centre on wall cab"/>
                        <field name="severity" widget="radio"/>
                        <field name="mi_check_id"
                               options="{'no_create': True, 'no_open': True}"/>
                    </group>
                    <group string="What happened?">
                        <field name="description"
                               nolabel="1"
                               placeholder="Full narrative. What were you doing, what went wrong, what's the suspected root cause?"/>
                    </group>
                    <group string="Photo (optional)">
                        <field name="photo"
                               filename="photo_filename"
                               widget="image"
                               nolabel="1"/>
                        <field name="photo_filename" invisible="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_submit"
                            type="object"
                            string="Submit Draft ECO"
                            class="btn-primary"/>
                    <button special="cancel"
                            string="Cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
