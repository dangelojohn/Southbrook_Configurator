<?xml version="1.0" encoding="utf-8"?>
<!--
  W040 (R2.4, 2026-06-27) — Report-a-Problem wizard view.

  Single tablet-friendly form, three checkbox-gated sections so the
  operator only sees the inputs for the sections they ticked.

  Submit creates scrap + defect + downtime in ONE transaction.
-->
<odoo>

    <record id="view_sbk_report_problem_wizard_form" model="ir.ui.view">
        <field name="name">southbrook.report.problem.wizard.form</field>
        <field name="model">southbrook.report.problem.wizard</field>
        <field name="arch" type="xml">
            <form string="Report a Problem">
                <sheet>
                    <div class="oe_title">
                        <h2>Report a Problem</h2>
                        <p class="text-muted">
                            One screen. Tick any combination of scrap /
                            defect / downtime and we'll log all three
                            atomically — either everything writes or
                            nothing does.
                        </p>
                    </div>
                    <group string="Context">
                        <group>
                            <field name="workorder_id" readonly="1"/>
                            <field name="production_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="workcenter_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Sections to log">
                        <field name="include_scrap"/>
                        <field name="include_defect"/>
                        <field name="include_downtime"/>
                    </group>
                    <group string="Scrap"
                           invisible="not include_scrap">
                        <field name="scrap_product_id"
                               required="include_scrap"/>
                        <field name="scrap_qty"/>
                        <field name="scrap_uom_id"/>
                        <field name="scrap_reason"/>
                        <field name="scrap_notes" nolabel="1"
                               placeholder="Optional context — e.g. 'router bit chipped the edge'"/>
                    </group>
                    <group string="Defect"
                           invisible="not include_defect">
                        <field name="defect_type"/>
                        <field name="defect_stage"/>
                        <field name="defect_severity" widget="radio"/>
                        <field name="defect_description" nolabel="1"
                               placeholder="What's wrong with the part?"/>
                        <field name="defect_photo"
                               filename="defect_photo_filename"
                               widget="image"
                               nolabel="1"/>
                        <field name="defect_photo_filename" invisible="1"/>
                    </group>
                    <group string="Downtime"
                           invisible="not include_downtime">
                        <field name="downtime_reason"
                               required="include_downtime"/>
                        <field name="downtime_minutes"
                               required="include_downtime"/>
                        <field name="downtime_notes" nolabel="1"
                               placeholder="What happened? Operator-facing context."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_submit"
                            type="object"
                            string="Submit"
                            class="btn-primary"/>
                    <button special="cancel"
                            string="Cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
