<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: LGPL-3.0-only

     WO Traveler PDF — one page per mrp.workorder. Used by operators
     to wallpaper the WO at the cell.

     W026 (2026-06-27) — rich traveler per MFG-REVIEW R2.5 + R8.2:
       - top-of-page CAD render thumbnail (FreeCAD bridge artifact
         or fallback to product image) so the operator sees the spec
         without leaving the cell
       - bottom-of-page 3 scan-QRs (START / PAUSE / DONE) so the
         operator can advance WO state with a single scan instead of
         opening the form + tapping
     The original single-QR "SCAN TO OPEN" panel is kept — it's still
     the right entry point when an operator wants the full form
     surface (e.g. to record scrap or attach a defect note).
-->
<odoo>

    <template id="wo_traveler_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wo">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h1 style="margin-bottom: 0.5rem"><span t-esc="wo.name"/></h1>
                        <h3 class="text-muted" style="margin-top:0">
                            <span t-esc="wo.production_id.name"/> —
                            <span t-esc="wo.product_id.display_name"/>
                        </h3>

                        <!--
                            W026 — CAD render / cabinet image thumbnail.
                            Pulled from FreeCAD bridge (x_cad_attachment_ids)
                            with product image as fallback. Routed via
                            /web/image/mrp.workorder/<id>/cad_thumbnail so
                            wkhtmltopdf gets a real URL it can fetch
                            in-process (data: URIs blow the report cache
                            for any image > a few KB).
                        -->
                        <t t-if="wo.cad_thumbnail">
                            <div class="row mt-2">
                                <div class="col-12 text-center">
                                    <img t-att-src="'/web/image/mrp.workorder/%d/cad_thumbnail' % wo.id"
                                         style="max-width: 100%; max-height: 200px;
                                                border: 1px solid #ccc; padding: 4px;
                                                background: #fff;"
                                         alt="Cabinet drawing / CAD render"/>
                                    <div style="font-size: 8pt; color: #666;
                                                margin-top: 4px;">
                                        Build to this spec
                                    </div>
                                </div>
                            </div>
                        </t>

                        <div class="row mt-4">
                            <div class="col-7">
                                <table class="table table-sm">
                                    <tr>
                                        <th>Workcenter</th>
                                        <td t-esc="wo.workcenter_id.display_name"/>
                                    </tr>
                                    <tr>
                                        <th>Operation</th>
                                        <td t-esc="wo.operation_id.name or '-'"/>
                                    </tr>
                                    <tr>
                                        <th>Qty</th>
                                        <td>
                                            <span t-esc="wo.qty_producing or wo.qty_production or 0"/>
                                            <span t-if="wo.product_uom_id">
                                                <t t-esc="wo.product_uom_id.name"/>
                                            </span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>Expected (min)</th>
                                        <td>
                                            <span t-esc="round(wo.x_sbk_kitchen_expected_min or wo.duration_expected or 0, 1)"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>State</th>
                                        <td><span class="badge bg-secondary" t-esc="dict(wo._fields['state'].selection).get(wo.state)"/></td>
                                    </tr>
                                    <tr t-if="wo.production_id.x_sbk_kitchen_project_id">
                                        <th>Kitchen Project</th>
                                        <td t-esc="wo.production_id.x_sbk_kitchen_project_id.display_name"/>
                                    </tr>
                                    <tr t-if="wo.production_id.x_sbk_install_due_date">
                                        <th>Install Due</th>
                                        <td t-esc="wo.production_id.x_sbk_install_due_date"/>
                                    </tr>
                                    <tr t-if="wo.production_id.x_sbk_cabinet_code">
                                        <th>Cabinet</th>
                                        <td t-esc="wo.production_id.x_sbk_cabinet_code"/>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-5 text-center">
                                <t t-if="wo.qr_image_base64">
                                    <img
                                        t-att-src="'data:image/png;base64,' + wo.qr_image_base64"
                                        style="width: 220px; height: 220px; border: 1px solid #999; padding: 4px;"
                                        alt="WO QR code"/>
                                    <div class="mt-2" style="font-size:9pt; color:#666">
                                        <strong>SCAN TO OPEN</strong>
                                    </div>
                                    <div style="font-size:8pt; color:#999; font-family:monospace">
                                        <t t-esc="(wo.qr_payload or '')[:60]"/>...
                                    </div>
                                </t>
                                <t t-else="">
                                    <div style="border:1px dashed #999; padding:2rem; width:220px; height:220px;">
                                        <small>QR unavailable (qrcode lib not installed)</small>
                                    </div>
                                </t>
                            </div>
                        </div>

                        <!--
                            W026 / R8.2 — 3 scan-QRs for 0-tap state advance.
                            Each QR encodes /sb/qr/scan?p=<signed>&amp;action=...
                            which the wo handler routes to button_start /
                            button_pending / button_finish. Operator scans
                            the matching tile when starting / pausing /
                            finishing the WO — no need to open the form.
                        -->
                        <h4 class="mt-4">Scan to Advance</h4>
                        <div class="row text-center mt-2">
                            <div class="col-4">
                                <t t-if="wo.qr_action_start_b64">
                                    <img t-att-src="'data:image/png;base64,' + wo.qr_action_start_b64"
                                         style="width: 130px; height: 130px;
                                                border: 2px solid #2e7d32;
                                                padding: 4px;"
                                         alt="START scan QR"/>
                                </t>
                                <t t-else="">
                                    <div style="width: 130px; height: 130px;
                                                border: 1px dashed #999;
                                                display: inline-block;
                                                line-height: 130px;
                                                font-size: 8pt; color: #999;">
                                        QR unavailable
                                    </div>
                                </t>
                                <div style="margin-top: 4px; font-size: 11pt;
                                            font-weight: bold; color: #2e7d32;">
                                    START
                                </div>
                            </div>
                            <div class="col-4">
                                <t t-if="wo.qr_action_pause_b64">
                                    <img t-att-src="'data:image/png;base64,' + wo.qr_action_pause_b64"
                                         style="width: 130px; height: 130px;
                                                border: 2px solid #f57c00;
                                                padding: 4px;"
                                         alt="PAUSE scan QR"/>
                                </t>
                                <t t-else="">
                                    <div style="width: 130px; height: 130px;
                                                border: 1px dashed #999;
                                                display: inline-block;
                                                line-height: 130px;
                                                font-size: 8pt; color: #999;">
                                        QR unavailable
                                    </div>
                                </t>
                                <div style="margin-top: 4px; font-size: 11pt;
                                            font-weight: bold; color: #f57c00;">
                                    PAUSE
                                </div>
                            </div>
                            <div class="col-4">
                                <t t-if="wo.qr_action_done_b64">
                                    <img t-att-src="'data:image/png;base64,' + wo.qr_action_done_b64"
                                         style="width: 130px; height: 130px;
                                                border: 2px solid #1565c0;
                                                padding: 4px;"
                                         alt="DONE scan QR"/>
                                </t>
                                <t t-else="">
                                    <div style="width: 130px; height: 130px;
                                                border: 1px dashed #999;
                                                display: inline-block;
                                                line-height: 130px;
                                                font-size: 8pt; color: #999;">
                                        QR unavailable
                                    </div>
                                </t>
                                <div style="margin-top: 4px; font-size: 11pt;
                                            font-weight: bold; color: #1565c0;">
                                    DONE
                                </div>
                            </div>
                        </div>

                        <h4 class="mt-4">Operator Instructions</h4>
                        <ol style="line-height: 1.8">
                            <li>Scan the <strong>START</strong> QR when work begins
                                (no need to open the form).</li>
                            <li>Scan <strong>PAUSE</strong> if you stop mid-job;
                                scan <strong>START</strong> again to resume.</li>
                            <li>Scan <strong>DONE</strong> when work completes.</li>
                            <li>Need the full form (record scrap, attach notes)?
                                Scan the <strong>SCAN TO OPEN</strong> QR above.</li>
                            <li>If a defect is found:
                                <ul>
                                    <li>Scan the matching <strong>defect-type QR</strong> from the floor board.</li>
                                    <li>NCR drafts automatically with this WO and the defect type pre-filled.</li>
                                    <li>Supervisor will dispose: rework or quarantine.</li>
                                </ul>
                            </li>
                            <li>Record time + scrap via the WO form's <strong>Record Scrap</strong> button.</li>
                        </ol>

                        <t t-if="wo.production_id.x_sbk_kitchen_room or wo.production_id.x_sbk_complexity_factor">
                            <h4 class="mt-4">Job Context</h4>
                            <table class="table table-sm">
                                <tr t-if="wo.production_id.x_sbk_kitchen_room">
                                    <th style="width: 30%">Room / Zone</th>
                                    <td t-esc="wo.production_id.x_sbk_kitchen_room"/>
                                </tr>
                                <tr t-if="wo.production_id.x_sbk_complexity_factor">
                                    <th>Complexity Factor</th>
                                    <td t-esc="wo.production_id.x_sbk_complexity_factor"/>
                                </tr>
                            </table>
                        </t>

                        <div style="margin-top:3rem; border-top: 1px solid #ccc; padding-top:1rem;
                                    font-size:8pt; color:#666; text-align:center">
                            Southbrook WO Traveler — printed
                            <t t-out="datetime.datetime.now().strftime('%Y-%m-%d %H:%M')"/>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="report_wo_traveler" model="ir.actions.report">
        <field name="name">WO Traveler</field>
        <field name="model">mrp.workorder</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">southbrook_mrp_kitchen_workcenters.wo_traveler_document</field>
        <field name="report_file">southbrook_mrp_kitchen_workcenters.wo_traveler_document</field>
        <field name="binding_model_id" ref="mrp.model_mrp_workorder"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
