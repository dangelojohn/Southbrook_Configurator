<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Record rule: a portal user may read sb.production.package ONLY when it
        traces to one of their OWN sale orders (via the source order line, or
        the MO's sale line). The previous rule used domain_force=[] (an EMPTY
        domain matches EVERY record), so any portal user had ORM read to every
        production package in the DB — the defense-in-depth layer that should
        back-stop the export routes' object-auth (now added in the controller).
    -->
    <record id="rule_portal_dealer_production_package" model="ir.rule">
        <field name="name">Portal Dealer: production packages via own SOs</field>
        <field name="model_id" ref="southbrook_kitchen_mrp.model_sb_production_package"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">['|', ('sale_order_line_id.order_id.partner_id', '=', user.partner_id.commercial_partner_id.id), ('mo_id.sale_line_id.order_id.partner_id', '=', user.partner_id.commercial_partner_id.id)]</field>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>
</odoo>
