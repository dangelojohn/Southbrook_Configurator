<?xml version="1.0" encoding="utf-8"?>
<!--
  Southbrook Kitchen 3D Configurator — Canonical catalog TAG overlay.
  Split 2026-07-01 (E2E audit §4.A) — this file now carries only the
  STRUCTURAL invariants of the canonical templates:

    * southbrook_is_cabinet   — visibility flag for the 3D pane
    * southbrook_cabinet_type — one of {base,wall,tall,filler,panel,corner}
    * sale_ok                 — quotation-eligible

  These are re-applied on every -u (noupdate="0") — a Studio user or
  accidental UI edit that clears one of them is auto-healed.

  Per-template DIMENSIONS live in the sibling file
  canonical_catalog_dimensions.xml with noupdate="1" so runtime edits
  survive -u. Before the split, dimension writes shipped in this file
  with noupdate="0" — clobbering any customer/rep dimension edit on
  every module upgrade (documented at
  docs/E2E_AUDIT_KITCHEN_3D_CONFIGURATOR_2026-07-01.md §4.A).

  Two of the 12 canonicals are handled specially:

    * `worktop` — NOT tagged. It's a countertop / surface product,
      not a cabinet. None of the 6 valid cabinet_type values
      (base/wall/tall/filler/panel/corner) fits. PRODBOARD_MANIFEST
      §4.3 / §5.1 documents worktop as its own module class with a
      length-based dimension model, distinct from carcasses.

    * `accessory` — tagged with cabinet_type=panel as a fallback.
      The canonical `accessory` template carries a sub-attribute
      `accessory_type: end_panel/filler/cornice/pelmet/plinth` per
      CLAUDE.md §3, so it's really a container for 5 different
      product classes. "panel" is the least-wrong single type;
      accessory-with-filler variants render correctly regardless.

  Retirement path for the 7 demo cabinets in data/demo_cabinets.xml:
    Deferred — no name/default_code/xmlid collision exists (audit
    confirmed), so both catalogs can coexist.
-->
<odoo noupdate="0">

  <!-- Wall cabinets ─────────────────────────────────────────── -->

  <record id="southbrook_estimating.wall_1dr" model="product.template">
    <field name="southbrook_is_cabinet" eval="True"/>
    <field name="southbrook_cabinet_type">wall</field>
    <field name="sale_ok" eval="True"/>
  </record>

  <record id="southbrook_estimating.wall_2dr" model="product.template">
    <field name="southbrook_is_cabinet" eval="True"/>
    <field name="southbrook_cabinet_type">wall</field>
    <field name="sale_ok" eval="True"/>
  </record>

  <!-- Base cabinets ─────────────────────────────────────────── -->

  <record id="southbrook_estimating.base_1dr" model="product.template">
    <field name="southbrook_is_cabinet" eval="True"/>
    <field name="southbrook_cabinet_type">base</field>
    <field name="sale_ok" eval="True"/>
  </record>

  <record id="southbrook_estimating.base_2dr" model="product.template">
    <field name="southbrook_is_cabinet" eval="True"/>
    <field name="southbrook_cabinet_type">base</field>
    <field name="sale_ok" eval="True"/>
  </record>

  <record id="southbrook_estimating.drawer_bank" model="product.template">
    <field name="southbrook_is_cabinet" eval="True"/>
    <field name="southbrook_cabinet_type">base</field>
    <field name="sale_ok" eval="True"/>
  </record>

  <record id="southbrook_estimating.sink_base" model="product.template">
    <field name="southbrook_is_cabinet" eval="True"/>
    <field name="southbrook_cabinet_type">base</field>
    <field name="sale_ok" eval="True"/>
  </record>

  <!-- Vanity is a base carcass with distinct 32"H / 21"D
       dimensions (Excel Mapping §7). Contemporary/Elegance only. -->
  <record id="southbrook_estimating.vanity" model="product.template">
    <field name="southbrook_is_cabinet" eval="True"/>
    <field name="southbrook_cabinet_type">base</field>
    <field name="sale_ok" eval="True"/>
  </record>

  <!-- Tall cabinets ─────────────────────────────────────────── -->

  <record id="southbrook_estimating.tall_pantry" model="product.template">
    <field name="southbrook_is_cabinet" eval="True"/>
    <field name="southbrook_cabinet_type">tall</field>
    <field name="sale_ok" eval="True"/>
  </record>

  <record id="southbrook_estimating.tall_oven" model="product.template">
    <field name="southbrook_is_cabinet" eval="True"/>
    <field name="southbrook_cabinet_type">tall</field>
    <field name="sale_ok" eval="True"/>
  </record>

  <!-- Corner ─────────────────────────────────────────────────── -->

  <record id="southbrook_estimating.corner" model="product.template">
    <field name="southbrook_is_cabinet" eval="True"/>
    <field name="southbrook_cabinet_type">corner</field>
    <field name="sale_ok" eval="True"/>
  </record>

  <!-- Accessory: container for end_panel/filler/cornice/pelmet/
       plinth per CLAUDE.md §3. Tagged as `panel` because that's
       the least-wrong of the 6 valid cabinet_type values. Filler
       sub-variants will still render correctly at drop-time
       because the model derives filler behavior from the specific
       variant's accessory_type attribute — the template-level tag
       just gates visibility in the inventory pane. -->
  <record id="southbrook_estimating.accessory" model="product.template">
    <field name="southbrook_is_cabinet" eval="True"/>
    <field name="southbrook_cabinet_type">panel</field>
    <field name="sale_ok" eval="True"/>
  </record>

  <!--
    NOT TAGGED: southbrook_estimating.worktop
    Worktop is a countertop surface, not a cabinet. It doesn't
    fit any of the 6 southbrook_cabinet_type values (base/wall/
    tall/filler/panel/corner) and its dimension model is
    length-based per PRODBOARD_MANIFEST §5.1. If worktops need
    to appear anywhere in the configurator later, they belong
    in a separate "surface product" catalog gated by a distinct
    flag (e.g. southbrook_is_surface).
  -->

</odoo>
