    <field name="sale_ok" eval="True"/>
  </record>

  <!-- Vanity is a base carcass with distinct 32"H / 21"D
       dimensions (Excel Mapping §7). Contemporary/Elegance only. -->
  <record id="southbrook_estimating.vanity" model="product.template">
    <field name="southbrook_is_cabinet" eval="True"/>
    <field name="southbrook_cabinet_type">base</field>
    <field name="southbrook_width_in">30</field>
    <field name="southbrook_height_in">32</field>
