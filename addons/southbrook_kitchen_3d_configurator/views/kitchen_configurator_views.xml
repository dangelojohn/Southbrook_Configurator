<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Client action — registers the OWL component as a navigable action -->
    <record id="action_sbk_kitchen_configurator" model="ir.actions.client">
        <field name="name">3D Kitchen Configurator</field>
        <field name="tag">southbrook_kitchen_configurator</field>
        <field name="target">main</field>
    </record>

    <!-- Menu structure ──────────────────────────────────────────────────────── -->
    <menuitem id="menu_sbk_root"
              name="Southbrook Kitchen"
              sequence="35"
              web_icon="southbrook_kitchen_3d_configurator,static/description/icon.png"/>

    <menuitem id="menu_sbk_configurator"
              name="3D Configurator"
              parent="menu_sbk_root"
              action="action_sbk_kitchen_configurator"
              sequence="10"/>

    <menuitem id="menu_sbk_designs"
              name="Kitchen Designs"
              parent="menu_sbk_root"
              action="action_sbk_kitchen_designs"
              sequence="20"/>

    <menuitem id="menu_sbk_cabinet_products"
              name="Cabinet Products"
              parent="menu_sbk_root"
              action="action_southbrook_cabinet_products"
              sequence="30"/>

</odoo>
