<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_southbrook_ncr_list" model="ir.ui.view">
        <field name="name">southbrook.ncr.list</field>
        <field name="model">southbrook.ncr</field>
        <field name="arch" type="xml">
            <list string="Non-Conformance Reports"
                  decoration-danger="severity == 'critical'"
                  decoration-warning="severity == 'major'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="state"/>
                <field name="severity"/>
                <field name="defect_type"/>
                <field name="production_id"/>
                <field name="workcenter_id"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="responsible_user_id"/>
                <field name="create_date"/>
                <field name="closed_at"/>
                <field name="time_to_close_hours"/>
            </list>
        </field>
    </record>

    <record id="view_southbrook_ncr_form" model="ir.ui.view">
        <field name="name">southbrook.ncr.form</field>
        <field name="model">southbrook.ncr</field>
        <field name="arch" type="xml">
            <form string="Non-Conformance Report">
                <header>
                    <button name="action_quarantine" type="object"
                            string="Quarantine"
                            invisible="state != 'draft'"
                            class="oe_highlight"/>
                    <button name="action_rework" type="object"
                            string="Rework"
                            invisible="state != 'quarantine'"/>
                    <button name="action_scrap" type="object"
                            string="Scrap"
                            invisible="state != 'quarantine'"/>
                    <button name="action_release" type="object"
                            string="Release"
                            invisible="state not in ('quarantine', 'rework')"/>
                    <button name="action_cancel" type="object"
                            string="Cancel"
                            invisible="state in ('scrap', 'released', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,quarantine,rework,released"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Defect">
                            <field name="defect_type"/>
                            <field name="severity"/>
                            <field name="quantity"/>
                            <field name="lot_id"/>
                        </group>
                        <group string="Context">
                            <field name="production_id"/>
                            <field name="production_package_id"/>
                            <field name="workcenter_id"/>
                            <field name="product_id"/>
                            <field name="responsible_user_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="What happened?"/>
                        </page>
                        <page string="Disposition">
                            <field name="disposition_reason"
                                   placeholder="Required when releasing, reworking, or scrapping."/>
                            <group>
                                <field name="closed_at" readonly="1"/>
                                <field name="time_to_close_hours" readonly="1"/>
                            </group>
                        </page>
                        <page string="Evidence">
                            <field name="photo_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Trigger">
                            <field name="spc_sample_id" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_southbrook_ncr_kanban" model="ir.ui.view">
        <field name="name">southbrook.ncr.kanban</field>
        <field name="model">southbrook.ncr</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="severity"/>
                <field name="defect_type"/>
                <field name="state"/>
                <field name="responsible_user_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card">
                            <strong><field name="name"/></strong>
                            <div>
                                <field name="defect_type"/>
                                / <field name="severity"/>
                            </div>
                            <div><field name="responsible_user_id"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_southbrook_ncr_search" model="ir.ui.view">
        <field name="name">southbrook.ncr.search</field>
        <field name="model">southbrook.ncr</field>
        <field name="arch" type="xml">
            <search string="NCRs">
                <field name="name"/>
                <field name="production_id"/>
                <field name="product_id"/>
                <filter name="open" string="Open"
                        domain="[('state', 'in', ('draft', 'quarantine', 'rework'))]"/>
                <filter name="critical" string="Critical"
                        domain="[('severity', '=', 'critical')]"/>
                <filter name="major" string="Major"
                        domain="[('severity', '=', 'major')]"/>
                <separator/>
                <filter name="dim" string="Dimensional"
                        domain="[('defect_type', '=', 'dimension')]"/>
                <filter name="finish" string="Finish"
                        domain="[('defect_type', '=', 'finish')]"/>
                <group>
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_severity" string="Severity" context="{'group_by': 'severity'}"/>
                    <filter name="group_defect" string="Defect Type" context="{'group_by': 'defect_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_southbrook_ncr" model="ir.actions.act_window">
        <field name="name">NCRs</field>
        <field name="res_model">southbrook.ncr</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_southbrook_ncr_search"/>
        <field name="context">{'search_default_open': 1}</field>
    </record>
</odoo>
