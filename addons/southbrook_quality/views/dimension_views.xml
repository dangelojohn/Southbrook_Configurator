<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_southbrook_quality_dimension_list" model="ir.ui.view">
        <field name="name">southbrook.quality.dimension.list</field>
        <field name="model">southbrook.quality.dimension</field>
        <field name="arch" type="xml">
            <list string="Quality Dimensions">
                <field name="key"/>
                <field name="name"/>
                <field name="nominal"/>
                <field name="lsl"/>
                <field name="usl"/>
                <field name="uom_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_southbrook_quality_dimension_form" model="ir.ui.view">
        <field name="name">southbrook.quality.dimension.form</field>
        <field name="model">southbrook.quality.dimension</field>
        <field name="arch" type="xml">
            <form string="Quality Dimension">
                <sheet>
                    <group>
                        <group>
                            <field name="key"/>
                            <field name="name"/>
                            <field name="uom_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="nominal"/>
                            <field name="lsl"/>
                            <field name="usl"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_southbrook_quality_dimension" model="ir.actions.act_window">
        <field name="name">Dimensions</field>
        <field name="res_model">southbrook.quality.dimension</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
