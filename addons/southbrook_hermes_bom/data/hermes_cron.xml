<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">

    <!--
      Nightly GC for hermes.research.job. Retention window comes from
      ir.config_parameter southbrook_hermes_bom.retention_days (default
      180). Applied jobs are kept forever — see
      HermesResearchJob._gc_old_jobs in models/hermes_research_job.py.

      In Odoo 19 ir.cron inherits ir.actions.server and the old
      numbercall/doall fields were removed. The recurrence is
      controlled by interval_number/interval_type + nextcall.
    -->
    <record id="cron_hermes_research_job_gc" model="ir.cron">
      <field name="name">Hermes BOM: GC old research jobs</field>
      <field name="model_id" ref="model_hermes_research_job"/>
      <field name="state">code</field>
      <field name="code">model._gc_old_jobs()</field>
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
      <field name="active" eval="True"/>
    </record>

  </data>
</odoo>
