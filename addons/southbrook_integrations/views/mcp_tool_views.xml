<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mcp_tool_list" model="ir.ui.view">
        <field name="name">southbrook.integrations.mcp_tool.list</field>
        <field name="model">southbrook.integrations.mcp_tool</field>
        <field name="arch" type="xml">
            <list string="MCP Tools"
                  decoration-muted="not enabled">
                <field name="name"/>
                <field name="category"/>
                <field name="model_name"/>
                <field name="enabled"/>
                <field name="rate_limit_per_min"/>
            </list>
        </field>
    </record>

    <record id="view_mcp_tool_form" model="ir.ui.view">
        <field name="name">southbrook.integrations.mcp_tool.form</field>
        <field name="model">southbrook.integrations.mcp_tool</field>
        <field name="arch" type="xml">
            <form string="MCP Tool">
                <header>
                    <button name="action_test_invoke" type="object"
                            string="Test Invoke" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="category"/>
                            <field name="model_id"/>
                            <field name="enabled"/>
                            <field name="rate_limit_per_min"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Domain">
                            <field name="domain_json" widget="ace"
                                   options="{'mode': 'json'}"/>
                        </page>
                        <page string="Fields">
                            <field name="read_fields_json" widget="ace"
                                   options="{'mode': 'json'}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mcp_tool" model="ir.actions.act_window">
        <field name="name">MCP Tools</field>
        <field name="res_model">southbrook.integrations.mcp_tool</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
