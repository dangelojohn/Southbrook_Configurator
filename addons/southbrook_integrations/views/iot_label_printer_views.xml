<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_iot_label_printer_list" model="ir.ui.view">
        <field name="name">southbrook.integrations.iot_label_printer.list</field>
        <field name="model">southbrook.integrations.iot_label_printer</field>
        <field name="arch" type="xml">
            <list string="Label Printers" decoration-muted="not enabled">
                <field name="name"/>
                <field name="iot_device_identifier"/>
                <field name="model_target"/>
                <field name="enabled"/>
            </list>
        </field>
    </record>

    <record id="view_iot_label_printer_form" model="ir.ui.view">
        <field name="name">southbrook.integrations.iot_label_printer.form</field>
        <field name="model">southbrook.integrations.iot_label_printer</field>
        <field name="arch" type="xml">
            <form string="Label Printer">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="iot_device_identifier"/>
                            <field name="model_target"/>
                            <field name="enabled"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="ZPL Template">
                            <field name="zpl_template"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_iot_label_printer" model="ir.actions.act_window">
        <field name="name">Label Printers</field>
        <field name="res_model">southbrook.integrations.iot_label_printer</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
